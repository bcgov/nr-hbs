# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
	# Real client IP for the backend's per-IP rate limit on the public
	# (anonymous) API, /api/v1/hbs/public/** (docs/public-access.md). The
	# OpenShift router appends the caller to X-Forwarded-For; trusting the
	# private ranges (router / cluster hops) and reading the list right-to-left
	# (strict) yields the first untrusted address, which a caller can't spoof
	# by sending their own X-Forwarded-For.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip
	file_server
	@spa_router {
		not path /api*
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa_router {http.matchers.file.relative}
	# Proxy requests to API service
	reverse_proxy /api* {$BACKEND_URL} {
		header_up Host {http.reverse_proxy.upstream.hostport}
		# {client_ip} (see trusted_proxies above), not {remote_host}, which is
		# the router pod. The backend reads it as hbs.public.rate-limit.client-ip-header.
		header_up X-Real-IP {client_ip}
	}
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca;;
			script-src 'self'  https://*.gov.bc.ca ;
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com 'unsafe-inline';
			font-src 'self' https://fonts.gstatic.com;
			img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org https://*.tile.opentopomap.org https://server.arcgisonline.com;
			frame-ancestors 'self';
			form-action 'self';
			block-all-mixed-content;
			connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
