# ===========================================
# HBS Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.

# Application
VITE_APP_NAME=Harvest Billing System

# Base Path (for deployments behind a proxy, e.g. /pub/hbs). Empty locally.
VITE_BASE_PATH=

# BC Gov SSO (Keycloak) — same contract as nr-fta / nr-rept.
#   VITE_KEYCLOAK_URL       — the realm's issuer URI (oidc-client-ts `authority`).
#                               dev:  https://dev.loginproxy.gov.bc.ca/auth/realms/standard
#                               test: https://test.loginproxy.gov.bc.ca/auth/realms/standard
#                               prod: https://loginproxy.gov.bc.ca/auth/realms/standard
#   VITE_KEYCLOAK_CLIENT_ID — the CSS integration's client id. The backend checks
#                             it as the token's `azp`, so both must name the
#                             same client.
#
# The sign-in redirect URI is <origin><base path>/authCallback and the
# post-logout URI is <origin><base path> — both must be registered on the CSS
# integration (IDIR + Business BCeID). They're derived from the runtime origin
# so one image works across PR previews / TEST / PROD.
VITE_KEYCLOAK_URL=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
VITE_KEYCLOAK_CLIENT_ID=

# Browser-facing API base path. Same-origin in production (Caddy reverse-
# proxies /api/* to the backend Service). Locally Vite proxies /api → :8080.
VITE_API_BASE_URL=/api

# Node Environment
NODE_ENV=development

# Development Server (optional)
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws
