# ===========================================
# HBS Backend Environment Variables
# ===========================================
# Same names as nr-fsp-new; set them in your shell or IDE run config, or put the
# equivalent properties in the gitignored application-local.properties.

SERVER_PORT=8080

# BC Gov SSO (Keycloak) standard realm — same as nr-fta / nr-rept. The JWKS
# URI is derived as <issuer>/protocol/openid-connect/certs.
KEYCLOAK_ISSUER_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
# The CSS integration's client id, checked as the token's `azp`. Must equal the
# frontend's VITE_KEYCLOAK_CLIENT_ID. Required — the API won't start without it.
KEYCLOAK_CLIENT_ID=

# Shared Oracle (THE schema) over TCPS 1543
DATABASE_HOST=
DATABASE_PORT=1543
DATABASE_SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
KEYSTORE_SECRET=

# nr-user-lookup-api (display names, user picker). Blank = disabled.
# The service account lives in the *forests* realm, e.g.
# https://test.loginproxy.gov.bc.ca/auth/realms/forests/protocol/openid-connect/token
# Set token URL, client id and secret together or none.
USER_LOOKUP_BASE_URL=
USER_LOOKUP_TOKEN_URL=
USER_LOOKUP_CLIENT_ID=
USER_LOOKUP_CLIENT_SECRET=

# nr-forest-client-api (client picker, org names). Scheme + host, e.g.
# https://nr-forest-client-api-test.api.gov.bc.ca, and HBS's API key from
# the API Services Portal. Blank URL = client lookups unavailable.
FOREST_CLIENT_API_URL=
FOREST_CLIENT_API_KEY=

# ClamAV upload scanning (fail-open locally where there's no clamd)
CLAMAV_ENABLED=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=true

# Submitted scale-data XML (PVC in OpenShift)
HBS_STORAGE_XML_ROOT=/tmp/hbs-xml
REPORTS_WORK_DIR=/tmp/hbs-reports

# Mail
SMTP_HOST=apps.smtp.gov.bc.ca
SMTP_PORT=25
EMAIL_SEND_ENABLED=false

# Batch jobs — keep OFF unless the legacy batch has been cut over
HBS_BATCH_ENABLED=false
