: $F{SECONDARY_LICENSE_NUMBER}
)]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_CutBlock" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
( $F{CUT_BLOCK_ID} == null || $F{CUT_BLOCK_ID}.isEmpty()
