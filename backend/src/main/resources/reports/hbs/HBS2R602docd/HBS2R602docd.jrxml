	<variable name="CCF0_Show_ScaleSite" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
( $F{SCALE_SITE_ID_NMBR} == null || $F{SCALE_SITE_ID_NMBR}.isEmpty()
? ( $F{INPUT_SCALE_SITE} == null || $F{INPUT_SCALE_SITE}.isEmpty() ? "" : "* " + $F{INPUT_SCALE_SITE} )
: $F{SCALE_SITE_ID_NMBR}
)]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_PrimaryScaler" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
