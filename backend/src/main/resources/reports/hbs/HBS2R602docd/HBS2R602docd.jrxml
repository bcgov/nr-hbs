: $F{PRIMARY_LICENSE_NUMBER}
)]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_SecondaryScaler" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
( $F{SECONDARY_LICENSE_NUMBER} == null || $F{SECONDARY_LICENSE_NUMBER}.isEmpty()
