: $F{CUT_BLOCK_ID}
)]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_PopStratYear" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field

//IF (ISNULL({HBS2R602.POPULATION_NUMBER}) OR  ISNULL({HBS2R602.STRATUM_NUMBER}) OR ISNULL({HBS2R602.SAMPLING_YEAR})) THEN
// '* ' + {HBS2R602.INPUT_PSY}
//ELSE
// {HBS2R602.POPULATION_NUMBER} + '-' + {HBS2R602.STRATUM_NUMBER} + '-' + cStr({HBS2R602.SAMPLING_YEAR}, 0, '')

( $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ||
  $F{STRATUM_NUMBER}    == null || $F{STRATUM_NUMBER}.isEmpty()    ||
  $F{SAMPLING_YEAR}     == null
? ( $F{INPUT_PSY} == null || $F{INPUT_PSY}.isEmpty() ? "" : "* " + $F{INPUT_PSY} )
:
  ( $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ? "" : $F{POPULATION_NUMBER} ) +
  ( $F{STRATUM_NUMBER}    == null || $F{STRATUM_NUMBER}.isEmpty()    ? "" : $F{STRATUM_NUMBER}    ) +
  ( $F{SAMPLING_YEAR}     == null                                    ? "" : new DecimalFormat("#,##0").format( $F{SAMPLING_YEAR} ) )
)]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_SigningScaler" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
( $F{SIGNING_LICENSE_NUMBER} == null || $F{SIGNING_LICENSE_NUMBER}.isEmpty()
? ( $F{INPUT_SIGNING_SCALER_LIC} == null || $F{INPUT_SIGNING_SCALER_LIC}.isEmpty() ? "" : "* " + $F{INPUT_SIGNING_SCALER_LIC} )
: $F{SIGNING_LICENSE_NUMBER}
)]]></variableExpression>
	</variable>
	<variable name="CCF6_Calc_NetWeight" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[( $F{GROSS_WEIGHT} == null ? 0.0 : $F{GROSS_WEIGHT}.doubleValue() ) -
( $F{TARE_WEIGHT}  == null ? 0.0 : $F{TARE_WEIGHT}.doubleValue()  )]]></variableExpression>
	</variable>
	<variable name="CCF7_Calc_GrappleWeight" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[( $F{GROSS_WEIGHT}            == null ? 0.0 : $F{GROSS_WEIGHT}.doubleValue()            ) -
( $F{SAMPLE_DEDUCTION_WEIGHT} == null ? 0.0 : $F{SAMPLE_DEDUCTION_WEIGHT}.doubleValue() )]]></variableExpression>
	</variable>
	<variable name="CCF8_FormattedScaleDateParamter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?WSRETURN_SCALEDDATEFROM} = '' AND {?WSRETURN_SCALEDDATETO} = '' THEN ''
//ELSE
//    {?WSRETURN_SCALEDDATEFROM} + '  to  ' + {?WSRETURN_SCALEDDATETO}

( $P{WSRETURN_SCALEDDATEFROM} == null || $P{WSRETURN_SCALEDDATEFROM}.isEmpty() ||
  $P{WSRETURN_SCALEDDATETO}   == null || $P{WSRETURN_SCALEDDATETO}.isEmpty()
? ""
:
  ( $P{WSRETURN_SCALEDDATEFROM} == null || $P{WSRETURN_SCALEDDATEFROM}.isEmpty() ? "" : $P{WSRETURN_SCALEDDATEFROM} + "  to  " ) +
  ( $P{WSRETURN_SCALEDDATETO}   == null || $P{WSRETURN_SCALEDDATETO}.isEmpty()   ? "" : $P{WSRETURN_SCALEDDATETO} )
)]]></variableExpression>
	</variable>
	<variable name="CCF9_FormattedClientTypeParameter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (IsNull({?WSRETURN_CLIENTTYPE})) then
//    'ALL'
//else if (Length (Trim ({?WSRETURN_CLIENTTYPE})) = 0) then
//    'ALL'
//else
//    UpperCase ({?WSRETURN_CLIENTTYPE})

( $P{WSRETURN_CLIENTTYPE} == null || $P{WSRETURN_CLIENTTYPE}.isEmpty() ? "ALL" :
( ($P{WSRETURN_CLIENTTYPE}.trim()).length() == 0                       ? "ALL" :
                                                                         $P{WSRETURN_CLIENTTYPE}.toUpperCase()
))]]></variableExpression>
	</variable>
	<variable name="CCF10_FormattedClientParameter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//'Client No / Loc: ' + {?WSRETURN_CLIENTNO} + ' / ' + {?WSRETURN_CLIENTLOC}
"Client No / Loc: " +
( $P{WSRETURN_CLIENTNO} == null  || $P{WSRETURN_CLIENTNO}.isEmpty()  ? "" : $P{WSRETURN_CLIENTNO}  ) +
" / " +
( $P{WSRETURN_CLIENTLOC} == null || $P{WSRETURN_CLIENTLOC}.isEmpty() ? "" : $P{WSRETURN_CLIENTLOC} )]]></variableExpression>
	</variable>
	<variable name="CCF11_FormattedPopStratYearParameter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (IsNull({?WSRETURN_POPULATION})) then
//    ''
//else if (Length (Trim ({?WSRETURN_POPULATION})) = 0) then
//    ''
//else
//    {?WSRETURN_POPULATION} + ' / ' + {?WSRETURN_STRATUM} + ' / ' + {?WSRETURN_SAMPLINGYEAR}

( $P{WSRETURN_POPULATION} == null || $P{WSRETURN_POPULATION}.isEmpty() ? "" :
( ($P{WSRETURN_POPULATION}.trim()).length() == 0                       ? "" :
  $P{WSRETURN_POPULATION} +
  " / " +
  ( $P{WSRETURN_STRATUM}      == null || $P{WSRETURN_STRATUM}.isEmpty()      ? "" : $P{WSRETURN_STRATUM}      ) +
  " / " +
  ( $P{WSRETURN_SAMPLINGYEAR} == null || $P{WSRETURN_SAMPLINGYEAR}.isEmpty() ? "" : $P{WSRETURN_SAMPLINGYEAR} )
))]]></variableExpression>
	</variable>
	<variable name="CCF12_strDocVersion" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Trim (ToText ({HBS2R602.VERSION}, 0))
( $F{VERSION} == null
? ""
: new DecimalFormat("###0").format( $F{VERSION} )
)]]></variableExpression>
	</variable>
