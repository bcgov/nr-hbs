				<reportElement uuid="b30932b8-b53b-47f8-8186-c688ad0d00ba" x="270" y="32" width="84" height="11" forecolor="#000000">
					<printWhenExpression><![CDATA[//@NOT [IF {?LEDGERDTL_LEDGERTYPE} = 'D' THEN
// TRUE
//ELSE
//   select {HBS2R702.SCALE_EVENT_TYPE_CODE}
//      case 'PS' : False
//      case 'B4' : True
//      case '4R' : True
//      case 'TD' : False
//      case 'FD' : False
//      case 'RS' : False
//      case 'RR' : False
//      default : False;]@

$P{LEDGERDTL_LEDGERTYPE}!=null && $P{LEDGERDTL_LEDGERTYPE}.equalsIgnoreCase( "D" )
?false
:
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "PS" ) ? true  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "B4" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "4R" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "TD" ) ? true  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "FD" ) ? true  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "RS" ) ? true  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "RR" ) ? true  : true]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Left">
					<font fontName="Arial" size="8" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{TIMBER_MARK}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="10c2f5ee-a8c0-4415-8411-8b119bf78286" x="270" y="32" width="90" height="11" forecolor="#000000">
					<printWhenExpression><![CDATA[//@NOT [IF {?LEDGERDTL_LEDGERTYPE} = 'D' THEN
// TRUE
//ELSE
//   select {HBS2R702.SCALE_EVENT_TYPE_CODE}
//      case 'PS' : True
//      case 'B4' : False
//      case '4R' : False
//      case 'TD' : True
//      case 'FD' : True
//      case 'RS' : True
//      case 'RR' : True
//      case 'SB' : False
//      default : False;]@

$P{LEDGERDTL_LEDGERTYPE}!=null && $P{LEDGERDTL_LEDGERTYPE}.equalsIgnoreCase( "D" )
?false
:
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "PS" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "B4" ) ? true  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "4R" ) ? true  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "TD" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "FD" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "RS" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "SB" ) ? false  :
    $F{SCALE_EVENT_TYPE_CODE}!=null && $F{SCALE_EVENT_TYPE_CODE}.equalsIgnoreCase( "RR" ) ? true  : true]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Left">
					<font fontName="Arial" size="8" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
