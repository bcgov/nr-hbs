			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="2132feb1-5604-44a1-975a-115a63d40447" x="97" y="84" width="202" height="11" forecolor="#000000">
					<printWhenExpression><![CDATA[//@NOT [IF UpperCase({?LEDGERDTL_LEDGERTYPE}) = 'A' THEN
//  TRUE
//ELSE
//  FALSE]@

