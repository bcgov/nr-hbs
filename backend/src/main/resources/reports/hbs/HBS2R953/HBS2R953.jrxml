	<variable name="CCF4_ShowFromDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//mid({?RB_SCALED_FROM},1,5) & MonthName (toNumber(mid({?RB_SCALED_FROM},6,2)),true) & mid({?RB_SCALED_FROM},8,3);

// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_SCALED_FROM}== null || $P{RB_SCALED_FROM}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_SCALED_FROM})]]></variableExpression>
	</variable>
