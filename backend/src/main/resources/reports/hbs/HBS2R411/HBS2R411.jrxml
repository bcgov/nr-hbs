$V{ROLLUP_REGION_NO} !=null && $V{Region_Total_Volume} !=null
?
   (($V{ROLLUP_REGION_NO} == 1909 || $V{ROLLUP_REGION_NO}==1910 ) &&  $P{Avg_Rate_Coast} !=null                                  ?    $V{Region_Total_Volume} * $P{Avg_Rate_Coast} :
