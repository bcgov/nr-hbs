	<variable name="CCF0_Show_Age_Desc" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS2R411.AGE_GROUP} = 1 THEN
//  '01 to 30 days'
//ELSE IF ({HBS2R411.AGE_GROUP} = 2) THEN
//  '31 to 60 days'
//ELSE IF ({HBS2R411.AGE_GROUP} = 3) THEN
//  '61 to 90 days'
//ELSE IF ({HBS2R411.AGE_GROUP} = 4) THEN
//  '91 or more days'
//ELSE
// '** Error unknown age'

$F{AGE_GROUP}!=null
?
    ($F{AGE_GROUP}.intValue()==1 ? "01 to 30 days" :
    ($F{AGE_GROUP}.intValue()==2 ? "31 to 60 days" :
    ($F{AGE_GROUP}.intValue()==3 ? "61 to 90 days" :
    ($F{AGE_GROUP}.intValue()==4 ? "91 or more days" : "** Error unknown age"
    ))))

: "** Error unknown age"]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_Region_AvgRate" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//IF {HBS2R411.ROLLUP_REGION_NO} = 1909 or   {HBS2R411.ROLLUP_REGION_NO} = 1910 THEN
//  {?Avg_Rate_Coast}
//else if {HBS2R411.ROLLUP_REGION_NO} = 1905 or   {HBS2R411.ROLLUP_REGION_NO} = 1906  or   {HBS2R411.ROLLUP_REGION_NO} = 1908 THEN
// {?Avg_Rate_NInterior}
//else if {HBS2R411.ROLLUP_REGION_NO} = 1903  or   {HBS2R411.ROLLUP_REGION_NO} = 1904  or   {HBS2R411.ROLLUP_REGION_NO} = 1907 THEN
// {?Avg_Rate_SInterior}
//else $0

$V{ROLLUP_REGION_NO}!=null
?
    ($V{ROLLUP_REGION_NO} == 1909 || $V{ROLLUP_REGION_NO} == 1910                                 ? $P{Avg_Rate_Coast}  :
    ($V{ROLLUP_REGION_NO} == 1905 || $V{ROLLUP_REGION_NO} == 1906 || $V{ROLLUP_REGION_NO} == 1908 ? $P{Avg_Rate_NInterior}  :
    ($V{ROLLUP_REGION_NO} == 1903 || $V{ROLLUP_REGION_NO} == 1904 || $V{ROLLUP_REGION_NO} == 1907 ? $P{Avg_Rate_SInterior}  : 0
        )))
: 0]]></variableExpression>
	</variable>
	<variable name="CCF2_Calc_Estimated_Value" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//IF {HBS2R411.ROLLUP_REGION_NO} = 1909 or {HBS2R411.ROLLUP_REGION_NO} = 1910 THEN
//  (    {#Age_Group_Total_Volume} * {?Avg_Rate_Coast}  )
//
//ELSE IF {HBS2R411.ROLLUP_REGION_NO} = 1905 or {HBS2R411.ROLLUP_REGION_NO} = 1906 or {HBS2R411.ROLLUP_REGION_NO} = 1908 THEN
//  (   {#Age_Group_Total_Volume} * {?Avg_Rate_NInterior}  )
//
//ELSE IF {HBS2R411.ROLLUP_REGION_NO} = 1903 or {HBS2R411.ROLLUP_REGION_NO} = 1904 or {HBS2R411.ROLLUP_REGION_NO} = 1907 THEN
//    (   {#Age_Group_Total_Volume} * {?Avg_Rate_SInterior}  )
//
//ELSE $0

$V{ROLLUP_REGION_NO} !=null && $V{Age_Group_Total_Volume}!=null
?
   (($V{ROLLUP_REGION_NO} == 1909 || $V{ROLLUP_REGION_NO}==1910 ) &&  $P{Avg_Rate_Coast} !=null                                  ?    $V{Age_Group_Total_Volume} * $P{Avg_Rate_Coast} :
   (($V{ROLLUP_REGION_NO} == 1905 || $V{ROLLUP_REGION_NO}==1906 || $V{ROLLUP_REGION_NO}==1908 ) && $P{Avg_Rate_NInterior} !=null ?    $V{Age_Group_Total_Volume} * $P{Avg_Rate_NInterior} :
   (($V{ROLLUP_REGION_NO} == 1903 || $V{ROLLUP_REGION_NO}==1904 || $V{ROLLUP_REGION_NO}==1907 ) && $P{Avg_Rate_SInterior} !=null ?    $V{Age_Group_Total_Volume} * $P{Avg_Rate_SInterior} : 0
    )))
: 0]]></variableExpression>
	</variable>
