//ELSE
//{HBS2R602.POPULATION_NUMBER} + '-' + {HBS2R602.STRATUM_NUMBER} + '-' + cStr({HBS2R602.SAMPLING_YEAR}, 0, '')


$F{POPULATION_NUMBER}==null || $F{POPULATION_NUMBER}.isEmpty() ||
$F{STRATUM_NUMBER}==null || $F{STRATUM_NUMBER}.isEmpty() ||
$F{SAMPLING_YEAR}==null
? "* " + ($F{INPUT_PSY} !=null ? $F{INPUT_PSY} : "")
: $F{POPULATION_NUMBER} + "-" + $F{STRATUM_NUMBER} + "-" + $F{SAMPLING_YEAR}.toString()]]></variableExpression>
