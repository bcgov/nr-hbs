	<variable name="CCF6_Calc_NetWeight" class="java.math.BigDecimal" resetType="None">
		<variableExpression><![CDATA[//{HBS2R602.GROSS_WEIGHT} - {HBS2R602.TARE_WEIGHT}

$F{GROSS_WEIGHT}!=null && $F{TARE_WEIGHT}!=null
? $F{GROSS_WEIGHT}.subtract( $F{TARE_WEIGHT})
: null]]></variableExpression>
	</variable>
	<variable name="CCF7_Calc_GrappleWeight" class="java.math.BigDecimal" resetType="None">
