	<variable name="CCF4_Show_TimberMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks" )
  ? "All "+ ( $P{PSR_TIMBERMARKFILTER} == null || $P{PSR_TIMBERMARKFILTER}.isEmpty() ? "" : $P{PSR_TIMBERMARKFILTER} ) + " Marks" :
( ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark" ) && !($P{PSR_CUTBLOCK}.isEmpty()))
  ? ( $P{PSR_TIMBERMARK} == null || $P{PSR_TIMBERMARK}.isEmpty() ? "" : $P{PSR_TIMBERMARK} ) + " - " + ( $P{PSR_CUTBLOCK} == null || $P{PSR_CUTBLOCK}.isEmpty() ? "" : $P{PSR_CUTBLOCK} ) :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark" )
  ? ( $P{PSR_TIMBERMARK} == null || $P{PSR_TIMBERMARK}.isEmpty() ? "" : $P{PSR_TIMBERMARK} ) :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinassociateddistricts" )
  ? "Associated " + ( $P{PSR_TIMBERMARKFILTER} == null || $P{PSR_TIMBERMARKFILTER}.isEmpty() ? "" : $P{PSR_TIMBERMARKFILTER} ) + " Marks" :
( ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinaregionordistrict" ) && $P{PSR_DISTRICTHARVESTED}.isEmpty())
  ? ( $P{PSR_TIMBERMARKFILTER} == null || $P{PSR_TIMBERMARKFILTER}.isEmpty() ? "" : $P{PSR_TIMBERMARKFILTER} ) + " In All" :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allsubmitter" )
  ? "All Submitters" :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "creator" )
  ? ( $P{PSR_CLIENTNO} == null || $P{PSR_CLIENTNO}.isEmpty() ? "" : $P{PSR_CLIENTNO} ) + " " + ( $P{PSR_CLIENTLOC} == null || $P{PSR_CLIENTLOC}.isEmpty() ? "" : $P{PSR_CLIENTLOC} ) :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "user" )
  ? ( $P{PSR_INPUTUSERID} == null || $P{PSR_INPUTUSERID}.isEmpty() ? "" : $P{PSR_INPUTUSERID} ) :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "na" )
  ? "n/a"
  : "" )))))))))]]></variableExpression>
	</variable>
