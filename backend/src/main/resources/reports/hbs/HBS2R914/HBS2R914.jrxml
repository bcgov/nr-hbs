	<variable name="CCF3_@pop" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TrimLeft({HBS2R914.POPULATION_NUMBER}) + ' '+ TrimLeft({HBS2R914.STRATUM_NUMBER}) + ' ' + Right(ToText({HBS2R914.SAMPLING_YEAR},'#'),2)

$F{POPULATION_NUMBER}.trim() + " " +$F{STRATUM_NUMBER}.trim() + " " + ($F{SAMPLING_YEAR}.toString()).substring(2)]]></variableExpression>
	</variable>
	<variable name="CCF4_ShowFromDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//mid({?RB_SCALED_FROM},1,5) & MonthName(toNumber(mid({?RB_SCALED_FROM},6,2)),true) & mid({?RB_SCALED_FROM},8,3);

// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_SCALED_FROM}== null || $P{RB_SCALED_FROM}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_SCALED_FROM})]]></variableExpression>
	</variable>
	<variable name="CCF5_ShowToDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//mid({?RB_SCALED_TO},1,5) & MonthName (toNumber(mid({?RB_SCALED_TO},6,2)),true) & mid({?RB_SCALED_TO},8,3);

// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_SCALED_TO}== null || $P{RB_SCALED_TO}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_SCALED_TO})]]></variableExpression>
	</variable>
	<variable name="CCF6_show_anomalystatus" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?RB_ANOMALY_STATUS}='' THEN
//'All'
//ELSE
//{?RB_ANOMALY_STATUS}

$P{RB_ANOMALY_STATUS} !=null && !($P{RB_ANOMALY_STATUS}.isEmpty())
? $P{RB_ANOMALY_STATUS}
: "All"]]></variableExpression>
	</variable>
	<variable name="CCF7_WEIGH_SLIP_NUMBER_as_int" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{WEIGH_SLIP_NUMBER} != null && !($F{WEIGH_SLIP_NUMBER}.isEmpty())
?
    $F{WEIGH_SLIP_NUMBER}.matches("[0-9]+")
    ?
        Integer.valueOf($F{WEIGH_SLIP_NUMBER})
    :
        Integer.valueOf($F{WEIGH_SLIP_NUMBER}.replaceAll("[^0-9]", ""))
: 0]]></variableExpression>
	</variable>
	<variable name="CCF7_MissingSlips" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TATA DEVELOPER START OF CHANGE BT8643 15-07-2005
//displayMissingRange (TOnUMBER({HBS2R914.WEIGH_SLIP_NUMBER}), {HBS2R914.GAPCOUNT})
//TATA DEVELOPER END OF CHANGE BT8643 15-07-2005

//Function (numbervar returnNumber,numbervar gapCount )
//    numberVar firstMissingReturn := returnNumber - gapCount ;  //last  missing return
//    numberVar lastMissingReturn  := returnNumber - 1 ;
//    stringVar strFirstMissing := TOTEXT(firstMissingReturn,"#######");
//    stringVar strLastMissing  := TOTEXT(lastMissingReturn ,"#######");
//IF gapCount > 1 THEN
//    TRIM(strFirstMissing) + " - " + TRIM(strLastMissing)
//    ELSE
//        strLastMissing


$F{GAPCOUNT} !=null && ($F{GAPCOUNT}).intValue() >1
?
    String.valueOf($V{CCF7_WEIGH_SLIP_NUMBER_as_int} - $F{GAPCOUNT}.intValue()) + " - " + String.valueOf($V{CCF7_WEIGH_SLIP_NUMBER_as_int} - 1 )
:
    String.valueOf($V{CCF7_WEIGH_SLIP_NUMBER_as_int}.intValue() - 1)]]></variableExpression>
	</variable>
	<variable name="CCF8_show_site" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TATA DEVELOPER 1993
//if {?RB_SEARCH_BY} = 'allsites' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'site' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'associatedsites' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'sitesinassociateddistricts' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'license' then
//'Primary Scaler Licence:'
//else if {?RB_SEARCH_BY} = '' then
//'Primary Scaler Licence:'


$P{RB_SEARCH_BY} !=null
?
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "allsites" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "site" ) ? "Scale Sites:" :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "associatedsites" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "sitesinassociateddistricts" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "license" ) ? "Primary Scaler Licence:"  : "Primary Scaler Licence:"
        )))))
:  "Primary Scaler Licence:"]]></variableExpression>
	</variable>
	<variable name="Unused_CCF9_show_license" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// TATA DEVELOPER BT 1993
// if {?RB_SEARCH_BY}= 'license' Then
//'Primary Scaler License'

" "]]></variableExpression>
	</variable>
	<variable name="CCF10_show_scale_site_values" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TATA DEVELOPER 1993
//if{?RB_SEARCH_BY} = 'allsites' then
//'All Sites'
//else if  {?RB_SEARCH_BY} = 'site' then
//{?RB_SCALE_SITE}
//else if  {?RB_SEARCH_BY} = 'associatedsites' then
//'Associated Sites'
//else if  {?RB_SEARCH_BY} = 'sitesinassociateddistricts' then
//'Associated Sites'
//else if  {?RB_SEARCH_BY} = 'license' then
//{?RB_PRIMARY_LICENSE}
//else if  {?RB_SEARCH_BY} = '' then
//{?RB_PRIMARY_LICENSE}

$P{RB_SEARCH_BY} !=null
?
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "allsites" ) ? "All Sites"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "site" ) ? $P{RB_SCALE_SITE}  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "associatedsites" ) ? "Associated Sites"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "sitesinassociateddistricts" ) ? "Associated Sites"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "license" ) ? $P{RB_PRIMARY_LICENSE}  : $P{RB_PRIMARY_LICENSE}
        )))))

:  $P{RB_PRIMARY_LICENSE}]]></variableExpression>
	</variable>
	<variable name="CCF11_Show_Assessment_from" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{?RB_FROM_ASSESSMENT} + ' days ago'

$P{RB_FROM_ASSESSMENT}!= null
? $P{RB_FROM_ASSESSMENT} + " days ago"
: " days ago"]]></variableExpression>
	</variable>
	<variable name="CCF12_Show_Assessment_to" class="java.lang.String" resetType="None">
