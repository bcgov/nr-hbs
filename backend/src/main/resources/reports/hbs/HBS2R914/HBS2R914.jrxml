	<variable name="CCF13_anomalyType" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({?RB_ANOMALY_TYPE} = 'G') THEN
//'Gap'
//ELSE IF({?RB_ANOMALY_TYPE} = 'D') THEN
//'Duplicate'


$P{RB_ANOMALY_TYPE} !=null
