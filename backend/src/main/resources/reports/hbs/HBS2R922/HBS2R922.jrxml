//ELSE
//''

// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_ASSESSED_TO}== null || $P{RB_ASSESSED_TO}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_ASSESSED_TO})]]></variableExpression>
	</variable>
