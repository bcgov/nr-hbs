	<variable name="Unused_CCF3_@pop" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TrimLeft({HBS2R914.POPULATION_NUMBER}) + ' '+ TrimLeft({HBS2R914.STRATUM_NUMBER}) + ' ' + Right(ToText({HBS2R914.SAMPLING_YEAR},'#'),2)
""]]></variableExpression>
	</variable>
	<variable name="CCF4_ShowFromDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//mid({?RB_SCALED_FROM},1,5) & MonthName (toNumber(mid({?RB_SCALED_FROM},6,2)),true) & mid({?RB_SCALED_FROM},8,3);


// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_SCALED_FROM}== null || $P{RB_SCALED_FROM}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_SCALED_FROM})]]></variableExpression>
	</variable>
	<variable name="CCF5_ShowToDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//mid({?RB_SCALED_TO},1,5) & MonthName(toNumber(mid({?RB_SCALED_TO},6,2)),true) & mid({?RB_SCALED_TO},8,3);

// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_SCALED_TO}== null || $P{RB_SCALED_TO}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_SCALED_TO})]]></variableExpression>
	</variable>
	<variable name="CCF6_assit var" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{LOAD_ARRIVAL_NUMBER} != null && !($F{LOAD_ARRIVAL_NUMBER}.isEmpty())
?
    $F{LOAD_ARRIVAL_NUMBER}.matches("[0-9]+")
    ?
        Integer.valueOf($F{LOAD_ARRIVAL_NUMBER})
    :
        Integer.valueOf($F{LOAD_ARRIVAL_NUMBER}.replaceAll("[^0-9]", ""))
: 0]]></variableExpression>
	</variable>
	<variable name="CCF6_MissingArival" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{GAPCOUNT} !=null && ($F{GAPCOUNT}).intValue() >1
?
    String.valueOf($V{CCF6_assit var} - $F{GAPCOUNT}.intValue()) + " - " + String.valueOf($V{CCF6_assit var} - 1 )
:
    String.valueOf($V{CCF6_assit var} - 1)]]></variableExpression>
	</variable>
	<variable name="CCF7_show_anomalystatus" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?RB_ANOMALY_STATUS}='' THEN
//'All'
//ELSE
//{?RB_ANOMALY_STATUS}

$P{RB_ANOMALY_STATUS} !=null && !($P{RB_ANOMALY_STATUS}.isEmpty())
? $P{RB_ANOMALY_STATUS}
: "All"]]></variableExpression>
	</variable>
	<variable name="CCF8_show_scale_sites_value" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TATA DEVELOPER 1993
//if{?RB_SEARCH_BY} = 'allsites' then
//'All Sites'
//else if  {?RB_SEARCH_BY} = 'site' then
//{?RB_SCALE_SITE}
//else if  {?RB_SEARCH_BY} = 'associatedsites' then
//'Associated Sites'
//else if  {?RB_SEARCH_BY} = 'sitesinassociateddistricts' then
//'Associated Sites'
//else if  {?RB_SEARCH_BY} = 'license' then
//{?RB_PRIMARY_LICENSE}


$P{RB_SEARCH_BY} !=null
?
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "allsites" ) ? "All Sites"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "site" ) ? $P{RB_SCALE_SITE}  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "associatedsites" ) ? "Associated Sites"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "sitesinassociateddistricts" ) ? "Associated Sites"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "license" ) ? $P{RB_PRIMARY_LICENSE}  : ""
        )))))

:  ""]]></variableExpression>
	</variable>
	<variable name="CCF9_show_site" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//TATA DEVELOPER 1993
//if {?RB_SEARCH_BY} = 'allsites' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'site' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'associatedsites' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'sitesinassociateddistricts' then
//'Scale Sites:'
//else if {?RB_SEARCH_BY} = 'license' then
//Primary Scaler Licence:'

$P{RB_SEARCH_BY} !=null
?
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "allsites" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "site" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "associatedsites" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "sitesinassociateddistricts" ) ? "Scale Sites:"  :
    ($P{RB_SEARCH_BY}.equalsIgnoreCase( "license" ) ? "Primary Scaler Licence:"  : ""
        )))))

:  ""]]></variableExpression>
	</variable>
	<variable name="CCF10_show_assessment_begin" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{?RB_FROM_ASSESSMENT} + ' days ago'

$P{RB_FROM_ASSESSMENT}!= null
? $P{RB_FROM_ASSESSMENT} + " days ago"
: " days ago"]]></variableExpression>
	</variable>
	<variable name="CCF11_show_assessment_end" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{?RB_TO_ASSESSMENT} + ' days ago'


$P{RB_TO_ASSESSMENT}!= null
? $P{RB_TO_ASSESSMENT} + " days ago"
: " days ago"]]></variableExpression>
	</variable>
	<variable name="CCF12_anomalyType" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({?RB_ANOMALY_TYPE} = 'G') THEN
//'Gap'
//ELSE IF({?RB_ANOMALY_TYPE} = 'D') THEN
//'Duplicate'

$P{RB_ANOMALY_TYPE} !=null
?
    ($P{RB_ANOMALY_TYPE}.equalsIgnoreCase( "G" ) ? "Gap"  :
    ($P{RB_ANOMALY_TYPE}.equalsIgnoreCase( "D" ) ? "Duplicate"  : ""
        ))

:  " "]]></variableExpression>
	</variable>
	<variable name="CCF13_Show_Return_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({HBS2R922.RETURNTYPECODE}) = 'P' THEN          'LT'
//ELSE IF ({HBS2R922.RETURNTYPECODE}) = 'W' THEN    'WS'
//ELSE IF ({HBS2R922.RETURNTYPECODE}) = 'S' THEN    'ST'
//ELSE IF ({HBS2R922.RETURNTYPECODE}) = 'A' THEN    'AL'
//ELSE IF ({HBS2R922.RETURNTYPECODE}) = 'D' THEN    'DL'
//ELSE IF ({HBS2R922.RETURNTYPECODE}) = 'F' THEN    'SFP'

$F{RETURNTYPECODE} !=null
?
    ($F{RETURNTYPECODE}.equalsIgnoreCase( "P" ) ? "LT"  :
    ($F{RETURNTYPECODE}.equalsIgnoreCase( "W" ) ? "WS"  :
    ($F{RETURNTYPECODE}.equalsIgnoreCase( "S" ) ? "ST"  :
    ($F{RETURNTYPECODE}.equalsIgnoreCase( "A" ) ? "AL"  :
    ($F{RETURNTYPECODE}.equalsIgnoreCase( "D" ) ? "DL"  :
    ($F{RETURNTYPECODE}.equalsIgnoreCase( "F" ) ? "SFP"  : " "
        ))))))

:  " "]]></variableExpression>
	</variable>
	<variable name="CCF14_assessment_from_date" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//If not isnull({?RB_ASSESSED_FROM}) AND Trim ({?RB_ASSESSED_FROM}) <> '' then
//mid({?RB_ASSESSED_FROM},1,5) & MonthName (toNumber(mid({?RB_ASSESSED_FROM},6,2)),true) & mid({?RB_ASSESSED_FROM},8,3)
//ELSE
//''

// convert input formated as yyyy-mm-dd to date
// have output field formate to string as yyyy-MMM-dd

$P{RB_ASSESSED_FROM}== null || $P{RB_ASSESSED_FROM}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_ASSESSED_FROM})]]></variableExpression>
	</variable>
	<variable name="CCF15_assessment_to_date" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//If not isnull({?RB_ASSESSED_TO}) AND Trim ({?RB_ASSESSED_TO}) <> '' then
