	<variable name="CCF0_Show_CopyToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// If this is the first copied to section for the cleint (ie we have jsut finished printing his billed to section)
//// of this is a completeley new client then print the copied heading again
//
//IF ((pagenumber = 1) AND ({HBS3R471.CATEGORY} <> 'A')) then
//    'Statements Copied to: ' + left({HBS3R471.CLIENTPC}, 8) + ' ' + right({HBS3R471.CLIENTPC}, 2) + '   ' + {HBS3R471.CLIENT_NAME}
//
//ELSE IF (({HBS3R471.CATEGORY} = "B") AND (Previous ({HBS3R471.CATEGORY}) = "A"))
//  OR ({HBS3R471.CLIENTPC} <> Previous({HBS3R471.CLIENTPC}) and ({HBS3R471.CATEGORY} = "B")) THEN
//       'Statements Copied to: ' + left({HBS3R471.CLIENTPC}, 8) + ' ' + right({HBS3R471.CLIENTPC}, 2) + '   ' + {HBS3R471.CLIENT_NAME}
//
//ELSE
// ''


  "Statements Copied to: " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty())
      ? ( $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : $F{CLIENTPC} )
      : ""
  ) +
  " " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty())
      ? ( $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : $F{CLIENTPC} )
      : ""
  ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_BilledToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If {HBS3R471.CATEGORY} = 'A' THEN
//     'Statements Sent to: ' + left({HBS3R471.CLIENTPC}, 8) + ' ' + right({HBS3R471.CLIENTPC}, 2) + '   ' + {HBS3R471.CLIENT_NAME}
//ELSE
// ''

  "Statements Sent to: " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty())
      ? ( $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : $F{CLIENTPC} )
      : ""
  ) +
  " " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty())
      ? ( $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : $F{CLIENTPC} )
      : ""
  ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )]]></variableExpression>
	</variable>
