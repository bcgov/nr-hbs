	<variable name="CCF8_Show_TimberMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// replace 2 single quotes (added by Java side to enable query to work) with one single quote
//Replace ({?RB_TIMBER_MARK}, "''" ,"'" )
( $P{RB_TIMBER_MARK} == null || $P{RB_TIMBER_MARK}.isEmpty()
? ""
: $P{RB_TIMBER_MARK}.replaceAll( "''", "'" )
