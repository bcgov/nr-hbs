	</parameter>
	<queryString>
		<![CDATA[SELECT
       PSS.SEGREGATION_ID
     , PSS.PSSEG_TYPE
     , PSS.DOCUMENT_CONTROL_NUMBER
     , PSS.VERSION
     , PSS.SCALE_SPECIES_CODE
     , PSS.SCALE_PRODUCT_CODE
     , PSS.SCALE_GRADE_CODE
     , PSS.NUMBER_OF_PIECES
     , PSS.VOLUME
     , PSS.TIMBER_MARK
     , PSS.INPUT_SPECIES
     , PSS.INPUT_PRODUCT
     , PSS.INPUT_GRADE
     , PSS.INPUT_BCOMB_TIMBER_MARK
     , PSS.INPUT_OTHER_DESC
     , PSS.ARCHIVE_TIMBER_MARK
     , PSS.SB4_IND
     , PSS.NMV_IND
     , PSS.AVOIDABLE_IND
     , PSS.OTHER_DESCRIPTION_TYPE_CODE
     , SSC.DESCRIPTION  AS SCALE_SPECIES_DESC
     , SPC.DESCRIPTION  AS SCALE_PRODUCT_DESC
     , SGC.DESCRIPTION  AS SCALE_GRADE_DESC
     , PSTS.TXN_SEG_ID
     , PSTS.TRX_ID
     , PSTS.VALUE
     , PSTS.RATE
     , PSTS.OVERRIDE_RATE_ID
     , PSTS.WSTRT_ID
     , PSTS.RATE_SOURCE
     , PSTS.RESERVE_STMPG_RATE_COMPONENT
     , PSTS.BONUS_BID_RATE_COMPONENT
     , PSTS.DEV_LEVY_RATE_COMPONENT
     , PSTS.SILV_LEVY_RATE_COMPONENT
     , PSTS.RESERVE_STMPG_AMOUNT_COMPONENT
     , PSTS.BONUS_BID_AMOUNT_COMPONENT
     , PSTS.DEV_LEVY_AMOUNT_COMPONENT
     , PSTS.SILV_LEVY_AMOUNT_COMPONENT
FROM      PIECE_SCL_SEGREGATION       PSS
LEFT JOIN SCALE_SPECIES_CODE          SSC  ON SSC.SCALE_SPECIES_CODE           = PSS.SCALE_SPECIES_CODE
LEFT JOIN SCALE_PRODUCT_CODE          SPC  ON SPC.SCALE_PRODUCT_CODE           = PSS.SCALE_PRODUCT_CODE
LEFT JOIN PIECE_SCL_TXN_SEGREGATION   PSTS ON PSTS.SEGREGATION_ID              = PSS.SEGREGATION_ID
     JOIN SCALE_GRADE_CODE            SGC  ON SGC.SCALE_GRADE_CODE             = PSS.SCALE_GRADE_CODE
WHERE  PSS.DOCUMENT_CONTROL_NUMBER = $P{Pm-HBS2R052.DOCUMENT_CONTROL_NUMBER}
AND    PSS.VERSION                 = $P{Pm-HBS2R052.VERSION}
 ORDER BY
       PSS.TIMBER_MARK
     , SSC.DESCRIPTION
     , SPC.DESCRIPTION
     , SGC.DESCRIPTION
     , PSS.NMV_IND]]>
	</queryString>
