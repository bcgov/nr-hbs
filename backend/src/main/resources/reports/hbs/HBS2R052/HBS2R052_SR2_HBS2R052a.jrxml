	<variable name="CCF1_Show_Species" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{SCALE_SPECIES_CODE} == null || $F{SCALE_SPECIES_CODE}.isEmpty()
? ( $F{INPUT_SPECIES} == null || $F{INPUT_SPECIES}.isEmpty() ? "" : "* " + $F{INPUT_SPECIES} )
: $F{SCALE_SPECIES_DESC}]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Grade" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{SCALE_GRADE_CODE} == null || $F{SCALE_GRADE_CODE}.isEmpty()
? ( !($F{INPUT_GRADE}.equalsIgnoreCase( " " ))
  ? ( $F{SCALE_GRADE_DESC} == null || $F{SCALE_GRADE_DESC}.isEmpty() ? "" : "* " + $F{SCALE_GRADE_DESC} )
  : "  "
  )
: ( $F{SCALE_GRADE_DESC} == null || $F{SCALE_GRADE_DESC}.isEmpty() ? "" : $F{SCALE_GRADE_DESC} )]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_Product" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{SCALE_PRODUCT_CODE} == null || $F{SCALE_PRODUCT_CODE}.isEmpty()
? ( !($F{INPUT_PRODUCT}.equalsIgnoreCase( " " ))
  ? ( $F{INPUT_PRODUCT} == null || $F{INPUT_PRODUCT}.isEmpty() ? "" : "* " + $F{INPUT_PRODUCT} )
  : "  "
  )
: ( $F{SCALE_PRODUCT_DESC} == null || $F{SCALE_PRODUCT_DESC}.isEmpty() ? "" : $F{SCALE_PRODUCT_DESC} )]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_Timbermark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{TIMBER_MARK} == null || $F{TIMBER_MARK}.isEmpty()
? ( $F{INPUT_BCOMB_TIMBER_MARK} == null || $F{INPUT_BCOMB_TIMBER_MARK}.isEmpty() ? "" : "* " + $F{INPUT_BCOMB_TIMBER_MARK} )
: $F{TIMBER_MARK}]]></variableExpression>
	</variable>
