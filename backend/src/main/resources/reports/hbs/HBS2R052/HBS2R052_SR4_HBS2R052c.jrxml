	<queryString>
		<![CDATA[SELECT
       PSST.TRX_ID
     , PSST.HBS_TXN_TYPE_CODE
     , PSST.INVOICE_NUMBER
     , PSST.CANCELLATION_IND
     , PSST.VERSION
     , PSST.HBS_TXN_STATUS_CODE
     , PSST.TALLY_SKEY
     , PSST.DOCUMENT_CONTROL_NUMBER
     , PSST.BATCH_ID
     , PSST.OVERRIDE_RATING_RULE_ID
     , PSST.SMRYRETTXN_COMMENT
     , PSST.EVENT_SEQUENCE
     , PSST.DEBIT_CREDIT_TYPE
     , PSST.INTEREST_REVERSAL_IND
     , PSST.CLIENT_NUMBER_PAID_BY
     , PSST.CLIENT_LOCN_CODE_PAID_BY
     , PSST.CLIENT_NUMBER_COPIED_TO
     , PSST.CLIENT_LOCN_CODE_COPIED_TO
     , PSST.ENTRY_USERID
     , PSST.ENTRY_TIMESTAMP
     , PSST.UPDATE_USERID
     , PSST.UPDATE_TIMESTAMP
     , PSTS.TXN_SEG_ID
     , PSTS.SEGREGATION_ID
     , PSTS.SCALE_GRADE_CODE
     , PSTS.SCALE_PRODUCT_CODE
     , PSTS.SCALE_SPECIES_CODE
     , PSTS.VOLUME
     , PSTS.VALUE
     , PSTS.RATE
     , PSTS.OVERRIDE_RATE_ID
     , PSTS.WSTRT_ID
     , PSTS.RATE_SOURCE
     , PSTS.RESERVE_STMPG_RATE_COMPONENT
     , PSTS.BONUS_BID_RATE_COMPONENT
     , PSTS.DEV_LEVY_RATE_COMPONENT
     , PSTS.SILV_LEVY_RATE_COMPONENT
     , PSTS.RESERVE_STMPG_AMOUNT_COMPONENT
     , PSTS.BONUS_BID_AMOUNT_COMPONENT
     , PSTS.DEV_LEVY_AMOUNT_COMPONENT
     , PSTS.SILV_LEVY_AMOUNT_COMPONENT
     , HTTC.DESCRIPTION
     , HTTC.EFFECTIVE_DATE
     , HTTC.EXPIRY_DATE
     , FINV.PAYABLE_BY_CLIENT
     , FINV.PAYABLE_BY_CLI_LOC
     , FINV.INVOICE_AMOUNT
     , FINV.INVOICE_CLASS_CODE
     , FINV.INVOICE_DATE
     , FINV.INVOICE_TYPE_CODE
     , FINV.INVC_SUB_TYPE_CODE
     , FINV.CANCELLED_BY_INVC
     , FINV.ORG_UNIT_NO
     , FINV.RELATED_INVOICE
     , FINV.INVOICE_RLN_TYP_CD
     , FINV.REL_INVOICE_STS_ST
     , FINV.REPLACED_BY_INVC
     , FINV.SCALE_RETURN_DATE
     , FINV.SCALE_SITE_ID_NMBR
     , FINV.SCALER_LICENCE_NUM
     , FINV.VOLUME_ONLY_IND
     , FINV.COPY_TO_CLIENT
     , FINV.COPY_TO_CLI_LOC
     , FINV.POSTED_DATE
     , FINV.POSTED_SEQUENCE_NO
     , FINV.SCALED_AT
     , OVRR.OVRRDRTRL_TYPE
     , OVRR.TIMBER_MARK
     , OVRR.FIELD_SCALE_DECK_ID
     , OVRR.OVERRIDE_RULE_CATEGORY_CODE
     , OVRR.OVERRIDE_RULE_STATUS_CODE
     , OVRR.OVRRDRTRL_COMMENT
     , OVRR.PROCESSING_EFFECTIVE_DATE
     , OVRR.PROCESSING_EXPIRY_DATE
     , OVRR.SCALE_EFFECTIVE_DATE
     , OVRR.SCALE_EXPIRY_DATE
     , OVRR.OVERRIDE_RATE_DATE
     , HOPB.HBS_RETURN_TYPE_CODE
     , HOPB.TRANSMISSION_ID
     , HOPB.OUTPUT_BATCH_STATUS_CODE
     , HOPB.RETURN_COUNT
     , HOPB.SENT_DATE_TIME
     , HOPB.RECORD_COUNT
     , HOPB.SENT_IND
     , HOPB.RECONCILED_TXN_COUNT
FROM      PIECE_SCL_SMRY_TXN        PSST
LEFT JOIN PIECE_SCL_TXN_SEGREGATION PSTS ON  PSTS.TRX_ID                  = PSST.TRX_ID
                                         AND PSTS.DOCUMENT_CONTROL_NUMBER = PSST.DOCUMENT_CONTROL_NUMBER
                                         AND PSTS.VERSION                 = PSST.VERSION
LEFT JOIN HBS_TXN_TYPE_CODE         HTTC ON  HTTC.HBS_TXN_TYPE_CODE       = PSST.HBS_TXN_TYPE_CODE
LEFT JOIN FOREST_INVOICE            FINV ON  FINV.INVOICE_NUMBER          = PSST.INVOICE_NUMBER
                                         AND FINV.CANCELLATION_IND        = PSST.CANCELLATION_IND
LEFT JOIN OVERRIDE_RATING_RULE      OVRR ON  OVRR.OVERRIDE_RATING_RULE_ID = PSST.OVERRIDE_RATING_RULE_ID
LEFT JOIN HBS_OUTPUT_BATCH          HOPB ON  HOPB.BATCH_ID                = PSST.BATCH_ID
WHERE  PSST.DOCUMENT_CONTROL_NUMBER = $P{Pm-HBS2R052.DOCUMENT_CONTROL_NUMBER}
ORDER BY
       PSST.EVENT_SEQUENCE DESC]]>
	</queryString>
