	<variable name="CCF0_Show_SortBy" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Select {?PSR_ORDERBY}
//  Case "0":    "Sorted By: Detail Document Number"
//  Case "1":    "Sorted By: Version Status"
//  Case "2":    "Sorted By: Scaling Event"
//  Case "3":    "Sorted By: Scale Date"
//  Case "4":    "Sorted By: Timber Mark"
//  Case "5":    "Sorted By: Scale Site"
//  Case "13":   "Sorted By: Version"
//  Default:     "Sorted By: Summary Document Number";

$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "0" ) ? "Sorted By: Detail Document Number"  :
$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "1" ) ? "Sorted By: Version Status"  :
$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "2" ) ? "Sorted By: Scaling Event"  :
$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "3" ) ? "Sorted By: Scale Date"  :
$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "4" ) ? "Sorted By: Timber Mark"  :
$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "5" ) ? "Sorted By: Scale Site"  :
$P{PSR_ORDERBY}!=null && $P{PSR_ORDERBY}.equalsIgnoreCase( "13" ) ? "Sorted By: Version"  : "Sorted By: Summary Document Number"]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_PopStratYear" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
//IF ISNULL({HBS2R651.POPULATION_NUMBER}) OR ISNULL({HBS2R651.STRATUM_NUMBER}) OR ISNULL({HBS2R651.SAMPLING_YEAR}) THEN
// '* ' + {HBS2R651.INPUT_PSY}
//ELSE
// {HBS2R651.POPULATION_NUMBER} + " " + {HBS2R651.STRATUM_NUMBER} + " " + totext({HBS2R651.SAMPLING_YEAR},0,'')


$F{POPULATION_NUMBER} == null || $F{STRATUM_NUMBER} == null || $F{SAMPLING_YEAR} == null
?
    "* " + ( $F{INPUT_PSY} == null || $F{INPUT_PSY}.isEmpty() ? "" : $F{INPUT_PSY} )
:
    ( $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ? "" : $F{POPULATION_NUMBER} ) + " " +
    ( $F{STRATUM_NUMBER} == null || $F{STRATUM_NUMBER}.isEmpty() ? "" : $F{STRATUM_NUMBER} ) + " " +
    ( $F{SAMPLING_YEAR} == null ? "" : new DecimalFormat("###0").format( $F{SAMPLING_YEAR} ) )]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_ScaleSite" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF{?='allsites' THEN  'All Sites'
//ELSE IF {?PSR_SEARCHBYSITES}='singlesite' then  {?PSR_SCALESITE}
//ELSE IF {?PSR_SEARCHBYSITES}='sitesinassociateddistricts' then  'Associated Sites'
//ELSE IF {?PSR_SEARCHBYSITES}='associatedsites' then 'Associated Sites'
//ELSE IF {?PSR_SEARCHBYSITES}='sitesinaregionordistrict' and {?PSR_DISTRICTSCALED}="" then   'In All'
//ELSE IF {?PSR_SEARCHBYSITES}='sitesinregionordistrict' and {?PSR_DISTRICTSCALED}="" then    'In All'
//ELSE IF {?PSR_SCALESITE}='null' then    {?PSR_SEARCHBYSITES}
//ELSE IF {?PSR_SEARCHBYSITES}='mofdualrolesscaledata'  then  'Associated Sites'
//ELSE IF {?PSR_SEARCHBYSITES}='clientdualrolesscaledata'  then   'Associated Sites'


$P{PSR_SEARCHBYSITES}!=null
?
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "allsites" ) ? "All Sites" :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "singlesite" ) ? ( $P{PSR_SCALESITE} == null || $P{PSR_SCALESITE}.isEmpty() ? "" : $P{PSR_SCALESITE} ) :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinassociateddistricts" ) ? "Associated Sites" :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "associatedsites" ) ? "Associated Sites" :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinaregionordistrict" ) && ($P{PSR_DISTRICTSCALED}== null ||$P{PSR_DISTRICTSCALED}.isEmpty() ) ? "In All" :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinregionordistrict" ) && ( $P{PSR_DISTRICTSCALED}== null || $P{PSR_DISTRICTSCALED}.isEmpty() ) ? "In All" :
    ((($P{PSR_SCALESITE} == null) || ($P{PSR_SCALESITE} != null && $P{PSR_SCALESITE}.equalsIgnoreCase( "null" ))) ? ( $P{PSR_SEARCHBYSITES} == null || $P{PSR_SEARCHBYSITES}.isEmpty() ? "" : $P{PSR_SEARCHBYSITES} ) :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "mofdualrolesscaledata" ) ? "Associated Sites" :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "clientdualrolesscaledata" ) ? "Associated Sites" : ""
        )))))))))
: ""]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_LicenseNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
//IF ISNULL({HBS2R651.PRIMARY_LICENSE_NUMBER}) THEN
// '* ' + {HBS2R651.INPUT_PRIMARY_SCALER_LIC}
//ELSE
// {HBS2R651.PRIMARY_LICENSE_NUMBER}

$F{PRIMARY_LICENSE_NUMBER} == null
?
 "* " + ( $F{INPUT_PRIMARY_SCALER_LIC} == null || $F{INPUT_PRIMARY_SCALER_LIC}.isEmpty() ? "" : $F{INPUT_PRIMARY_SCALER_LIC} )
:
 $F{PRIMARY_LICENSE_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF4_recordCount" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[//IF IsNull( Count ({HBS2R651.DETAIL_DOCUMENT_NUMBER}) ) THEN
//    0
//ELSE
//    Count ({HBS2R651.DETAIL_DOCUMENT_NUMBER})

$F{DETAIL_DOCUMENT_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_TimberMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF{?PSR_SEARCHBYMARKS}='allmarks' THEN            'All '+{?PSR_TIMBERMARKFILTER}+' Marks'
//ELSE IF {?PSR_SEARCHBYMARKS}='singlemark' then    {?PSR_TIMBERMARK}
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinassociateddistricts' then        'Associated '+{?PSR_TIMBERMARKFILTER}+' Marks'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinaregionordistrict' and {?PSR_DISTRICTHARVESTED}="" then      {?PSR_TIMBERMARKFILTER}+' In All'
//ELSE IF{?PSR_SEARCHBYMARKS}='allsubmitter' THEN       'All Submitters'
//ELSE IF {?PSR_SEARCHBYMARKS}='creator' then       {?PSR_CLIENTNO}+" "+{?PSR_CLIENTLOC}
//ELSE IF {?PSR_SEARCHBYMARKS}='user' then          {?PSR_INPUTUSERID}



$P{PSR_SEARCHBYMARKS}!=null
?
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks" ) ? "All " + ( $P{PSR_TIMBERMARKFILTER} == null || $P{PSR_TIMBERMARKFILTER}.isEmpty() ? "" : $P{PSR_TIMBERMARKFILTER} ) + " Marks"  :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark" ) ? ( $P{PSR_TIMBERMARK} == null || $P{PSR_TIMBERMARK}.isEmpty() ? "" : $P{PSR_TIMBERMARK} )  :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinassociateddistricts" ) ? "Associated " + ( $P{PSR_TIMBERMARKFILTER} == null || $P{PSR_TIMBERMARKFILTER}.isEmpty() ? "" : $P{PSR_TIMBERMARKFILTER} ) + " Marks"  :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinaregionordistrict" ) && ( $P{PSR_DISTRICTHARVESTED}==null ||$P{PSR_DISTRICTHARVESTED}.isEmpty() ) ? ( $P{PSR_TIMBERMARKFILTER} == null || $P{PSR_TIMBERMARKFILTER}.isEmpty() ? "" : $P{PSR_TIMBERMARKFILTER} ) + " In All"  :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allsubmitter" ) ? "All Submitters"  :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "creator" ) ? ( $P{PSR_CLIENTNO} == null || $P{PSR_CLIENTNO}.isEmpty() ? "" : $P{PSR_CLIENTNO} ) + " " + ( $P{PSR_CLIENTLOC} == null || $P{PSR_CLIENTLOC}.isEmpty() ? "" : $P{PSR_CLIENTLOC} )  :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "user" ) ? ( $P{PSR_INPUTUSERID} == null || $P{PSR_INPUTUSERID}.isEmpty() ? "" : $P{PSR_INPUTUSERID} ) : ""
        )))))))
:""]]></variableExpression>
	</variable>
	<variable name="CCF6_show_value" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF{?PSR_SEARCHBYMARKS}='allmarks' THEN
//'Timber Marks :'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinregionordistrict' then
//'Timber Marks :'
//ELSE IF {?PSR_SEARCHBYMARKS}='singlemark' then
//'Timber Marks :'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinassociateddistricts' then
//'Timber Marks :'
//ELSE IF{?PSR_SEARCHBYMARKS}='allsubmitter' THEN
//'Submitters :'
//ELSE IF {?PSR_SEARCHBYMARKS}='creator' then
//'Submitters :'
//ELSE IF {?PSR_SEARCHBYMARKS}='user' then
//'Submitters :'

$P{PSR_SEARCHBYMARKS}!=null &&
(   $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks" ) ||
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinregionordistrict" ) ||
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark" ) ||
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinassociateddistricts" ) )
?    "Timber Marks:"   :

$P{PSR_SEARCHBYMARKS}!=null &&
(   $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allsubmitter" ) ||
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "creator" ) ||
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "user" )  )
?    "Submitters:"   : ""]]></variableExpression>
	</variable>
	<variable name="CCF7_show_mark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF{?PSR_SEARCHBYMARKS}='allmarks' THEN
//'Timber Marks:'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinaregionordistrict' then
//'Timber Marks:'
