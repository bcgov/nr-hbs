?    "Submitters:"   : ""]]></variableExpression>
	</variable>
	<variable name="CCF8_Show_PSY" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?PSR_POPULATION}) = 'invalid' THEN ''
//ELSE IF ({?PSR_STRATUM}  = '99') AND ({?PSR_SAMPLINGYEAR} = '9999')  AND ({?PSR_POPULATION}='9999') THEN        ' '
//ELSE IF ({?PSR_STRATUM}  = 'null') AND ({?PSR_SAMPLINGYEAR} = 'null') THEN    {?PSR_POPULATION} + ' '
//ELSE IF ({?PSR_SAMPLINGYEAR} = 'null') THEN    {?PSR_POPULATION} + " " + {?PSR_STRATUM} + ' '
//ELSE {?PSR_POPULATION} + " " + {?PSR_STRATUM} + " " + totext({?PSR_SAMPLINGYEAR})


$P{PSR_POPULATION}!=null && $P{PSR_POPULATION}.equalsIgnoreCase( "invalid" ) ? "" :

$P{PSR_STRATUM}!=null &&$P{PSR_STRATUM}.equalsIgnoreCase( "99" )&&
$P{PSR_SAMPLINGYEAR}!=null && $P{PSR_SAMPLINGYEAR}.equalsIgnoreCase( "9999" ) &&
$P{PSR_POPULATION}!=null && $P{PSR_POPULATION}.equalsIgnoreCase( "9999" ) ? " " :

(($P{PSR_STRATUM}==null) || ($P{PSR_STRATUM}!=null && $P{PSR_STRATUM}.equalsIgnoreCase( "null" ))) && 
(($P{PSR_SAMPLINGYEAR}==null) || ($P{PSR_SAMPLINGYEAR}!=null && $P{PSR_SAMPLINGYEAR}.equalsIgnoreCase( "null" ))) && 
$P{PSR_POPULATION}!=null? ( $P{PSR_POPULATION} == null || $P{PSR_POPULATION}.isEmpty() ? "" : $P{PSR_POPULATION} ) + " " :

(($P{PSR_SAMPLINGYEAR}==null) || ($P{PSR_SAMPLINGYEAR}!=null && $P{PSR_SAMPLINGYEAR}.equalsIgnoreCase( "null" ))) && 
$P{PSR_POPULATION}!=null? ( $P{PSR_POPULATION} == null || $P{PSR_POPULATION}.isEmpty() ? "" : $P{PSR_POPULATION} ) + " " + ( $P{PSR_STRATUM} == null || $P{PSR_STRATUM}.isEmpty() ? "" : $P{PSR_STRATUM} ) + " " :

( $P{PSR_POPULATION} == null || $P{PSR_POPULATION}.isEmpty() ? "" : $P{PSR_POPULATION} ) + " " +
( $P{PSR_STRATUM} == null || $P{PSR_STRATUM}.isEmpty() ? "" : $P{PSR_STRATUM} ) + " " +
( $P{PSR_SAMPLINGYEAR} == null || $P{PSR_SAMPLINGYEAR}.isEmpty() ? "" : $P{PSR_SAMPLINGYEAR} )]]></variableExpression>
	</variable>
	<variable name="CCF9_Show_FSDeckId" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//BT 10014
//IF ISNULL({?PSR_FIELDSCALEDECKID}) THEN
//    ''
//ELSE IF {?PSR_FIELDSCALEDECKID} = '99999' THEN
//    ''
//ELSE
//    {?PSR_FIELDSCALEDECKID}


$P{PSR_FIELDSCALEDECKID}!=null && !$P{PSR_FIELDSCALEDECKID}.equalsIgnoreCase( "99999" )
?   $P{PSR_FIELDSCALEDECKID}
:   ""]]></variableExpression>
	</variable>
	<variable name="CCF10_Show_Status" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({?PSR_VERSIONSTATUSCODE} = 'Invalid') THEN
//    ''
//ElSE
//   {?PSR_VERSIONSTATUSCODE}

$P{PSR_VERSIONSTATUSCODE}!=null && $P{PSR_VERSIONSTATUSCODE}.equalsIgnoreCase( "Invalid" ) ? "" : ( $P{PSR_VERSIONSTATUSCODE} == null || $P{PSR_VERSIONSTATUSCODE}.isEmpty() ? "" : $P{PSR_VERSIONSTATUSCODE} )]]></variableExpression>
	</variable>
	<variable name="CCF11_Show_CheckScale" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?PSR_CHKSCALEIND})='Y' THEN
//'Yes'
//ELSE
//'No'

$P{PSR_CHKSCALEIND}!=null && $P{PSR_CHKSCALEIND}.equalsIgnoreCase( "Y" ) ? "Yes" : "No"]]></variableExpression>
	</variable>
	<variable name="CCF12_Show_ErrorResponsibility" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({?PSR_ERRORRESPONSIBILITY})='I' THEN
//'Industry'
//ELSE IF ({?PSR_ERRORRESPONSIBILITY})='M'
//THEN 'Ministry'


$P{PSR_ERRORRESPONSIBILITY}!=null && $P{PSR_ERRORRESPONSIBILITY}.equalsIgnoreCase( "I" ) ? "Industry" :
$P{PSR_ERRORRESPONSIBILITY}!=null && $P{PSR_ERRORRESPONSIBILITY}.equalsIgnoreCase( "M" ) ? "Ministry" : ""]]></variableExpression>
	</variable>
	<variable name="CCF13_Show_CroInd" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?PSR_CROIND}) ='Y' THEN
//'Yes'
//ELSE ''


$P{PSR_CROIND}!=null && $P{PSR_CROIND}.equalsIgnoreCase( "Y" )
?   "Yes"
:   ""]]></variableExpression>
	</variable>
	<variable name="CCF14_show_license_number" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF{?PSR_LICENCENUMBER}='$' THEN
//''
//ELSE
// {?PSR_LICENCENUMBER}

$P{PSR_LICENCENUMBER}==null || $P{PSR_LICENCENUMBER}.equalsIgnoreCase( "$" )
? ""
: $P{PSR_LICENCENUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF15_Show_Version_Title" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF (UpperCase({?PSR_ACTIVEVERSIONINDICATOR})='Y') THEN
//'List of Sample Tallies - Current Versions'
//ELSE
//'List of Sample Tallies - All Versions'

$P{PSR_ACTIVEVERSIONINDICATOR}!=null && $P{PSR_ACTIVEVERSIONINDICATOR}.equalsIgnoreCase( "Y" )
?   "List of Sample Tallies - Current Versions"
:   "List of Sample Tallies - All Versions"]]></variableExpression>
	</variable>
	<variable name="CCF16_Show_ReceivedDateTo" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?PSR_RECEIVEDDATETO} <> '' then
//    {?PSR_RECEIVEDDATETO}
//else
//    {?PSR_INPUTBATCHDATETO}

$P{PSR_RECEIVEDDATETO}!=null && !$P{PSR_RECEIVEDDATETO}.isEmpty()
?    $P{PSR_RECEIVEDDATETO}
:    ( $P{PSR_INPUTBATCHDATETO} == null || $P{PSR_INPUTBATCHDATETO}.isEmpty() ? "" : $P{PSR_INPUTBATCHDATETO} )]]></variableExpression>
	</variable>
	<variable name="CCF17_Show_ReceivedDateFrom" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if  {?PSR_RECEIVEDDATEFROM} <> '' then
//    {?PSR_RECEIVEDDATEFROM}
//else
//    {?PSR_INPUTBATCHDATEFROM}

$P{PSR_RECEIVEDDATEFROM}!=null && !$P{PSR_RECEIVEDDATEFROM}.isEmpty()
?
    $P{PSR_RECEIVEDDATEFROM}
:
    ( $P{PSR_INPUTBATCHDATEFROM} == null || $P{PSR_INPUTBATCHDATEFROM}.isEmpty() ? "" : $P{PSR_INPUTBATCHDATEFROM} )]]></variableExpression>
	</variable>
	<variable name="CCF18_Show_ReturnToNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?PSR_SEARCHBYRANGE} = 'returnNumber' or {?PSR_SEARCHBYRANGE} = 'loadNumber' or {?PSR_SEARCHBYRANGE} = 'weighSlip') and {?PSR_NUMBERRANGETO} <> '' then
//    {?PSR_NUMBERRANGETO}
//else
//    ''

$P{PSR_SEARCHBYRANGE}!=null &&
(   $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "returnNumber" ) ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "loadNumber" ) ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "weighSlip" ) ) &&
$P{PSR_NUMBERRANGETO}!=null &&
!($P{PSR_NUMBERRANGETO}.isEmpty())
?
    $P{PSR_NUMBERRANGETO}
:
    ""]]></variableExpression>
	</variable>
	<variable name="CCF19_Show_ReturnFromNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?PSR_SEARCHBYRANGE} = 'returnNumber' or {?PSR_SEARCHBYRANGE} = 'loadNumber' or {?PSR_SEARCHBYRANGE} = 'weighSlip'  then
//    {?PSR_NUMBERRANGEFROM}
//else if {?PSR_SEARCHBYRANGE} = 'transId' then
//    {?PSR_TRANSPORTID}
//else if {?PSR_SEARCHBYRANGE} = 'ldsNumber' then
//    {?PSR_LDSNUMBER}
//else
//    {?PSR_RETURNNUMBER}


$P{PSR_SEARCHBYRANGE}!=null &&
(   $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "returnNumber" )    ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "loadNumber" )      ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "weighSlip" )       ) ? ( $P{PSR_NUMBERRANGEFROM} == null || $P{PSR_NUMBERRANGEFROM}.isEmpty() ? "" : $P{PSR_NUMBERRANGEFROM} ) :
$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "transId" ) ? ( $P{PSR_TRANSPORTID} == null || $P{PSR_TRANSPORTID}.isEmpty() ? "" : $P{PSR_TRANSPORTID} ) :
$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "ldsNumber" ) ? ( $P{PSR_LDSNUMBER} == null || $P{PSR_LDSNUMBER}.isEmpty() ? "" : $P{PSR_LDSNUMBER} ) : ( $P{PSR_RETURNNUMBER} == null || $P{PSR_RETURNNUMBER}.isEmpty() ? "" : $P{PSR_RETURNNUMBER} )]]></variableExpression>
	</variable>
	<variable name="CCF20_Show_Range_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?PSR_SEARCHBYRANGE} = 'loadNumber' then
//    'Load Number: '
//else if {?PSR_SEARCHBYRANGE} = 'weighSlip' then
//    'Weigh Slip: '
//else if {?PSR_SEARCHBYRANGE} = 'transId' then
//    'Transport ID: '
//else if {?PSR_SEARCHBYRANGE} = 'ldsNumber' then
//    'LDS Number: '
//else
//    'Return Number: '

$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "loadNumber" ) ? "Load Number: " :
$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "weighSlip" ) ? "Weigh Slip: " :
$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "transId" ) ? "Transport ID: " :
$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "ldsNumber" ) ? "LDS Number: " : "Return Number: "]]></variableExpression>
	</variable>
