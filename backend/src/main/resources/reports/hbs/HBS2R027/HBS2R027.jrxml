	<variable name="CCF0_strScale_Type_Heading" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{RB_RETURN_TYPE_CODE}.equalsIgnoreCase( "P" ) ? "Piece Scale" :
( $P{RB_RETURN_TYPE_CODE}.equalsIgnoreCase( "W" ) ? "Weight Scale" :
( $P{RB_RETURN_TYPE_CODE}.equalsIgnoreCase( "S" ) ? "Sample Scale" : " unknown scale type"
)))]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_RegDist_Name" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{RB_REGDIST} == null || $P{RB_REGDIST}.isEmpty() || $P{RB_REGDIST}.equalsIgnoreCase( " " )
? " "
: $F{ORG_UNIT_NAME}]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_FromDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{RB_AFTER_DATE} != null && !($P{RB_AFTER_DATE}.isEmpty()) && $P{RB_AFTER_DATE}.length() >= 19
? $P{RB_AFTER_DATE}.substring( 0, 19 )
: ""]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_ToDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{RB_BEFORE_DATE} != null && !($P{RB_BEFORE_DATE}.isEmpty()) && $P{RB_BEFORE_DATE}.length() >= 19
? $P{RB_BEFORE_DATE}.substring( 0, 19 )
: ""]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_Batch_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{RB_BATCH_TYPE}.equalsIgnoreCase( "rejectedbatches"         ) ? "Rejected Batches"           :
( $P{RB_BATCH_TYPE}.equalsIgnoreCase( "withrejecteddocuments"   ) ? "With Rejected Documents"    :
( $P{RB_BATCH_TYPE}.equalsIgnoreCase( "withnorejecteddocuments" ) ? "With No Rejected Documents" :
( $P{RB_BATCH_TYPE}.equalsIgnoreCase( "allbatches"              ) ? "All Batches "               : "" ))))]]></variableExpression>
	</variable>
	<variable name="CCF5_show_site" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{RB_SEARCH_BY_SITES} == null || $P{RB_SEARCH_BY_SITES}.isEmpty() ? "All Sites" :
( $P{RB_SEARCH_BY_SITES}.equalsIgnoreCase( "allsites" )                                            ? "All Sites"        :
( $P{RB_SEARCH_BY_SITES}.equalsIgnoreCase( "sitesinregionordistrict" ) && $P{RB_REGDIST}.isEmpty() ? "In All"           :
( $P{RB_SEARCH_BY_SITES}.equalsIgnoreCase( "singlesite" )                                          ? $P{RB_SCALE_SITE}  :
( $P{RB_SEARCH_BY_SITES}.substring(0,1).equalsIgnoreCase( "A" )                                    ? "Associated Sites" :
( $P{RB_SEARCH_BY_SITES}.substring(0,1).equalsIgnoreCase( "S" )                                    ? "Associated Sites" :
( $P{RB_SEARCH_BY_SITES}.substring(0,1).equalsIgnoreCase( "L" )                                    ? "All Sites"        : "" )))))))]]></variableExpression>
	</variable>
	<variable name="CCF6_show_submitter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{RB_SEARCH_BY_MARKS} == null || $P{RB_SEARCH_BY_MARKS}.isEmpty()
  || $P{RB_SEARCH_BY_MARKS}.equalsIgnoreCase( "all" ) || $P{RB_SEARCH_BY_MARKS}.equalsIgnoreCase( "allsubmitter" ) ? "All Submitters"       :
( $P{RB_SEARCH_BY_MARKS}.equalsIgnoreCase( "creator"      ) ? $P{RB_TRADING_PARTNER} :
( $P{RB_SEARCH_BY_MARKS}.equalsIgnoreCase( "user"         ) ? $P{RB_USER_ID}         :
( $P{RB_SEARCH_BY_MARKS}.equalsIgnoreCase( "submitter"    ) ? $P{RB_TRADING_PARTNER} : "" ))))]]></variableExpression>
	</variable>
	<variable name="CCF7_show_doc_type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{RB_RETURN_TYPE_CODE}.equalsIgnoreCase( "ALL" )
? "All Types"
: ""]]></variableExpression>
	</variable>
	<variable name="CCF8_show_all" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{RB_SEARCH_BY_SITES}.equalsIgnoreCase( "sitesinregionordistrict" ) && $P{RB_REGDIST}.isEmpty()
? "In All"
: ""]]></variableExpression>
	</variable>
