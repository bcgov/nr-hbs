	<variable name="CCF6_Show_CopyToFooter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF(Cstr({#TotalCopiedToStatements},0)='1')THEN
//    'Copied to ' + {HBS3R476.CLIENT_NUMBER_COPY_TO} + ' ' + {HBS3R476.CLIENT_LOCN_CODE_COPY_TO} + ' Total: ' +'  '+ Cstr({#TotalCopiedToStatements},0)+' Statement'
//ELSE
