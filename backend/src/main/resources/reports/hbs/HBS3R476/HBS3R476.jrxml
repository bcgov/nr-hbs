"Copied to " +
( $F{CLIENT_NUMBER_COPY_TO} == null || $F{CLIENT_NUMBER_COPY_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_COPY_TO} ) +
" " +
( $F{CLIENT_LOCN_CODE_COPY_TO} == null || $F{CLIENT_LOCN_CODE_COPY_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_COPY_TO} ) +
" Total:   "+
( $V{TotalCopiedToStatements} == null ? "" : new DecimalFormat("###0").format( $V{TotalCopiedToStatements} ) ) +
" Statement" +
( $V{TotalCopiedToStatements} == null || $V{TotalCopiedToStatements} == 1 ? "" : "s" )]]></variableExpression>
	</variable>
	<variable name="CCF7_Show_SentToFooter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R476.CATEGORY} = 'A' THEN
//        IF(Cstr({#TotalSentToStatements},0)='1')THEN
//            'Sent to ' + {HBS3R476.CLIENT_NUMBER_SEND_TO} + ' ' + {HBS3R476.CLIENT_LOCN_CODE_SEND_TO} + ' Total: '+'  '+Cstr({#TotalSentToStatements},0)+' Statement'
//        ELSE
//            'Sent to ' + {HBS3R476.CLIENT_NUMBER_SEND_TO} + ' ' + {HBS3R476.CLIENT_LOCN_CODE_SEND_TO} + ' Total: '+'  '+Cstr({#TotalSentToStatements},0)+' Statements'
//  ELSE
//         IF(Cstr({#TotalSentToStatements},0)='1')THEN
//            '           ' + 'Sent to ' + {HBS3R476.CLIENT_NUMBER_SEND_TO} + ' ' + {HBS3R476.CLIENT_LOCN_CODE_SEND_TO} + ' Total: '+'  '+Cstr({#TotalSentToStatements},0)+' Statement'
//         ELSE
//            '           ' + 'Sent to ' + {HBS3R476.CLIENT_NUMBER_SEND_TO} + ' ' + {HBS3R476.CLIENT_LOCN_CODE_SEND_TO} + ' Total: '+'  '+Cstr({#TotalSentToStatements},0)+' Statements'


( $F{CATEGORY}.equalsIgnoreCase( "A" ) ? "" : "           " ) +
"Sent to " +
( $F{CLIENT_NUMBER_SEND_TO} == null || $F{CLIENT_NUMBER_SEND_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_SEND_TO} ) +
" " +
( $F{CLIENT_LOCN_CODE_SEND_TO} == null || $F{CLIENT_LOCN_CODE_SEND_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_SEND_TO} ) +
" Total:   "+
( $V{TotalSentToStatements} == null ? "" : new DecimalFormat("###0").format( $V{TotalSentToStatements} ) ) +
" Statement" +
( $V{TotalSentToStatements} == null || $V{TotalSentToStatements} == 1 ? "" : "s" )]]></variableExpression>
