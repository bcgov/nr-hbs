	<variable name="CCF0_Show_CopyToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// If this is the first copied to section for the client (i.e. we have jsut finished printing his billed to section)
//// of this is a completely new client then print the copied heading again
//if pagenumber = 1 AND {HBS3R476.CATEGORY} <> 'A' then
//    'Statements Copied to: ' + left({HBS3R476.CLIENTPC}, 8) + ' ' + right({HBS3R476.CLIENTPC}, 2) + '   ' + {HBS3R476.CLIENT_NAME}
//
//ELSE IF (({HBS3R476.CATEGORY} = "B") AND (Previous ({HBS3R476.CATEGORY}) = "A"))
//  OR ({HBS3R476.CLIENTPC} <> Previous({HBS3R476.CLIENTPC}) and ({HBS3R476.CATEGORY} = "B")) THEN
//       'Statements Copied to: ' + left({HBS3R476.CLIENTPC}, 8) + ' ' + right({HBS3R476.CLIENTPC}, 2) + '   ' + {HBS3R476.CLIENT_NAME}
//
//ELSE
// '';

( $V{PAGE_COUNT} == 1 && !($F{CATEGORY}.equalsIgnoreCase( "A" ))
? "Statements Copied to: " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : "" ) +
  " " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : "" ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )
: ( ($F{CATEGORY}.equalsIgnoreCase( "B" ) && $V{v_previous_CATEGORY}.equalsIgnoreCase( "A" )) ||
    ($F{CATEGORY}.equalsIgnoreCase( "B" ) && !($V{v_current_CLIENTPC}.equalsIgnoreCase( $V{v_previous_CLIENTPC} )))
  ? "Statements Copied to: " +
    ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : "" ) +
    " " +
    ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : "" ) +
    "   " +
    ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )
  : ""
  )
)]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_BilledToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If {HBS3R476.CATEGORY} = 'A' THEN
//     'Statements Sent to: ' + left({HBS3R476.CLIENTPC}, 8) + ' ' + right({HBS3R476.CLIENTPC}, 2) + '   ' + {HBS3R476.CLIENT_NAME}
//ELSE
// ''

( $F{CATEGORY}.equalsIgnoreCase( "A" )
? "Statements Sent to: " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : "" ) +
  " " +
  ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : "" ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )
: ""
)]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_PopStratYr" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ? "" : $F{POPULATION_NUMBER} ) +
( $F{STRATUM_NUMBER}    == null || $F{STRATUM_NUMBER}.isEmpty()    ? "" : "/" + $F{STRATUM_NUMBER} ) +
( $F{SAMPLING_YEAR}     == null                                    ? "" : "/" + new DecimalFormat("###0").format( $F{SAMPLING_YEAR} )  )]]></variableExpression>
	</variable>
