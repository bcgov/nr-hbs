	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? "repo:" : "H:\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       STD.LOGDTL_ID
     , STD.DETAIL_DOCUMENT_NUMBER
     , STD.VERSION
     , STD.SCALE_SPECIES_CODE
     , STD.SCALE_GRADE_CODE
     , STD.SCALE_PRODUCT_CODE
     , STD.DTLSEG_ID
     , STD.LOG_NUMBER
     , STD.LENGTH
     , STD.TOP
     , STD.BUTT
     , STD.NET_VOLUME
     , STD.NMV_IND
     , STD.DEDUCTION_COUNT
     , STD.INPUT_SPECIES
     , STD.INPUT_GRADE
     , STD.ENTRY_USERID
     , STD.ENTRY_TIMESTAMP
     , STD.UPDATE_USERID
     , STD.UPDATE_TIMESTAMP
     , STDD.LOG_DEFECT_ID
     , STDD.DEFECT_NUMBER
     , STDD.DEFECT_TYPE
     , STDD.VOLUME
     , STDD.DESCRIPTOR
FROM   SAMPLE_TALLY_DETAIL        STD
JOIN   SAMPLE_TALLY_DETAIL_DEFECT STDD ON STDD.LOGDTL_ID = STD.LOGDTL_ID
WHERE  STD.DETAIL_DOCUMENT_NUMBER = $P{Pm-?SSRETURN_DETAILDOCUMENTNUMBER}
AND    STD.VERSION                = $P{Pm-?SSRETURN_VERSIONNUMBER}
ORDER BY STD.LOG_NUMBER
       , STDD.DEFECT_NUMBER]]>
	</queryString>
