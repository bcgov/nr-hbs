	<variable name="CCF8_Show_PopStratYear" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field

//IF (ISNULL({HBS2R652.POPULATION_NUMBER}) OR  ISNULL({HBS2R652.STRATUM_NUMBER}) OR ISNULL({HBS2R652.SAMPLING_YEAR})) THEN
// '* ' + {HBS2R652.INPUT_PSY}
//ELSE
// {HBS2R652.POPULATION_NUMBER} + '-' + {HBS2R652.STRATUM_NUMBER} + '-' + cStr({HBS2R652.SAMPLING_YEAR}, 0, '')


$F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ||
$F{STRATUM_NUMBER} == null || $F{STRATUM_NUMBER}.isEmpty() ||
$F{SAMPLING_YEAR} == null
?
    ($F{INPUT_PSY}!=null ? "* " + $F{INPUT_PSY} : "")
:
    $F{POPULATION_NUMBER} + "-" + $F{STRATUM_NUMBER} + "-" + $F{SAMPLING_YEAR}]]></variableExpression>
	</variable>
