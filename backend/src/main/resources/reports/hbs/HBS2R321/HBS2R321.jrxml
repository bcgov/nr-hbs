	<variable name="CCF0_strScale_Type_Heading" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS2R321.HBS_RETURN_TYPE_CODE} = 'P' THEN
// 'Piece Scale'
//ELSE IF {HBS2R321.HBS_RETURN_TYPE_CODE} = 'W' THEN
// 'Weight Scale'
//ELSE IF {HBS2R321.HBS_RETURN_TYPE_CODE} = 'S' THEN
// 'Sample Scale'
//ELSE
// ' unknown scale type'



 ( $F{HBS_RETURN_TYPE_CODE} == null || $F{HBS_RETURN_TYPE_CODE}.isEmpty()
  ? " unknown scale type"
  :
  ( $F{HBS_RETURN_TYPE_CODE}.equalsIgnoreCase( "P" ) ? "Piece Scale"     :
  ( $F{HBS_RETURN_TYPE_CODE}.equalsIgnoreCase( "W" ) ? "Weight Scale"    :
  ( $F{HBS_RETURN_TYPE_CODE}.equalsIgnoreCase( "S" ) ? "Sample Scale"    :
                                                          " unknown scale type"
  )))
)]]></variableExpression>
	</variable>
	<variable name="CCF2_strSubType" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {HBS2R321.DOC_TYPE} = 'S' then
//    'Summary'
//else
//    'Detail'



$F{DOC_TYPE} != null && !($F{DOC_TYPE}.isEmpty()) && $F{DOC_TYPE}.equalsIgnoreCase( "S" )
? "Summary"
: "Detail"]]></variableExpression>
	</variable>
	<variable name="CCF3_Crop_Client_name" class="java.lang.String">
		<variableExpression><![CDATA[$F{CLIENT_NAME} != null && !($F{CLIENT_NAME}.isEmpty())
? (
    $F{CLIENT_NAME}.length()>= 40
    ?   $F{CLIENT_NAME}.substring(0,40)
    :   $F{CLIENT_NAME}
    )

: ""]]></variableExpression>
	</variable>
