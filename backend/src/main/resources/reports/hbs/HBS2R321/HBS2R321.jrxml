	<queryString language="plsql">
		<![CDATA[{call HBS2R321(
RB_CURSOR => $P{ORACLE_REF_CURSOR},
RB_SELECTCOUNT => $P{RB_SELECTCOUNT},
RB_CLIENT_NUMBER => $P{RB_CLIENT_NUMBER},
RB_CLIENT_LOCN_CODE => $P{RB_CLIENT_LOCN_CODE},
RB_SCALE_SITE_ID_NMBR => $P{RB_SCALE_SITE_ID_NMBR},
RB_JOBNO => $P{RB_JOBNO}
)}]]>
	</queryString>
	<field name="TPS_ID" class="java.math.BigDecimal"/>
