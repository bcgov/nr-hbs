	<queryString language="plsql">
		<![CDATA[{call HBS3R036(
RB_CURSOR => $P{ORACLE_REF_CURSOR},
RB_CLIENT_NUMBER => $P{RB_CLIENT_NUMBER},
RB_CLIENT_NAME => $P{RB_CLIENT_NAME},
RB_CLIENT_LOC_CODE => $P{RB_CLIENT_LOC_CODE},
RB_RECIPIENT_TYPE => $P{RB_RECIPIENT_TYPE},
RB_FROM_DATE => $P{RB_FROM_DATE},
RB_TO_DATE => $P{RB_TO_DATE},
RB_CLI_LOC_OPTION => $P{RB_CLI_LOC_OPTION},
RB_USERID => $P{RB_USERID},
RB_JOBNO => $P{RB_JOBNO}
)}]]>
	</queryString>
