	<variable name="CCF0_Show_Client_Name" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{?RB_CLIENT_NUMBER}+' - '+{?RB_CLIENT_NAME}

($P{RB_CLIENT_NUMBER} == null || $P{RB_CLIENT_NUMBER}.isEmpty()? "" : $P{RB_CLIENT_NUMBER}) + " - " +
($P{RB_CLIENT_NAME} == null || $P{RB_CLIENT_NAME}.isEmpty()? "" :  $P{RB_CLIENT_NAME} )]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_Client_Location" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?RB_CLI_LOC_OPTION} = 'A' then
//    'Associated Locations'
//else if {?RB_CLI_LOC_OPTION} = 'S' then
//    {?RB_CLIENT_LOC_CODE}
//else
//    'All Locations';

$P{RB_CLI_LOC_OPTION}.equalsIgnoreCase( "A" )? "Associated Locations" :
$P{RB_CLI_LOC_OPTION}.equalsIgnoreCase( "S" )? $P{RB_CLIENT_LOC_CODE}: "All Locations"]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_From_Date" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Date({?RB_FROM_DATE})
($P{RB_FROM_DATE} == null || $P{RB_FROM_DATE}.isEmpty()) ? "" :
new SimpleDateFormat("yyyy-MM-dd").format(new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_FROM_DATE}))]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_To_Date" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Date({?RB_TO_DATE})
($P{RB_TO_DATE} == null || $P{RB_TO_DATE}.isEmpty()) ? "" :
new SimpleDateFormat("yyyy-MM-dd").format(new SimpleDateFormat("yyyy-MM-dd").parse($P{RB_TO_DATE}))]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_Recipient_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?RB_RECIPIENT_TYPE} = 'COPY_TO' then
//    'Copy To'
//else if {?RB_RECIPIENT_TYPE} = 'SEND_TO' then
//    'Send To'
//else
//    'Both';

$P{RB_RECIPIENT_TYPE}.equalsIgnoreCase( "COPY_TO" )? "Copy To" :
$P{RB_RECIPIENT_TYPE}.equalsIgnoreCase( "SEND_TO" )? "Send To" :
"Both"]]></variableExpression>
	</variable>
	<group name="Location_Method_Group">
		<groupExpression><![CDATA[$F{CLIENT_LOCN_CODE} + " - " + $F{DESCRIPTION}]]></groupExpression>
	</group>
