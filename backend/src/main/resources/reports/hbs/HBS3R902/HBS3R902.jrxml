	<variable name="CCF0_calcDaysLate" class="java.lang.Long" resetType="None">
		<variableExpression><![CDATA[//DateDiff ("d", {HBS3R902.DUE_DATE},{HBS3R902.DATE_RECEIVED} )
//Datediff function equivalent does not exist in java
//solution


$F{DUE_DATE} == null || $F{DATE_RECEIVED} == null
? null
:   java.util.concurrent.TimeUnit.MILLISECONDS.toDays($F{DATE_RECEIVED}.getTime()) - java.util.concurrent.TimeUnit.MILLISECONDS.toDays($F{DUE_DATE}.getTime())]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_ScaledOnAfter" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//Date(left( {?PLLS_SCALEDONAFTER}, 10))

( $P{PLLS_SCALEDONAFTER} == null || $P{PLLS_SCALEDONAFTER}.isEmpty()
  ? null
  : ( $P{PLLS_SCALEDONAFTER}.length() >= 10
      ? new SimpleDateFormat("yyyy-MM-dd").parse(   $P{PLLS_SCALEDONAFTER}.substring( 0, 10 )   )
      : null
     )
)]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_ScaledOnBefore" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//Date(left( {?PLLS_SCALEDONBEFORE}, 10))

( $P{PLLS_SCALEDONBEFORE} == null || $P{PLLS_SCALEDONBEFORE}.isEmpty()
  ? null
  : ( $P{PLLS_SCALEDONBEFORE}.length() >= 10
      ? new SimpleDateFormat("yyyy-MM-dd").parse(   $P{PLLS_SCALEDONBEFORE}.substring( 0, 10 )   )
      : null
     )
)]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_returntype" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({?PLLS_RADRETURNTYPE}) = 'P' THEN 'Log Tallies'
//ELSE IF ({?PLLS_RADRETURNTYPE}) = 'W' THEN 'Weigh Slips'
//ELSE IF ({?PLLS_RADRETURNTYPE}) = 'S' THEN 'Sample Tallies'
//ELSE IF ({?PLLS_RADRETURNTYPE}) = 'all' THEN 'All'


$P{PLLS_RADRETURNTYPE}!=null
?
    $P{PLLS_RADRETURNTYPE}.equalsIgnoreCase( "P" ) ? "Log Tallies" :
    $P{PLLS_RADRETURNTYPE}.equalsIgnoreCase( "W" ) ? "Weigh Slips" :
    $P{PLLS_RADRETURNTYPE}.equalsIgnoreCase( "S" ) ? "Sample Tallies" :
    $P{PLLS_RADRETURNTYPE}.equalsIgnoreCase( "all" ) ? "All" : ""

:   ""]]></variableExpression>
	</variable>
	<variable name="CCF6_Show_Scalesite" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({?PLLS_SEARCHBYSITES}) = 'allsites' THEN 'All Sites'
//ELSE IF({?PLLS_SEARCHBYSITES}) = 'singlesite' THEN {?PLLS_SCALESITE}
//ELSE IF({?PLLS_SEARCHBYSITES}) = 'associatedsites' THEN 'Associated Sites'
//ELSE IF({?PLLS_SEARCHBYSITES}) = 'sitesinassociateddistricts' then 'Associated Sites'

$P{PLLS_SEARCHBYSITES}!=null
?
    $P{PLLS_SEARCHBYSITES}.equalsIgnoreCase( "allsites" ) ? "ALL Sites" :
    $P{PLLS_SEARCHBYSITES}.equalsIgnoreCase( "singlesite" ) ? ( $P{PLLS_SCALESITE} == null || $P{PLLS_SCALESITE}.isEmpty() ? "" : $P{PLLS_SCALESITE} ) :
    $P{PLLS_SEARCHBYSITES}.equalsIgnoreCase( "associatedsites" ) ? "Associated Sites" :
    $P{PLLS_SEARCHBYSITES}.equalsIgnoreCase( "sitesinassociateddistricts" ) ? "Associated Sites" : ""

: ""]]></variableExpression>
	</variable>
	<variable name="CCF7_Show_Return_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF({HBS3R902.DOC_TYPE}) = 'P' THEN
//'LT'
//ELSE IF ({HBS3R902.DOC_TYPE}) = 'W' THEN
//'WS'
//ELSE IF ({HBS3R902.DOC_TYPE}) = 'S' THEN
//'ST'

$F{DOC_TYPE}!=null
?
    $F{DOC_TYPE}.equalsIgnoreCase( "P" )? "LT" :
    $F{DOC_TYPE}.equalsIgnoreCase( "W" )? "WS" :
    $F{DOC_TYPE}.equalsIgnoreCase( "S" )? "ST" : ""
:
""]]></variableExpression>
	</variable>
	<variable name="CCF8_Show_PopStratYear" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R902.DOC_TYPE}='W' THEN
//    IF({HBS3R902.EVENT_TYPE_CODE}='RT' OR {HBS3R902.EVENT_TYPE_CODE}='RR'
//      OR {HBS3R902.EVENT_TYPE_CODE}='4R' OR {HBS3R902.EVENT_TYPE_CODE}='DP') THEN
//    {HBS3R902.COMPANY_USE_STRATUM}
//    ELSE
//    IF ISNULL({HBS3R902.POPULATION_NUMBER})AND ISNULL({HBS3R902.COMPANY_USE_STRATUM}) THEN
//    '* ' + {HBS3R902.INPUT_PSY}
//    ELSE IF NOT (ISNULL({HBS3R902.COMPANY_USE_STRATUM})) THEN
//        {HBS3R902.COMPANY_USE_STRATUM}
//ELSE
// {HBS3R902.POPULATION_NUMBER} + "/" + {HBS3R902.STRATUM_NUMBER} + "/" + totext({HBS3R902.SAMPLING_YEAR},0,'')
//ELSE
//IF ISNULL({HBS3R902.POPULATION_NUMBER})AND ISNULL({HBS3R902.COMPANY_USE_STRATUM}) THEN
// '* ' + {HBS3R902.INPUT_PSY}
//ELSE IF NOT (ISNULL({HBS3R902.COMPANY_USE_STRATUM})) THEN
//    {HBS3R902.COMPANY_USE_STRATUM}
//ELSE
//{HBS3R902.POPULATION_NUMBER} + "/" + {HBS3R902.STRATUM_NUMBER} + "/" + totext({HBS3R902.SAMPLING_YEAR},0,'')


( $F{DOC_TYPE} != null && !($F{DOC_TYPE}.isEmpty()) && $F{DOC_TYPE}.equalsIgnoreCase( "W" )
?
    ( $F{EVENT_TYPE_CODE} != null && !($F{EVENT_TYPE_CODE}.isEmpty()) &&
      ( $F{EVENT_TYPE_CODE}.equalsIgnoreCase( "RT" ) || $F{EVENT_TYPE_CODE}.equalsIgnoreCase( "RR" ) ||
        $F{EVENT_TYPE_CODE}.equalsIgnoreCase( "4R" ) || $F{EVENT_TYPE_CODE}.equalsIgnoreCase( "DP" ) )
    ? ( $F{COMPANY_USE_STRATUM} == null || $F{COMPANY_USE_STRATUM}.isEmpty() ? "" : $F{COMPANY_USE_STRATUM} )
    : ( ($F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ) && ($F{COMPANY_USE_STRATUM} == null || $F{COMPANY_USE_STRATUM}.isEmpty() )
      ? "* " + ( $F{INPUT_PSY} == null || $F{INPUT_PSY}.isEmpty() ? "" : $F{INPUT_PSY} )
      : ( $F{COMPANY_USE_STRATUM} != null && !($F{COMPANY_USE_STRATUM}.isEmpty())
        ? $F{COMPANY_USE_STRATUM}
        : ( $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ? "" : $F{POPULATION_NUMBER} ) + "/" +
          ( $F{STRATUM_NUMBER} == null || $F{STRATUM_NUMBER}.isEmpty() ? "" : $F{STRATUM_NUMBER} ) + "/" +
          ( $F{SAMPLING_YEAR} == null ? "" : new DecimalFormat("###0").format( $F{SAMPLING_YEAR} ) )
        )
      )
    )
:
    ( ($F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ) && ($F{COMPANY_USE_STRATUM} == null || $F{COMPANY_USE_STRATUM}.isEmpty() )
    ? "* " + ( $F{INPUT_PSY} == null || $F{INPUT_PSY}.isEmpty() ? "" : $F{INPUT_PSY} )
    :  ( $F{COMPANY_USE_STRATUM} != null && !($F{COMPANY_USE_STRATUM}.isEmpty())
       ? $F{COMPANY_USE_STRATUM}
       : ( $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ? "" : $F{POPULATION_NUMBER} ) + "/" +
         ( $F{STRATUM_NUMBER} == null || $F{STRATUM_NUMBER}.isEmpty() ? "" : $F{STRATUM_NUMBER} ) + "/" +
         ( $F{SAMPLING_YEAR} == null ? "" : new DecimalFormat("###0").format( $F{SAMPLING_YEAR} ) )
       )
    )
)]]></variableExpression>
	</variable>
