	<variable name="CCF7_show_mark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF{?PSR_SEARCHBYMARKS}='allmarks' THEN                              'Timber Marks:'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinaregionordistrict' then      'Timber Marks:'
//ELSE IF {?PSR_SEARCHBYMARKS}='singlemark' AND {?PSR_CUTBLOCK} <> '' then  'Timber Mark - Cut Block:'
//ELSE IF {?PSR_SEARCHBYMARKS}='singlemark' then                    'Timber Mark:'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinassociateddistricts' then    'Timber Marks:'
//ELSE IF{?PSR_SEARCHBYMARKS}='allsubmitter' THEN                   'Submitters:'
//ELSE IF {?PSR_SEARCHBYMARKS}='creator' then                       'Submitters:'
//ELSE IF {?PSR_SEARCHBYMARKS}='user' then                          'Submitters:'

$P{PSR_SEARCHBYMARKS}!=null
?
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks" ) ? "Timber Marks:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinaregionordistrict" ) ? "Timber Marks:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark" ) && $P{PSR_CUTBLOCK}!=null && !$P{PSR_CUTBLOCK}.isEmpty()? "Timber Mark - Cut Block:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark" ) ? "Timber Mark:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinassociateddistricts" ) ? "Timber Mark:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allsubmitter" )  ? "Submitters:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "creator" ) ? "Submitters:" :
    $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "user" ) ? "Submitters:" : ""

: "NULL FOUND"]]></variableExpression>
	</variable>
	<variable name="CCF8_Show_FSDeckId" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//BT 10014
