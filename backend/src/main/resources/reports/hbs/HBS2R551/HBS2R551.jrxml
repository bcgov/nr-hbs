$P{PSR_LICENCENUMBER}==null || $P{PSR_LICENCENUMBER}.equalsIgnoreCase( "$" ) ? "" : $P{PSR_LICENCENUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF14_Show_Version_Title" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF (isnull({?PSR_ACTIVEVERSIONINDICATOR}) or UpperCase({?PSR_ACTIVEVERSIONINDICATOR})<>'Y' ) THEN
//'List of Log Tallies - All Versions'
//ELSE IF(UpperCase({?PSR_ACTIVEVERSIONINDICATOR})='Y' ) THEN
//'List of Log Tallies - Current Versions'


$P{PSR_ACTIVEVERSIONINDICATOR}==null || !$P{PSR_ACTIVEVERSIONINDICATOR}.equalsIgnoreCase( "Y" )
?
    "List of Log Tallies - All Versions"
:
    $P{PSR_ACTIVEVERSIONINDICATOR}.equalsIgnoreCase( "Y" ) ? "List of Log Tallies - Current Versions" : ""]]></variableExpression>
	</variable>
	<variable name="CCF15_Show_ReturnFromNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?PSR_SEARCHBYRANGE} = 'returnNumber' or {?PSR_SEARCHBYRANGE} = 'loadNumber' or {?PSR_SEARCHBYRANGE} = 'weighSlip'  then
//    {?PSR_NUMBERRANGEFROM}
//else if {?PSR_SEARCHBYRANGE} = 'transId' then
//    {?PSR_TRANSPORTID}
//else if {?PSR_SEARCHBYRANGE} = 'ldsNumber' then
//    {?PSR_LDSNUMBER}
//else
//    {?PSR_RETURNNUMBER}

$P{PSR_SEARCHBYRANGE}!=null
?
    ($P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "returnNumber" ) ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "loadNumber" ) ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "weighSlip" ) ? $P{PSR_NUMBERRANGEFROM} :
    ($P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "transId" ) ? $P{PSR_TRANSPORTID} :
    ($P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "ldsNumber" ) ? $P{PSR_LDSNUMBER} :  $P{PSR_RETURNNUMBER}
    )))
:
    $P{PSR_RETURNNUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF16_Show_ReturnToNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?PSR_SEARCHBYRANGE} = 'returnNumber' or {?PSR_SEARCHBYRANGE} = 'loadNumber' or {?PSR_SEARCHBYRANGE} = 'weighSlip') and {?PSR_NUMBERRANGETO} <> '' then
//    {?PSR_NUMBERRANGETO}
//else
//    ''



$P{PSR_SEARCHBYRANGE}!=null && $P{PSR_NUMBERRANGETO}!=null && !$P{PSR_NUMBERRANGETO}.isEmpty()
?
    ($P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "returnNumber" ) ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "loadNumber" ) ||
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "weighSlip" ) ? $P{PSR_NUMBERRANGETO} :  ""
    )
:
    ""]]></variableExpression>
	</variable>
	<variable name="CCF17_Show_Range_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?PSR_SEARCHBYRANGE} = 'loadNumber' then
//    'Load Number: '
//else if {?PSR_SEARCHBYRANGE} = 'weighSlip' then
//    'Weigh Slip: '
//else if {?PSR_SEARCHBYRANGE} = 'transId' then
//    'Transport ID: '
//else if {?PSR_SEARCHBYRANGE} = 'ldsNumber' then
//    'LDS Number: '
//else
//    'Return Number: '

$P{PSR_SEARCHBYRANGE}!=null
?
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "loadNumber" ) ? "Load Number: " :
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "weighSlip" ) ? "Weigh Slip: " :
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "transId" ) ? "Transport ID: " :
    $P{PSR_SEARCHBYRANGE}.equalsIgnoreCase( "ldsNumber" ) ? "LDS Number: " : "Return Number: "
:
    "Return Number: "]]></variableExpression>
	</variable>
	<variable name="CCF18_Show_ReceivedDateFrom" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if  {?PSR_RECEIVEDDATEFROM} <> '' then
//    {?PSR_RECEIVEDDATEFROM}
//else
//    {?PSR_INPUTBATCHDATEFROM}

$P{PSR_RECEIVEDDATEFROM}!=null && !$P{PSR_RECEIVEDDATEFROM}.isEmpty()
?
    $P{PSR_RECEIVEDDATEFROM}
:
    $P{PSR_INPUTBATCHDATEFROM}]]></variableExpression>
	</variable>
	<variable name="CCF19_Show_ReceivedDateTo" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?PSR_RECEIVEDDATETO} <> '' then
//    {?PSR_RECEIVEDDATETO}
//else
//    {?PSR_INPUTBATCHDATETO}


$P{PSR_RECEIVEDDATETO}!=null && !$P{PSR_RECEIVEDDATETO}.isEmpty()
?
    $P{PSR_RECEIVEDDATETO}
:
    $P{PSR_INPUTBATCHDATETO}]]></variableExpression>
	</variable>
