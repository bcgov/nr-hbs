	<queryString language="plsql">
		<![CDATA[{call HBS3R490(
PCURSOR => $P{ORACLE_REF_CURSOR},
PTIMBERMARK => $P{PTIMBERMARK},
PLICENSE => $P{PLICENSE},
PCLIENTNUM => $P{PCLIENTNUM},
PCLIENTLOC => $P{PCLIENTLOC},
PEXPDATE => $P{PEXPDATE},
PJOBNO => $P{PJOBNO}
)}]]>
	</queryString>
