	<field name="MAX_BILLED_DATE" class="java.sql.Timestamp"/>
	<field name="MIN_BILLED_DATE" class="java.sql.Timestamp"/>
	<field name="APPRAISAL_VOLUME" class="java.math.BigDecimal"/>
	<sortField name="CCF0_clientLocation" type="Variable"/>
	<sortField name="LICENSE"/>
	<sortField name="TIMBER_MARK"/>
	<variable name="Sum (HBS3R490.APPRAISAL_VOLUME)" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{APPRAISAL_VOLUME}]]></variableExpression>
	</variable>
	<variable name="Sum (HBS3R490.APPRAISAL_VOLUME, HBS3R490.TIMBER_MARK)" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 3" calculation="Sum">
		<variableExpression><![CDATA[$F{APPRAISAL_VOLUME}]]></variableExpression>
	</variable>
	<variable name="Sum (HBS3R490.BILLED_VOLUME, HBS3R490.TIMBER_MARK)" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 3" calculation="Sum">
		<variableExpression><![CDATA[$F{BILLED_VOLUME}]]></variableExpression>
	</variable>
	<variable name="Sum (HBS3R490.BILLED_VOLUME)" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{BILLED_VOLUME}]]></variableExpression>
	</variable>
	<variable name="CCF0_clientLocation" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R490.CLIENT_NUMBER} + ' ' + {HBS3R490.CLIENT_LOCN_CODE}


($F{CLIENT_NUMBER} == null || $F{CLIENT_NUMBER}.isEmpty()
    ? "no_CN" : $F{CLIENT_NUMBER} + " "
)
+
($F{CLIENT_LOCN_CODE}  == null || $F{CLIENT_LOCN_CODE}.isEmpty()
    ? "no_CLC" : $F{CLIENT_LOCN_CODE}
)]]></variableExpression>
	</variable>
	<variable name="CCF1_fileTypeDescr" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R490.FILE_TYPE_CODE} + ' - ' + {HBS3R490.FILE_TYPE_DESCR}


($F{FILE_TYPE_CODE} == null || $F{FILE_TYPE_CODE} .isEmpty()
    ? "" : $F{FILE_TYPE_CODE}
)
+ " - " +
($F{FILE_TYPE_DESCR} == null || $F{FILE_TYPE_DESCR}.isEmpty()
    ? "" : $F{FILE_TYPE_DESCR}
)]]></variableExpression>
	</variable>
	<variable name="CCF2_BilledDivCruised" class="java.lang.Number" resetType="None">
		<variableExpression><![CDATA[//IF ({HBS3R490.APPRAISAL_VOLUME} <> 0) AND ({HBS3R490.BILLED_VOLUME} <> 0) THEN
//  {HBS3R490.BILLED_VOLUME} % {HBS3R490.APPRAISAL_VOLUME}
//ELSE
//  0


($F{APPRAISAL_VOLUME}!=null && $F{APPRAISAL_VOLUME}.intValue()!=0)
&&
($F{BILLED_VOLUME}!=null && $F{BILLED_VOLUME}.intValue()!=0)
?
   $F{BILLED_VOLUME}.floatValue() / $F{APPRAISAL_VOLUME}.floatValue()
:
    0]]></variableExpression>
	</variable>
	<variable name="CCF3_SubTotBilledDivCruised" class="java.lang.Number" resetType="None">
		<variableExpression><![CDATA[//IF (Sum ({HBS3R490.APPRAISAL_VOLUME}, {HBS3R490.TIMBER_MARK}) <> 0) AND (Sum ({HBS3R490.BILLED_VOLUME}, {HBS3R490.TIMBER_MARK}) <> 0) THEN
//  Sum ({HBS3R490.BILLED_VOLUME}, {HBS3R490.TIMBER_MARK}) % Sum ({HBS3R490.APPRAISAL_VOLUME}, {HBS3R490.TIMBER_MARK})
//ELSE
// 0

$V{Sum (HBS3R490.APPRAISAL_VOLUME, HBS3R490.TIMBER_MARK)}!=null && $V{Sum (HBS3R490.APPRAISAL_VOLUME, HBS3R490.TIMBER_MARK)}.intValue() !=0
&&
$V{Sum (HBS3R490.BILLED_VOLUME, HBS3R490.TIMBER_MARK)}!=null && $V{Sum (HBS3R490.BILLED_VOLUME, HBS3R490.TIMBER_MARK)}.intValue() !=0
?
    $V{Sum (HBS3R490.BILLED_VOLUME, HBS3R490.TIMBER_MARK)}.floatValue() / $V{Sum (HBS3R490.APPRAISAL_VOLUME, HBS3R490.TIMBER_MARK)}.floatValue()
:
    0]]></variableExpression>
	</variable>
	<variable name="CCF4_TotalBilledDivCruised" class="java.lang.Number" resetType="None">
		<variableExpression><![CDATA[//IF (Sum ({HBS3R490.APPRAISAL_VOLUME}) <> 0) AND (Sum ({HBS3R490.BILLED_VOLUME}) <> 0) THEN
//  Sum ({HBS3R490.BILLED_VOLUME}) % Sum ({HBS3R490.APPRAISAL_VOLUME})
//ELSE
// 0



$V{Sum (HBS3R490.APPRAISAL_VOLUME)}!=null && $V{Sum (HBS3R490.APPRAISAL_VOLUME)}.intValue()!=0
&&
$V{Sum (HBS3R490.BILLED_VOLUME)}!=null && $V{Sum (HBS3R490.BILLED_VOLUME)}.intValue() !=0
?
    $V{Sum (HBS3R490.BILLED_VOLUME)}.floatValue() / $V{Sum (HBS3R490.APPRAISAL_VOLUME)}.floatValue()
:
    0]]></variableExpression>
	</variable>
	<variable name="CCF5_dateFormat" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//IF not isnull({?PEXPDATE}) and ({?PEXPDATE} <> '')then
//Date({?PEXPDATE})

$P{PEXPDATE} == null || $P{PEXPDATE}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{PEXPDATE})]]></variableExpression>
	</variable>
