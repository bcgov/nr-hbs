	</variable>
	<variable name="BilledToTotalVolume" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_VOLUME}]]></variableExpression>
	</variable>
	<variable name="BilledToTotalValue" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Sum">
