($F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( "A" ) ? "Sent to " : "            " ) +
$F{CLIENT_NUMBER_PAID_BY} + " " + $F{CLIENT_LOCN_CODE_PAID_BY} + " Total: " + " "+ $V{TotalSentToInvoices}.toString() +
($P{RB_TYPE}!=null && $P{RB_TYPE}.equalsIgnoreCase( "PSI" ) ? " Invoice" : " Statement" ) +
($V{TotalSentToInvoices}==1 ? "" : "s" )]]></variableExpression>
