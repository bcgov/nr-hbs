	<variable name="Sum (HBS3R451.TOTAL_VOLUME)" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_VOLUME}]]></variableExpression>
	</variable>
	<variable name="Sum (HBS3R451.TOTAL_VALUE)" class="java.math.BigDecimal" calculation="Sum">
