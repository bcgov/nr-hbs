	<variable name="CCF0_CCF1_string" class="java.lang.String">
		<variableExpression><![CDATA[//left({HBS3R461.CLIENTPC}, 8) + ' ' + right({HBS3R461.CLIENTPC}, 2) + '   ' + {HBS3R461.CLIENT_NAME}


($F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty())
?
    $F{CLIENTPC}.length()>= 8 ?   $F{CLIENTPC}.substring(0,8) : $F{CLIENTPC}
:
    "" )

+ " " +

($F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty())
?
    $F{CLIENTPC}.length()>= 2 ?   $F{CLIENTPC}.substring($F{CLIENTPC}.length()-2,$F{CLIENTPC}.length()): $F{CLIENTPC}
:
    "")

+ " " +

$F{CLIENT_NAME}!=null ? $F{CLIENT_NAME} : ""]]></variableExpression>
	</variable>
	<variable name="CCF0_main_string" class="java.lang.String">
		<variableExpression><![CDATA[//IF ({?RB_TYPE} = "PSI") THEN
//(  copytoMsg := "Invoices Copied to: " + left({HBS3R461.CLIENTPC}, 8) + " " + right({HBS3R461.CLIENTPC}, 2) + "   " + {HBS3R461.CLIENT_NAME})
//ELSE
//(  copytoMsg := "Volume Statements Copied to: " + left({HBS3R461.CLIENTPC}, 8) + " " + right({HBS3R461.CLIENTPC}, 2) + '   ' + {HBS3R461.CLIENT_NAME});


$P{RB_TYPE}!=null && $P{RB_TYPE}.equalsIgnoreCase( "PSI" )
?
    "Invoices Copied to: " + $V{CCF0_CCF1_string}
:
    "Volume Statements Copied to: " + $V{CCF0_CCF1_string}]]></variableExpression>
	</variable>
	<variable name="CCF0_Show_CopyToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// determine whether to show the 'invoice copied to' or 'vol stmnt copied to' message then
// determine whether this is a correct group header situation to show the copied to message
//stringVar copytoMsg := '';
//IF ({?RB_TYPE} = "PSI") THEN
//(  copytoMsg := "Invoices Copied to: " + left({HBS3R451.CLIENTPC}, 8) + " " + right({HBS3R451.CLIENTPC}, 2) + "   " + {HBS3R451.CLIENT_NAME})
//ELSE
//(copytoMsg := "Volume Statements Copied to: " + left({HBS3R451.CLIENTPC}, 8) + " " + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME});
//IF (OnFirstRecord and {HBS3R451.CATEGORY} = "B") THEN
//   copytoMsg
//ELSE IF ({HBS3R451.CATEGORY} = "B" AND Previous({HBS3R451.CATEGORY}) = "A") THEN
//   copytoMsg
//ELSE IF (({HBS3R451.CATEGORY} = "B") AND ({HBS3R451.CLIENTPC} <> Previous({HBS3R451.CLIENTPC}))) THEN
//   copytoMsg
//ELSE ""


($V{REPORT_COUNT}==1 && $F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( "B" ) ) ||
($F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( "B" ) && $V{CCF0_PREV_CAT}!=null && $V{CCF0_PREV_CAT}.equalsIgnoreCase( "A" ) ) ||
($F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( "B" ) && $F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( $F{CLIENTPC} ))
?
    $V{CCF0_main_string}
:
    ""]]></variableExpression>
	</variable>
	<variable name="CCF0_PREV_CAT" class="java.lang.String">
		<variableExpression><![CDATA[//must be the last occurence in list of CCF0's
$F{CATEGORY}]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_BilledToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R451.CATEGORY} = 'A' then
//  IF {?RB_TYPE} = 'PSI' THEN
//    'Invoices Sent to: ' + left({HBS3R451.CLIENTPC}, 8) + ' ' + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//  ELSE
//    'Volume Statements Sent to: ' + left({HBS3R451.CLIENTPC}, 8) + ' ' + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//ELSE
// ''


$F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( "A" )
?
    $P{RB_TYPE}!=null && $P{RB_TYPE}.equalsIgnoreCase( "PSI" )
    ?
        "Invoices Sent to: " + $V{CCF0_CCF1_string}
    :
        "Volume Statements Sent to: " + $V{CCF0_CCF1_string}
:
    ""]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Heading" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?RB_TYPE} = 'PSI') THEN
// 'Piece Scale Invoice List'
//ELSE
// 'Piece Scale Volume Statement List'

$P{RB_TYPE}!=null &&$P{RB_TYPE}.equalsIgnoreCase( "PSI" )
?
 "Piece Scale Invoice List"
:
 "Piece Scale Volume Statement List"]]></variableExpression>
	</variable>
