	</variable>
	<variable name="CopiedToTotalVolume" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{CCF18_RTCondition1} ? $F{TOTAL_VOLUME} : null]]></variableExpression>
