$P{RB_TYPE}!=null && $P{RB_TYPE}.equalsIgnoreCase( "PSI" )
?
    $V{TotalCopiedToInvoices}==1
    ?
        "Copied to " + $F{CLIENT_NUMBER_COPIED_TO} + " " + $F{CLIENT_LOCN_CODE_COPIED_TO} + " Total: " + "  " + $V{TotalCopiedToInvoices}.toString()  + " Invoice"
    :
        "Copied to " + $F{CLIENT_NUMBER_COPIED_TO} + " " + $F{CLIENT_LOCN_CODE_COPIED_TO} + " Total: " + "  " + $V{TotalCopiedToInvoices}.toString()  + " Invoices"
:
    $V{TotalCopiedToInvoices}==1
    ?
        "Copied to " + $F{CLIENT_NUMBER_COPIED_TO} + " " + $F{CLIENT_LOCN_CODE_COPIED_TO} + " Total: " + "  " + $V{TotalCopiedToInvoices}.toString()  + " Statement"
    :
        "Copied to " + $F{CLIENT_NUMBER_COPIED_TO} + " " + $F{CLIENT_LOCN_CODE_COPIED_TO} + " Total: " + "  " + $V{TotalCopiedToInvoices}.toString()  + " Statements"]]></variableExpression>
	</variable>
