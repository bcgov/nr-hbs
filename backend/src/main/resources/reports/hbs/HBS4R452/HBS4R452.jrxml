	<queryString language="plsql">
		<![CDATA[{call HBS3R451(
RB_CURSOR => $P{ORACLE_REF_CURSOR},
RB_TYPE => $P{RB_TYPE},
RB_DOC_NUMBER => $P{RB_DOC_NUMBER},
RB_SCALE_DATE_FROM => $P{RB_SCALE_DATE_FROM},
RB_SCALE_DATE_TO => $P{RB_SCALE_DATE_TO},
RB_ISSUE_DATE_FROM => $P{RB_ISSUE_DATE_FROM},
RB_ISSUE_DATE_TO => $P{RB_ISSUE_DATE_TO},
RB_TIMBER_MARK => $P{RB_TIMBER_MARK},
RB_SCALE_SITE => $P{RB_SCALE_SITE},
RB_REGION_SCALED => $P{RB_REGION_SCALED},
RB_REGION_HARVESTED => $P{RB_REGION_HARVESTED},
RB_CLIENT_ASSOCIATION => $P{RB_CLIENT_ASSOCIATION},
RB_CLIENT_NUMBER => $P{RB_CLIENT_NUMBER},
RB_CLIENT_LOCATION_CODE => $P{RB_CLIENT_LOCATION_CODE},
RB_TRANSMISSION_ID => $P{RB_TRANSMISSION_ID},
RB_ORDER_BY => $P{RB_ORDER_BY},
RB_REPORTTYPE => $P{RB_REPORTTYPE},
RB_JOBNO => $P{RB_JOBNO}
)}]]>
	</queryString>
