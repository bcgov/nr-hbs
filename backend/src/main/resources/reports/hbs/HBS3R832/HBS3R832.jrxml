	<queryString language="plsql">
		<![CDATA[{call HBS3R832(
PARAM_CURSOR => $P{ORACLE_REF_CURSOR},
PARAM_SELECTCOUNT => $P{PARAM_SELECTCOUNT},
PARAM_TIMBERMARK => $P{PARAM_TIMBERMARK},
PARAM_POPULATION => $P{PARAM_POPULATION},
