	<variable name="CCF0_Show_PopStratYr" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R832.POPULATION_NUMBER} + "/" + {HBS3R832.STRATUM_NUMBER} + "/" + ToText ({HBS3R832.SAMPLING_YEAR},0, "")
//no check for empty on bigdecimal

($F{POPULATION_NUMBER} == null
    ? "" : $F{POPULATION_NUMBER}
)
+ "/" +
($F{STRATUM_NUMBER}  == null
    ? "" : $F{STRATUM_NUMBER}
)
+ "/" +
($F{SAMPLING_YEAR}  == null
    ? "" : $F{SAMPLING_YEAR}.toString()
)]]></variableExpression>
	</variable>
	<variable name="CCF1_ReportName" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//stringVar array Report  := Split (ReportTitle,'.');
//Report[1];

$P{p_report_id}.substring(0, $P{p_report_id}.indexOf("."))]]></variableExpression>
	</variable>
	<variable name="CCF2_InvoiceTo" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R832.CLIENT_NUMBER_PAID_BY}+ ' '+{HBS3R832.CLIENT_LOCN_CODE_PAID_BY}



($F{CLIENT_NUMBER_PAID_BY} == null || $F{CLIENT_NUMBER_PAID_BY}.isEmpty()
    ? "" : $F{CLIENT_NUMBER_PAID_BY}
)
+ " " +
($F{CLIENT_LOCN_CODE_PAID_BY}  == null || $F{CLIENT_LOCN_CODE_PAID_BY}.isEmpty()
    ? "" : $F{CLIENT_LOCN_CODE_PAID_BY}
)]]></variableExpression>
	</variable>
	<variable name="CCF3_CopyTo" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R832.CLIENT_NUMBER_COPIED_TO}+' '+{HBS3R832.CLIENT_LOCN_CODE_COPIED_TO}



($F{CLIENT_NUMBER_COPIED_TO} == null || $F{CLIENT_NUMBER_COPIED_TO}.isEmpty()
    ? "" : $F{CLIENT_NUMBER_COPIED_TO} + " "
)
+
($F{CLIENT_LOCN_CODE_COPIED_TO}  == null || $F{CLIENT_LOCN_CODE_COPIED_TO}.isEmpty()
    ? "" : $F{CLIENT_LOCN_CODE_COPIED_TO}
)]]></variableExpression>
	</variable>
