	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet" isForPrompting="false"/>
	<parameter name="LoggedInUser" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="p_report_id" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["HBS2R552a"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? "repo:" : "\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       LTD.LOGDTL_ID
     , LTD.DETAIL_DOCUMENT_NUMBER
     , LTD.VERSION
     , LTD.SCALE_SPECIES_CODE
     , LTD.SCALE_GRADE_CODE
     , LTD.SCALE_PRODUCT_CODE
     , LTD.DTLSEG_ID
     , LTD.LOG_NUMBER
     , LTD.LENGTH
     , LTD.TOP
     , LTD.BUTT
     , LTD.NET_VOLUME
     , LTD.NMV_IND
     , LTD.DEDUCTION_COUNT
     , LTD.INPUT_SPECIES
     , LTD.INPUT_GRADE
     , LTD.ENTRY_USERID
     , LTD.ENTRY_TIMESTAMP
     , LTD.UPDATE_USERID
     , LTD.UPDATE_TIMESTAMP
     , LTDD.LOG_DEFECT_ID
     , LTDD.DEFECT_NUMBER
     , LTDD.DEFECT_TYPE
     , LTDD.VOLUME
     , LTDD.DESCRIPTOR
FROM   	LOG_TALLY_DETAIL        LTD
JOIN  	LOG_TALLY_DETAIL_DEFECT LTDD ON LTDD.LOGDTL_ID 	=  LTD.LOGDTL_ID
WHERE 	LTD.DETAIL_DOCUMENT_NUMBER 			= $P{Pm-HBS2R552.DETAIL_DOCUMENT_NUMBER}
AND   	LTD.VERSION                				= $P{Pm-HBS2R552.VERSION}
ORDER BY	LTD.LOG_NUMBER
      	, LTDD.DEFECT_NUMBER]]>
	</queryString>
