	<parameter name="Pm-HBS2R152.DOCUMENT_CONTROL_NUMBER" class="java.math.BigDecimal"/>
	<parameter name="Pm-HBS2R152.VERSION" class="java.math.BigDecimal"/>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet" isForPrompting="false"/>
	<parameter name="LoggedInUser" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="p_report_id" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["HBS2R152a"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? "repo:" : "H:\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       SSG.SEGREGATION_ID
     , SSG.SCALE_SPECIES_CODE
     , SSG.SCALE_GRADE_CODE
     , SSG.SCALE_PRODUCT_CODE
     , SSG.DOCUMENT_CONTROL_NUMBER
     , SSG.VERSION
     , SSG.NUMBER_OF_PIECES
     , SSG.INPUT_SPECIES
     , SSG.INPUT_PRODUCT
     , SSG.INPUT_GRADE
     , SSG.VOLUME
     , SSG.ENTRY_USERID
     , SSG.ENTRY_TIMESTAMP
     , SSG.UPDATE_USERID
     , SSG.UPDATE_TIMESTAMP
     , SSC.DESCRIPTION
     , SSC.EFFECTIVE_DATE
     , SSC.EXPIRY_DATE
     , SSC.UPDATE_TIMESTAMP
FROM      SAMPLE_SEGREGATION SSG
LEFT JOIN SCALE_SPECIES_CODE SSC ON SSC.SCALE_SPECIES_CODE = SSG.SCALE_SPECIES_CODE
LEFT JOIN SCALE_PRODUCT_CODE SPC ON SPC.SCALE_PRODUCT_CODE = SSG.SCALE_PRODUCT_CODE
WHERE  SSG.DOCUMENT_CONTROL_NUMBER = $P{Pm-HBS2R152.DOCUMENT_CONTROL_NUMBER}
AND    SSG.VERSION                 = $P{Pm-HBS2R152.VERSION}
]]>
	</queryString>
	<field name="SEGREGATION_ID" class="java.math.BigDecimal"/>
	<field name="SCALE_SPECIES_CODE" class="java.lang.String"/>
	<field name="SCALE_GRADE_CODE" class="java.lang.String"/>
	<field name="SCALE_PRODUCT_CODE" class="java.lang.String"/>
	<field name="DOCUMENT_CONTROL_NUMBER" class="java.math.BigDecimal"/>
	<field name="VERSION" class="java.math.BigDecimal"/>
	<field name="NUMBER_OF_PIECES" class="java.math.BigDecimal"/>
	<field name="INPUT_SPECIES" class="java.lang.String"/>
	<field name="INPUT_PRODUCT" class="java.lang.String"/>
	<field name="INPUT_GRADE" class="java.lang.String"/>
	<field name="VOLUME" class="java.math.BigDecimal"/>
	<field name="ENTRY_USERID" class="java.lang.String"/>
	<field name="ENTRY_TIMESTAMP" class="java.sql.Timestamp"/>
	<field name="UPDATE_USERID" class="java.lang.String"/>
	<field name="UPDATE_TIMESTAMP" class="java.sql.Timestamp"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="EFFECTIVE_DATE" class="java.sql.Timestamp"/>
	<field name="EXPIRY_DATE" class="java.sql.Timestamp"/>
	<variable name="CCF0_Show_Species" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $F{SCALE_SPECIES_CODE} == null || $F{SCALE_SPECIES_CODE}.isEmpty()
? ( $F{INPUT_SPECIES} == null || $F{INPUT_SPECIES}.isEmpty() ? "" : "* " + $F{INPUT_SPECIES} )
: $F{DESCRIPTION}
)]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_Grade" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $F{SCALE_GRADE_CODE} == null || $F{SCALE_GRADE_CODE}.isEmpty()
? ( $F{INPUT_GRADE} == null || $F{INPUT_GRADE}.isEmpty() ? "" : "* " + $F{INPUT_GRADE} )
: $F{SCALE_GRADE_CODE}
)]]></variableExpression>
	</variable>
