	<queryString>
		<![CDATA[SELECT
       SSST.TRX_ID
     , SSST.HBS_TXN_STATUS_CODE
     , SSST.VERSION
     , SSST.DOCUMENT_CONTROL_NUMBER
     , SSST.BATCH_ID
     , SSST.HBS_TXN_TYPE_CODE
     , SSST.SMRYRETTXN_COMMENT
     , SSST.EVENT_SEQUENCE
     , SSST.DEBIT_CREDIT_TYPE
     , SSST.STATEMENT_NUMBER
     , SSST.ENTRY_USERID
     , SSST.ENTRY_TIMESTAMP
     , SSST.UPDATE_USERID
     , SSST.UPDATE_TIMESTAMP
     , SSST.RATIO_STATEMENT_NUMBER
     , HTTC.DESCRIPTION
     , HTTC.EFFECTIVE_DATE
     , HTTC.EXPIRY_DATE
     , HOPB.HBS_RETURN_TYPE_CODE
     , HOPB.TRANSMISSION_ID
     , HOPB.OUTPUT_BATCH_STATUS_CODE
     , HOPB.RETURN_COUNT
     , HOPB.SENT_DATE_TIME
     , HOPB.RECORD_COUNT
     , HOPB.SENT_IND
     , HOPB.RECONCILED_TXN_COUNT
     , SSSM.LICENSE_NUMBER
     , SSSM.QUANT_LIC_TYPE_CD
     , SSSM.RETURN_NUMBER
     , SSSM.SCALE_SITE_ID_NMBR
     , SSSM.SCALE_DATE
     , SSSM.POPULATION_NUMBER
     , SSSM.STRATUM_NUMBER
     , SSSM.SAMPLING_YEAR
     , SSSM.TIMBER_MARK
     , SSSM.NET_WEIGHT
     , SSSM.LOAD_ARRIVAL_NUMBER
     , SSSM.LOG_COUNT
     , SSSM.WEIGH_SLIP_NUMBER
     , SSSM.SCL_RTN_VERSION_STATE_CODE
     , SSSM.SCL_RTN_CATEGORY_CODE
     , SSSM.INPUT_POPULATION
     , SSSM.INPUT_STRATUM
     , SSSM.INPUT_SAMPLING_YEAR
     , SSSM.INPUT_TIMBER_MARK
     , SSSM.INPUT_SCALER_LICENSE_NUM
     , SSSM.CHECK_SCALE_IND
     , SSSM.ACTIVE_VERSION_IND
     , SSSM.QUEUED_FOR_PRINT_IND
     , SSSM.VISIBILITY_IND
     , SSSM.PENDING_TXN_COMMENT
     , SMSG.SEGREGATION_ID
     , SMSG.SCALE_SPECIES_CODE
     , SMSG.SCALE_GRADE_CODE
     , SMSG.SCALE_PRODUCT_CODE
     , SMSG.NUMBER_OF_PIECES
     , SMSG.INPUT_SPECIES
     , SMSG.INPUT_PRODUCT
     , SMSG.INPUT_GRADE
     , SMSG.VOLUME
     , HCSS.CLIENT_NUMBER_SEND_TO
     , HCSS.CLIENT_LOCN_CODE_SEND_TO
     , HCSS.CLIENT_NUMBER_COPY_TO
     , HCSS.CLIENT_LOCN_CODE_COPY_TO
     , HCSS.HBS_FILE_ID
     , HCSS.MIME_TYPE_CODE
     , HCSS.TOTAL_VOLUME
     , HCSS.ISSUE_DATE
FROM      SAMPLE_SCL_SMRY_TXN       SSST
LEFT JOIN HBS_TXN_TYPE_CODE         HTTC ON  HTTC.HBS_TXN_TYPE_CODE       = SSST.HBS_TXN_TYPE_CODE
LEFT JOIN HBS_OUTPUT_BATCH          HOPB ON  HOPB.BATCH_ID                = SSST.BATCH_ID
JOIN      SAMPLE_SCALE_SUMMARY      SSSM ON  SSSM.DOCUMENT_CONTROL_NUMBER = SSST.DOCUMENT_CONTROL_NUMBER
                                         AND SSSM.VERSION                 = SSST.VERSION
JOIN      SAMPLE_SEGREGATION        SMSG ON  SMSG.DOCUMENT_CONTROL_NUMBER = SSSM.DOCUMENT_CONTROL_NUMBER
                                         AND SMSG.VERSION                 = SSSM.VERSION
JOIN      HBS_COMPILED_SAMPLE_STMNT HCSS ON  HCSS.TRX_ID                  = SSST.TRX_ID
WHERE  SSST.DOCUMENT_CONTROL_NUMBER = $P{Pm-HBS2R152.DOCUMENT_CONTROL_NUMBER}
ORDER BY SSST.EVENT_SEQUENCE]]>
	</queryString>
