	<variable name="CCF0_DateRange" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local StringVar strDate;
//if {?INVLIST_BILLFORM} <> '' then strDate:= 'Billing From: ' + {?INVLIST_BILLFORM}
//+ '   To: ' + {?INVLIST_BILLTO} + chr(13);
//if {?INVLIST_SCALEFROM} <> '' then strDate:=  strDate + 'Scale From:  '
//+ {?INVLIST_SCALEFROM} + '   To: ' + {?INVLIST_SCALETO};
//strDate


($P{INVLIST_BILLFORM}!=null && !$P{INVLIST_BILLFORM}.isEmpty()
? "Billing From: " + $P{INVLIST_BILLFORM} + "   To: " + $P{INVLIST_BILLTO} + "\n"
: "" )
+
($P{INVLIST_SCALEFROM}!=null && !$P{INVLIST_SCALEFROM}.isEmpty()
? "Scale From:  " + $P{INVLIST_SCALEFROM} + "   To: " + $P{INVLIST_SCALETO}
: "" )]]></variableExpression>
	</variable>
	<variable name="CCF1_clientLoc" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local StringVar strCliLoc;
//strCliLoc:= '';
//if {?INVLIST_INVCLI} <> '' then strCliLoc:= 'Payable By: ' + {?INVLIST_INVCLI} + ' ' + {?INVLIST_INVLOC} + chr(13);
//if {?INVLIST_COPYCLI} <> '' then strCliLoc:=  strCliLoc + 'Copied To:  ' + {?INVLIST_COPYCLI} + ' ' + {?INVLIST_COPYLOC};
//if strCliLoc = '' then strCliLoc:='All' else strCliLoc


($P{INVLIST_INVCLI}==null || $P{INVLIST_INVCLI}.isEmpty()) &&
($P{INVLIST_COPYCLI}==null || $P{INVLIST_COPYCLI}.isEmpty())
?
    "All"
:
    ($P{INVLIST_INVCLI}!=null && !$P{INVLIST_INVCLI}.isEmpty()
    ? "Payable By: " + $P{INVLIST_INVCLI} + " " + $P{INVLIST_INVLOC} + "\n"
    : "" )
    +
    ($P{INVLIST_COPYCLI}!=null && !$P{INVLIST_COPYCLI}.isEmpty()
    ? "Copied To:  " + $P{INVLIST_COPYCLI} + " " + $P{INVLIST_COPYLOC}
    : "" )]]></variableExpression>
	</variable>
	<variable name="CCF2_tenureDetails" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local StringVar array strArray := [ {?INVLIST_LICMARK01},{?INVLIST_LICMARK02},{?INVLIST_LICMARK03},{?INVLIST_LICMARK04},
//                                    {?INVLIST_LICMARK05},{?INVLIST_LICMARK06},{?INVLIST_LICMARK07},{?INVLIST_LICMARK08},
//                                    {?INVLIST_LICMARK09},{?INVLIST_LICMARK10},''] ;
//Local StringVar strList;
//Local NumberVar i;
//For i := 1 To 10 Do
//(   if strArray[i] <> '' then strList := strList + strArray[i] + ', ';);
//if strList <> '' then strList := '( ' + Left (strList, Length (strList)-2 ) + ')';
//strList

"( " +
($P{INVOICE_LIST01}!=null && !$P{INVOICE_LIST01}.isEmpty() ? $P{INVOICE_LIST01} + ", ": "" ) +
($P{INVOICE_LIST02}!=null && !$P{INVOICE_LIST02}.isEmpty() ? $P{INVOICE_LIST02} + ", ": "" ) +
($P{INVOICE_LIST03}!=null && !$P{INVOICE_LIST03}.isEmpty() ? $P{INVOICE_LIST03} + ", ": "" ) +
($P{INVOICE_LIST04}!=null && !$P{INVOICE_LIST04}.isEmpty() ? $P{INVOICE_LIST04} + ", ": "" ) +
($P{INVOICE_LIST05}!=null && !$P{INVOICE_LIST05}.isEmpty() ? $P{INVOICE_LIST05} + ", ": "" ) +
($P{INVOICE_LIST06}!=null && !$P{INVOICE_LIST06}.isEmpty() ? $P{INVOICE_LIST06} + ", ": "" ) +
($P{INVOICE_LIST07}!=null && !$P{INVOICE_LIST07}.isEmpty() ? $P{INVOICE_LIST07} + ", ": "" ) +
($P{INVOICE_LIST08}!=null && !$P{INVOICE_LIST08}.isEmpty() ? $P{INVOICE_LIST08} + ", ": "" ) +
($P{INVOICE_LIST09}!=null && !$P{INVOICE_LIST09}.isEmpty() ? $P{INVOICE_LIST09} + ", ": "" ) +
($P{INVOICE_LIST10}!=null && !$P{INVOICE_LIST10}.isEmpty() ? $P{INVOICE_LIST10} : "" ) +
" )"]]></variableExpression>
	</variable>
	<variable name="CCF3_ScaleSites" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local StringVar array strArray := [ {?INVLIST_SCALE1},{?INVLIST_SCALE2},{?INVLIST_SCALE3},
//                                    {?INVLIST_SCALE4},{?INVLIST_SCALE5},''] ;
//Local StringVar strList;
//Local NumberVar i;
//if strArray[1] <> '' then strList := strArray[1] ;
//For i := 2 To 5 Do
//(   if strArray[i] <> '' then strList := strList + ', ' + strArray[i] ;);
//if strList <> '' then strList := '( ' + strList + ')';
//if strList = '' then strList := 'All' else strList;

"( " +
($P{INVLIST_SCALE1}!=null && !$P{INVLIST_SCALE1}.isEmpty() ? $P{INVLIST_SCALE1} + ", ": "" ) +
($P{INVLIST_SCALE2}!=null && !$P{INVLIST_SCALE2}.isEmpty() ? $P{INVLIST_SCALE2} + ", ": "" ) +
($P{INVLIST_SCALE3}!=null && !$P{INVLIST_SCALE3}.isEmpty() ? $P{INVLIST_SCALE3} + ", ": "" ) +
($P{INVLIST_SCALE4}!=null && !$P{INVLIST_SCALE4}.isEmpty() ? $P{INVLIST_SCALE4} + ", ": "" ) +
($P{INVLIST_SCALE5}!=null && !$P{INVLIST_SCALE5}.isEmpty() ? $P{INVLIST_SCALE5} : "" ) +
" )"]]></variableExpression>
	</variable>
	<variable name="CCF4_PopStratYear" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local StringVar strPopStratYear;
//if {?INVLIST_POP} <> '' then strPopStratYear := {?INVLIST_POP} + ' / ';
//if {?INVLIST_STRAT} <> '' then strPopStratYear := strPopStratYear + {?INVLIST_STRAT} + ' / ';
//strPopStratYear := strPopStratYear + {?INVLIST_YEAR};
//if strPopStratYear = '' then strPopStratYear := 'All' else strPopStratYear;




$P{INVLIST_POP}==null || $P{INVLIST_POP}.isEmpty() &&
$P{INVLIST_STRAT}==null || $P{INVLIST_STRAT}.isEmpty() &&
$P{INVLIST_YEAR}==null || $P{INVLIST_YEAR}.isEmpty()
?
    "All"
:
    ($P{INVLIST_POP}!=null && !$P{INVLIST_POP}.isEmpty() ? $P{INVLIST_POP} + " / " : "" )
    +
    ($P{INVLIST_STRAT}!=null && !$P{INVLIST_STRAT}.isEmpty() ? $P{INVLIST_STRAT} + " / " : "" )
    +
    $P{INVLIST_YEAR}]]></variableExpression>
	</variable>
	<variable name="CCF5_Population" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?INVLIST_POP} = '' then 'All' else {?INVLIST_POP};

$P{INVLIST_POP}==null || $P{INVLIST_POP}.isEmpty() ? "All" : $P{INVLIST_POP}]]></variableExpression>
	</variable>
	<variable name="CCF6_Stratum" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?INVLIST_STRAT} = '' then 'All' else {?INVLIST_STRAT};

$P{INVLIST_STRAT}==null || $P{INVLIST_STRAT}.isEmpty() ? "All" : $P{INVLIST_STRAT}]]></variableExpression>
	</variable>
	<variable name="CCF7_Year" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?INVLIST_YEAR} = '' then 'All' else {?INVLIST_YEAR};

$P{INVLIST_YEAR}==null || $P{INVLIST_YEAR}.isEmpty() ? "All" : $P{INVLIST_YEAR}]]></variableExpression>
	</variable>
	<variable name="CCF8_tenureType" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Select {?INVLIST_MARKLICTYPE}
//    Case 'mark':
//        'Timber Mark'
//    Case 'licence':
//        'Licence'
//    Case 'predominantMark':
//        'Predominant Mark'
//    default:
//       'All';



$P{INVLIST_MARKLICTYPE} !=null
?
    ($P{INVLIST_MARKLICTYPE}.equalsIgnoreCase( "mark" ) ? "Timber Mark"  :
    ($P{INVLIST_MARKLICTYPE}.equalsIgnoreCase( "licence" ) ? "Licence"  :
    ($P{INVLIST_MARKLICTYPE}.equalsIgnoreCase( "predominantMark" ) ? "Predominant Mark"  : "All"
     )))
: "All"]]></variableExpression>
	</variable>
