	<variable name="CCF1_Show_population" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty()
? ( $F{INPUT_POPULATION} == null || $F{INPUT_POPULATION}.isEmpty() ? "" : "* " + $F{INPUT_POPULATION} )
: $F{POPULATION_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Stratum" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{STRATUM_NUMBER} == null || $F{STRATUM_NUMBER}.isEmpty()
? ( $F{INPUT_STRATUM} == null || $F{INPUT_STRATUM}.isEmpty() ? "" : "* " + $F{INPUT_STRATUM} )
: $F{STRATUM_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_Year" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{SAMPLING_YEAR} == null
? ( $F{INPUT_SAMPLING_YEAR} == null || $F{INPUT_SAMPLING_YEAR}.isEmpty() ? "" : "* " + $F{INPUT_SAMPLING_YEAR} )
: new DecimalFormat("###0").format( $F{SAMPLING_YEAR} )]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_License" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{LICENSE_NUMBER} == null || $F{LICENSE_NUMBER}.isEmpty()
? ( $F{INPUT_SCALER_LICENSE_NUM} == null || $F{INPUT_SCALER_LICENSE_NUM}.isEmpty() ? "" : "* " + $F{INPUT_SCALER_LICENSE_NUM} )
: $F{LICENSE_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_SortBy" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{PSR_ORDERBY}.equalsIgnoreCase( "0"  ) ? "Sorted By: Summary Document Number" :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "1"  ) ? "Sorted By: Version Status"          :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "3"  ) ? "Sorted By: Scale Date"              :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "4"  ) ? "Sorted By: Timber Mark"             :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "5"  ) ? "Sorted By: Scale Site"              :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "9"  ) ? "Sorted By: Population/Stratum/Year" :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "10" ) ? "Sorted By: Scaler Licence"          :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "13" ) ? "Sorted By: Version"                 :
                                             "Sorted By: Summary Document Number" ))))))))]]></variableExpression>
	</variable>
	<variable name="CCF6_Show_TimberMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks"                    ) ? "All Marks" :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark"                  ) ? ( $P{PSR_TIMBERMARK} == null || $P{PSR_TIMBERMARK}.isEmpty() ? "" : $P{PSR_TIMBERMARK} ) :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinassociateddistricts"  ) ? "Associated Marks" :
(($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinaregionordistrict"    ) &&
                                    $P{PSR_DISTRICTHARVESTED}.isEmpty() ) ? "In All" :
                                          "" ))))]]></variableExpression>
	</variable>
	<variable name="CCF7_Show_ScaleSite" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "allsites"                    ) ? "All Sites" :
( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "singlesite"                  ) ? ( $P{PSR_SCALESITE} == null || $P{PSR_SCALESITE}.isEmpty() ? "" : $P{PSR_SCALESITE} ) :
( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinassociateddistricts"  ) ? "Associated Sites" :
(($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinaregionordistrict"    ) &&
                                    $P{PSR_DISTRICTSCALED}.isEmpty()    ) ? "In All" :
( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "associatedsites"             ) ? "Associated Sites" :
                                          "" )))))]]></variableExpression>
	</variable>
	<variable name="CCF10_Show_Version_Title" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{PSR_ACTIVEVERSIONFLAG}.equalsIgnoreCase( "Y" )
? "List of Sample Scale Summary Returns - Current Versions"
: "List of Sample Scale Summary Returns - All Versions"]]></variableExpression>
	</variable>
	<variable name="Count (HBS2R151.DOCUMENT_CONTROL_NUMBER)" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{DOCUMENT_CONTROL_NUMBER}]]></variableExpression>
	</variable>
