	<variable name="CCF0_Show_description" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[////START BT10645
// IF UPPERCASE({?Pm-?PSR_ERRORCODE})<> '' THEN
//    IF UPPERCASE({?Pm-?PSR_EXCLUDEERROR}) = 'Y' THEN
//        'Everything but ' + {HBS_EDIT_ERR_MESSAGE_CODE.HBS_EDIT_ERR_MESSAGE_CODE}
//    ELSE
//        {HBS_EDIT_ERR_MESSAGE_CODE.HBS_EDIT_ERR_MESSAGE_CODE}
////END BT10645

( $P{Pm-?PSR_ERRORCODE} != null && !($P{Pm-?PSR_ERRORCODE}.isEmpty())
? ( $P{Pm-?PSR_EXCLUDEERROR}.equalsIgnoreCase( "Y" )
  ? ( $F{HBS_EDIT_ERR_MESSAGE_CODE} == null || $F{HBS_EDIT_ERR_MESSAGE_CODE}.isEmpty() ? "" : "Everything but " + $F{HBS_EDIT_ERR_MESSAGE_CODE} )
  : $F{HBS_EDIT_ERR_MESSAGE_CODE}
  )
: ""
)]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_ErrorDescription" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[////START BT10645
//IF UPPERCASE({?Pm-?PSR_ERRORCODE})<> '' THEN
//    IF UPPERCASE({?Pm-?PSR_EXCLUDEERROR}) = 'Y' THEN
//        '(i.e. everything but '+ {HBS_EDIT_ERR_MESSAGE_CODE.HBS_EDIT_ERR_MESSAGE_CODE}+')'
////END BT10645

$P{Pm-?PSR_ERRORCODE}.toUpperCase() != "" ? ($P{Pm-?PSR_EXCLUDEERROR}.equalsIgnoreCase( "Y" ) ? "(i.e. everything but " + $F{HBS_EDIT_ERR_MESSAGE_CODE} + ")" : "") : ""]]></variableExpression>
	</variable>
