""]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_population" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
//IF ISNULL({HBS2R101.POPULATION_NUMBER}) THEN
// '* ' + {HBS2R101.INPUT_POPULATION}
//ELSE
// {HBS2R101.POPULATION_NUMBER}

$F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty()? "* " + $F{INPUT_POPULATION} : $F{POPULATION_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Stratum" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// If the column is null then it was entered in error so show the unvalidated original entry field
//IF ISNULL({HBS2R101.STRATUM_NUMBER}) THEN
// '* ' + {HBS2R101.INPUT_STRATUM}
//ELSE
// {HBS2R101.STRATUM_NUMBER}

$F{STRATUM_NUMBER}.isEmpty() || $F{STRATUM_NUMBER} == null ? "* " + $F{INPUT_STRATUM} : $F{STRATUM_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_Year" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// If the column is null then it was entered in error so show the unvalidated original entry field
//IF ISNULL({HBS2R101.SAMPLING_YEAR}) THEN
// '* ' + {HBS2R101.INPUT_SAMPLING_YEAR}
//ELSE
// totext({HBS2R101.SAMPLING_YEAR},0,'')

$F{SAMPLING_YEAR} == null ? "* " + $F{INPUT_SAMPLING_YEAR} : $F{SAMPLING_YEAR}.toString()]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_TimberMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// If the column is null then it was entered in error so show the unvalidated original entry field
////TATA DEVELOPER START OF CHANGE FOR BT1993
////IF ISNULL({HBS2R051.TIMBER_MARK}) THEN
//// '* ' + {HBS2R051.INPUT_TIMBER_MARK}
////ELSE
// //{HBS2R051.TIMBER_MARK}

//IF{?PSR_SEARCHBYMARKS}='allmarks' THEN
//'All Marks'
//ELSE IF {?PSR_SEARCHBYMARKS}='singlemark' then
//{?PSR_TIMBERMARK}
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinassociateddistricts' then
//'Associated Marks '
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinaregionordistrict' and {?PSR_DISTRICTHARVESTED}="" then
//'In All'


$P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks")  ? "All Marks":
($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase ("singlemark")? $P{PSR_TIMBERMARK} :
    ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase ("marksinassociateddistricts") ? "Associated Marks" :
        ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase ("marksinaregionordistrict") && ($P{PSR_SEARCHBYMARKS}.equalsIgnoreCase ("") || $P{PSR_DISTRICTHARVESTED}.isEmpty() || $P{PSR_DISTRICTHARVESTED} == null) ? "In All" : "" )
     )
)]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_SortBy" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Select {?PSR_ORDERBY}
//  Case "0":
//    "Sorted By: Summary Document Number"
//  Case "1":
//    "Sorted By: Version Status"
//  Case "3":
//    "Sorted By: Scale Date"
//  Case "4":
//    "Sorted By: Timber Mark"
//  Case "5":
//    "Sorted By: Scale Site"
//  Case "9":
//    "Sorted By: Population/Stratum/Year"
//  Case "13":
//    "Sorted By: Version"
//  Default:
//    "Sorted By: Summary Document Number";


$P{PSR_ORDERBY}.equalsIgnoreCase( "0" )   ? "Sorted By: Summary Document Number" :
    ($P{PSR_ORDERBY}.equalsIgnoreCase( "1") ? "Sorted By: Version Status" :
        ($P{PSR_ORDERBY}.equalsIgnoreCase(  "3" )? "Sorted By: Scale Date" :
            ($P{PSR_ORDERBY}.equalsIgnoreCase(  "4") ?  "Sorted By: Timber Mark" :
                ($P{PSR_ORDERBY}.equalsIgnoreCase(  "5" )? "Sorted By: Timber Mark" :
                    ($P{PSR_ORDERBY}.equalsIgnoreCase(  "9") ? "Sorted By: Population/Stratum/Year"  :
                        ($P{PSR_ORDERBY}.equalsIgnoreCase(  "13") ? "Sorted By: Version" : "Sorted By: Summary Document Number"))))))]]></variableExpression>
	</variable>
	<variable name="CCF6_Sow_scaleSite" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[////TATA DEVELOPER 28-07-05 START OF CHANGE FOR BT1993
//IF{?PSR_SEARCHBYSITES}='allsites' THEN
//'All Sites'
//ELSE IF {?PSR_SEARCHBYSITES}='singlesite' then
//{?PSR_SCALESITE}
//ELSE IF {?PSR_SEARCHBYSITES}='sitesinassociateddistricts' then
//'Associated Sites'
//ELSE IF {?PSR_SEARCHBYSITES}='sitesinaregionordistrict' and {?PSR_DISTRICTSCALED}="" then
//'In All'
//ELSE IF {?PSR_SEARCHBYSITES}='associatedsites' then
//'Associated Sites'
////TATA DEVELOPER 28-07-0 END OF CHANGE FOR BT1993

$P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "allsites" )  ? "All Sites" :
($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "singlesite")? $P{PSR_SCALESITE} :
    ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinassociateddistricts") ? "Associated Sites" :
        ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "sitesinaregionordistrict" ) &&  ($P{PSR_DISTRICTSCALED} == null || $P{PSR_DISTRICTSCALED}.isEmpty()) ? "In All" :
              ($P{PSR_SEARCHBYSITES}.equalsIgnoreCase( "associatedsites") ? "Associated Sites" : "" )  )))]]></variableExpression>
	</variable>
	<variable name="CCF7_Show_FSDeckId" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[////BT 10014
//IF ISNULL({?PSR_FIELDSCALEDECKID}) THEN
//    ''
//ELSE IF {?PSR_FIELDSCALEDECKID} = '99999' THEN
//    ''
//ELSE
//    {?PSR_FIELDSCALEDECKID}

$P{PSR_FIELDSCALEDECKID}.isEmpty() || $P{PSR_FIELDSCALEDECKID} == null ? "" :
($P{PSR_FIELDSCALEDECKID} == "99999" ? "" : $P{PSR_FIELDSCALEDECKID})]]></variableExpression>
	</variable>
	<variable name="CCF8_Show_Version_Title" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF (UpperCase({?PSR_ACTIVEVERSIONFLAG})='Y') THEN
//'List of Weight Scale Summary Returns - Current Versions'
//ELSE
//'List of Weight Scale Summary Returns - All Versions'

$P{PSR_ACTIVEVERSIONFLAG}.equalsIgnoreCase( "y" )? "List of Weight Scale Summary Returns - Current Versions" :
"List of Weight Scale Summary Returns - All Versions"]]></variableExpression>
	</variable>
	<variable name="CCF9_recordCount" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[//IF IsNull( Count ({HBS2R101.DOCUMENT_CONTROL_NUMBER}) ) THEN
//     0
//
//ELSE
//
//    Count ({HBS2R101.DOCUMENT_CONTROL_NUMBER})


$V{Count (HBS2R101.DOCUMENT_CONTROL_NUMBER)} != null? $V{Count (HBS2R101.DOCUMENT_CONTROL_NUMBER)} : 0]]></variableExpression>
	</variable>
	<variable name="Count (HBS2R101.DOCUMENT_CONTROL_NUMBER)" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{DOCUMENT_CONTROL_NUMBER}]]></variableExpression>
	</variable>
