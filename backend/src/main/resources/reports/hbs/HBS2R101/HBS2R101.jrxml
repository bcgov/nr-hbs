	<variable name="TempCCF0_Show_RegDist_Name" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL ({?RB_REGDIST}) or {?RB_REGDIST} = ' ' THEN
//  ' '
