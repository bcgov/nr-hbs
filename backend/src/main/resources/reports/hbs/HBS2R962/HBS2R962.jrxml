	<variable name="CCF0_Show_ReturnFormat" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?AUDITLOG_RETURN_FORMAT} = 'S') OR ({?AUDITLOG_RETURN_FORMAT} = 'SSR') then
//  'Summary'
//ELSE
// 'Detail'


$P{AUDITLOG_RETURN_FORMAT} != null
&& !($P{AUDITLOG_RETURN_FORMAT}.isEmpty())
&&($P{AUDITLOG_RETURN_FORMAT}.equalsIgnoreCase( "S" ) || $P{AUDITLOG_RETURN_FORMAT}.equalsIgnoreCase( "SSR" ))
? "Summary"
: "Detail"]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_DocNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//numberVar ncomma := InStr({HBS2R962.OBJECT_OLD_ID},",");
//IF ncomma > 0 THEN
//  MID( {HBS2R962.OBJECT_OLD_ID}, 1,  ncomma - 1)
//ELSE
// {HBS2R962.OBJECT_OLD_ID}
//return substring before comma


$F{OBJECT_OLD_ID} != null && !($F{OBJECT_OLD_ID}.isEmpty())
?
    ($F{OBJECT_OLD_ID}.indexOf(",") > 0
     ? $F{OBJECT_OLD_ID}.substring(0, $F{OBJECT_OLD_ID}.indexOf(","))
     : $F{OBJECT_OLD_ID}
     )

: ""]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Version" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//numberVar ncomma := InStr({HBS2R962.OBJECT_OLD_ID},",");
//IF (ncomma > 0) and (ncomma < Length(Trim({HBS2R962.OBJECT_OLD_ID}))) THEN
//  MID( {HBS2R962.OBJECT_OLD_ID}, ncomma + 1)
//ELSE
// ' '



$F{OBJECT_OLD_ID} != null && !($F{OBJECT_OLD_ID}.isEmpty())
?
    ($F{OBJECT_OLD_ID}.indexOf(",") > 0
     ? $F{OBJECT_OLD_ID}.substring($F{OBJECT_OLD_ID}.indexOf(",") +1)
     : $F{OBJECT_OLD_ID}
     )

: " "]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_DocLabel" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?AUDITLOG_RETURN_FORMAT} = 'S') OR ({?AUDITLOG_RETURN_FORMAT} = 'SSR') then
//  'Summary Document'
//ELSE
//  'Detail Document'

$P{AUDITLOG_RETURN_FORMAT} != null
&& !($P{AUDITLOG_RETURN_FORMAT}.isEmpty())
&& ($P{AUDITLOG_RETURN_FORMAT}.equalsIgnoreCase( "S" ) || $P{AUDITLOG_RETURN_FORMAT}.equalsIgnoreCase( "SSR" ))
? "Summary Document"
: "Detail Document"]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_FromParm" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//LEFT({?AUDITLOG_CHANGEDFROMDATE},10)

$P{AUDITLOG_CHANGEDFROMDATE} != null && !($P{AUDITLOG_CHANGEDFROMDATE}.isEmpty())
? (
    $P{AUDITLOG_CHANGEDFROMDATE}.length()>= 10
    ?   $P{AUDITLOG_CHANGEDFROMDATE}.substring(0,10)
    :   $P{AUDITLOG_CHANGEDFROMDATE}
    )

: ""]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_ToParm" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//LEFT({?AUDITLOG_CHANGEDTODATE},10)

$P{AUDITLOG_CHANGEDTODATE} != null && !($P{AUDITLOG_CHANGEDTODATE}.isEmpty())
