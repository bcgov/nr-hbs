	<variable name="CCF0_Show_FromBilledDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//left({?RB_ISSUE_DATE_FROM}, 10)

$P{RB_ISSUE_DATE_FROM} != null && !($P{RB_ISSUE_DATE_FROM}.isEmpty())
? (
    $P{RB_ISSUE_DATE_FROM}.length()>= 10
    ?   $P{RB_ISSUE_DATE_FROM}.substring(0,10)
    :   $P{RB_ISSUE_DATE_FROM}
    )

: ""]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_ToBilledDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//left({?RB_ISSUE_DATE_TO}, 10)

$P{RB_ISSUE_DATE_TO} != null && !($P{RB_ISSUE_DATE_TO}.isEmpty())
? (
    $P{RB_ISSUE_DATE_TO}.length()>= 10
    ?   $P{RB_ISSUE_DATE_TO}.substring(0,10)
    :   $P{RB_ISSUE_DATE_TO}
    )

: ""]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_FromScaledDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//left({?RB_SCALE_DATE_FROM}, 10)

$P{RB_SCALE_DATE_FROM} != null && !($P{RB_SCALE_DATE_FROM}.isEmpty())
? (
    $P{RB_SCALE_DATE_FROM}.length()>= 10
    ?   $P{RB_SCALE_DATE_FROM}.substring(0,10)
    :   $P{RB_SCALE_DATE_FROM}
    )

: ""]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_ToScaledDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//left({?RB_SCALE_DATE_TO}, 10)


$P{RB_SCALE_DATE_TO} != null && !($P{RB_SCALE_DATE_TO}.isEmpty())
? (
    $P{RB_SCALE_DATE_TO}.length()>= 10
    ?   $P{RB_SCALE_DATE_TO}.substring(0,10)
    :   $P{RB_SCALE_DATE_TO}
    )

: ""]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_CountInvoice" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[//if not isnull (Count ({HBS3R421.STATEMENT_NUMBER})) then
//    Count ({HBS3R421.STATEMENT_NUMBER})
//else
//    0

$F{STATEMENT_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_Mgmt_Unit_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?RB_MGMT_UNIT_TYPE_CODE} = 'F' THEN     'Woodlot'
//ELSE IF {?RB_MGMT_UNIT_TYPE_CODE} = 'T' THEN     'Tree Farm Licence'
//ELSE IF {?RB_MGMT_UNIT_TYPE_CODE} = 'U' THEN     'Timber Supply Area'
//ELSE IF {?RB_MGMT_UNIT_TYPE_CODE} = 'V' THEN     'Timber Supply Block'
//ELSE IF {?RB_MGMT_UNIT_TYPE_CODE} = 'U,V' THEN     'Timber Supply Area or Block'
//ELSE IF {?RB_MGMT_UNIT_TYPE_CODE} = 'F,T,U,V' THEN     'Other';

$P{RB_MGMT_UNIT_TYPE_CODE}!=null
?
    ($P{RB_MGMT_UNIT_TYPE_CODE}.equalsIgnoreCase( "F" ) ? "Woodlot" :
    ($P{RB_MGMT_UNIT_TYPE_CODE}.equalsIgnoreCase( "T" ) ? "Tree Farm Licence" :
    ($P{RB_MGMT_UNIT_TYPE_CODE}.equalsIgnoreCase( "U" ) ? "Timber Supply Area" :
    ($P{RB_MGMT_UNIT_TYPE_CODE}.equalsIgnoreCase( "V" ) ? "Timber Supply Block" :
    ($P{RB_MGMT_UNIT_TYPE_CODE}.equalsIgnoreCase( "U,V" ) ? "Timber Supply Area or Block" :
    ($P{RB_MGMT_UNIT_TYPE_CODE}.equalsIgnoreCase( "F,T,U,V" ) ? "Other" : ""
        ))))))
: ""]]></variableExpression>
	</variable>
	<variable name="CCF6_Show_RegionHarvested" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if({?RB_REGION_HARVESTED}='0')then
//  'Interior Forest Regions'
//else if({?RB_REGION_HARVESTED}='10001')then
//  'Coast Area'
//else if({?RB_REGION_HARVESTED}='10002')then
//  'North Area'
//else if({?RB_REGION_HARVESTED}='10003')then
//  'South Area'

$P{RB_REGION_HARVESTED}!=null
?
    ($P{RB_REGION_HARVESTED}.equalsIgnoreCase( "0" ) ? "Interior Forest Regions" :
    ($P{RB_REGION_HARVESTED}.equalsIgnoreCase( "10001" ) ? "Coast Area" :
    ($P{RB_REGION_HARVESTED}.equalsIgnoreCase( "10002" ) ? "North Area" :
    ($P{RB_REGION_HARVESTED}.equalsIgnoreCase( "10003" ) ? "South Area" : ""
        ))))
: ""]]></variableExpression>
	</variable>
	<variable name="CCF7_Show_RegionScaled" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if({?RB_REGION_SCALED}='0')then
//'Interior Forest Regions'
//else if({?RB_REGION_SCALED}='10001')then
//'Coast Area'
//else if({?RB_REGION_SCALED}='10002')then
//'North Area'
//else if({?RB_REGION_SCALED}='10003')then
//'South Area'


$P{RB_REGION_SCALED}!=null
?
    ($P{RB_REGION_SCALED}.equalsIgnoreCase( "0" ) ? "Interior Forest Regions" :
    ($P{RB_REGION_SCALED}.equalsIgnoreCase( "10001" ) ? "Coast Area" :
    ($P{RB_REGION_SCALED}.equalsIgnoreCase( "10002" ) ? "North Area" :
    ($P{RB_REGION_SCALED}.equalsIgnoreCase( "10003" ) ? "South Area" : ""
        ))))
: ""]]></variableExpression>
	</variable>
