//             '* ' + {HBS2R552.INPUT_BCOMB_TIMBER_MARK}
//      ELSE
//           {HBS2R552.DTL_TIMBER_MARK}
//ELSE
//   ' '


$F{BEACHCOMB_IND}!=null && $F{BEACHCOMB_IND}.equalsIgnoreCase( "Y" )
?
    ($F{DTL_TIMBER_MARK}==null || $F{DTL_TIMBER_MARK}.isEmpty()
    ? "* " + ($F{INPUT_BCOMB_TIMBER_MARK}!=null ? $F{INPUT_BCOMB_TIMBER_MARK} : "" )
    : $F{DTL_TIMBER_MARK}
    )
:
    " "]]></variableExpression>
	</variable>
