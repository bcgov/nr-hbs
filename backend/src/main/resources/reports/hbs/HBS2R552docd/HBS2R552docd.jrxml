	<variable name="CCF11_FormattedScaleDateParameter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?PSSCALEDDATEFROM} = '' AND {?PSSCALEDDATETO} = '' THEN ''
//ELSE
//    {?PSSCALEDDATEFROM} + '  to  ' + {?PSSCALEDDATETO}

($P{PSSCALEDDATEFROM}==null || $P{PSSCALEDDATEFROM}.isEmpty()) &&
($P{PSSCALEDDATETO}==null || $P{PSSCALEDDATETO}.isEmpty())
? ""
: $P{PSSCALEDDATEFROM} + " to " + $P{PSSCALEDDATETO}]]></variableExpression>
	</variable>
	<variable name="CCF12_FormattedClientTypeParameter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (IsNull({?PSCLIENTTYPE})) then
//    'ALL'
//else if (Length (Trim ({?PSCLIENTTYPE})) = 0) then
//    'ALL'
//else
//    UpperCase ({?PSCLIENTTYPE})

$P{PSCLIENTTYPE} == null ||$P{PSCLIENTTYPE}.isEmpty() ||
($P{PSCLIENTTYPE}.trim()).length() == 0
? "ALL"
: $P{PSCLIENTTYPE}.toUpperCase()]]></variableExpression>
	</variable>
	<variable name="CCF13_FormattedClientParameter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//'Client No / Loc: ' + {?PSCLIENTNO} + ' / ' + {?PSCLIENTLOC}

"Client No / Loc: " +
($P{PSCLIENTNO}!=null ? $P{PSCLIENTNO} : "" )
+ " / " +
($P{PSCLIENTLOC}!=null ? $P{PSCLIENTLOC} : "" )]]></variableExpression>
	</variable>
