// 'Gross'
//ELSE IF(UpperCase({HBS2R552.VOLUME_CALC_METHOD_TYPE}) = 'N') THEN
// 'Net'
//ELSE
// ' '

// If the column is null then it was entered in error so show the unvalidated original entry field

//IF (UpperCase({HBS2R552.VOLUME_CALC_METHOD_TYPE}) = 'G') THEN
// 'Gross'
//ELSE IF(UpperCase({HBS2R552.VOLUME_CALC_METHOD_TYPE}) = 'N') THEN
// 'Net'
//ELSE
// ' '

$F{VOLUME_CALC_METHOD_TYPE}!=null && $F{VOLUME_CALC_METHOD_TYPE}.equalsIgnoreCase( "G" ) ? "Gross" :
$F{VOLUME_CALC_METHOD_TYPE}!=null && $F{VOLUME_CALC_METHOD_TYPE}.equalsIgnoreCase( "N" ) ? "Net" : " "]]></variableExpression>
	</variable>
	<variable name="CCF9_Show_LogBCombMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
