	<variable name="CCF12_PopulationTitle" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_STRATUM_FLAG} = 'Yes')THEN
//'Population:           '+{?FB_POPULATION_NMBR}
//ELSE IF( {?FB_RADIO_SELECTED}='All')  or  ({?FB_RADIO_SELECTED}='Associated') THEN
//'Populations:         '+{?FB_RADIO_SELECTED}
//ELSE IF ({?FB_STRATUM_FLAG} = 'No') and ( {?FB_RADIO_SELECTED}='Single') THEN
//'Populations:         '+{?FB_RADIO_SELECTED}
//ELSE
//'Populations:         na'

$P{FB_STRATUM_FLAG}.equalsIgnoreCase( "Yes" )? "Population:           "+$P{FB_POPULATION_NMBR}:
$P{FB_RADIO_SELECTED}.equalsIgnoreCase( "All" ) || $P{FB_RADIO_SELECTED}.equalsIgnoreCase( "Associated" )? "Populations:         "+$P{FB_RADIO_SELECTED}:
$P{FB_STRATUM_FLAG}.equalsIgnoreCase( "No" ) && $P{FB_RADIO_SELECTED}.equalsIgnoreCase( "Single" )? "Populations:         "+$P{FB_RADIO_SELECTED}:
"Populations:         na"]]></variableExpression>
	</variable>
	<variable name="CCF13_PopulationSum" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_STRATUM_FLAG}='Yes') THEN
//{HBS3R829.POPULATION_NUMBER}

$P{FB_STRATUM_FLAG}.equalsIgnoreCase( "Yes" )?
$F{POPULATION_NUMBER} : null]]></variableExpression>
	</variable>
	<variable name="CCF14_MaxExpiryDate" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_STRATUM_FLAG}='Yes') THEN
// Maximum ({HBS3R829.EXPIRY_DATE})

