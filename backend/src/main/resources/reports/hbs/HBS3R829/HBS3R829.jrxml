//'na'
//ELSE
//{?FB_EXPIRING_BEFORE}

$P{FB_EXPIRING_BEFORE}.isEmpty() || $P{FB_EXPIRING_BEFORE} == null?
"na": $P{FB_EXPIRING_BEFORE}]]></variableExpression>
	</variable>
	<variable name="CCF20_ReportID" class="java.lang.String" resetType="None">
