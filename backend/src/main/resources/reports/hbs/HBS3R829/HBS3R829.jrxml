	</variable>
	<variable name="CCF16_HeadingTitle" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_STRATUM_FLAG}='Yes') THEN
//'Final Bill Status Summary(with Stratum List)'
//ELSE
//'                 Final Bill Status Summary'


$P{FB_STRATUM_FLAG} == "Yes"? "Final Bill Status Summary(with Stratum List)":
"                 Final Bill Status Summary"]]></variableExpression>
	</variable>
	<variable name="CCF17_PopulationValue" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_STRATUM_FLAG} <> 'Yes')THEN
