	<variable name="CCF9_PopOwnedBy" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_CLIENT_NUMBER}='') THEN
//' na'
//ELSE
//{?FB_CLIENT_NUMBER}+   {?FB_CLIENT_LOCN_CODE}

$P{FB_CLIENT_NUMBER} == null || $P{FB_CLIENT_NUMBER}.isEmpty()? " na":
$P{FB_CLIENT_NUMBER} + $P{FB_CLIENT_LOCN_CODE}]]></variableExpression>
	</variable>
	<variable name="CCF10_PopDistrict" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?FB_RADIO_SELECTED}='District') THEN
// {?FB_ORG_UNIT_NO}
//ELSE
//' na'

$P{FB_RADIO_SELECTED}.equalsIgnoreCase( "District" )? $P{FB_ORG_UNIT_NO} : " na"]]></variableExpression>
	</variable>
	<variable name="CCF11_StratumTitle" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA["Stratum"]]></variableExpression>
