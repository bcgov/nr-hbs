	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       DDBD.DETAIL_DOCUMENT_NUMBER
     , SSAL.VERSION
     , DDBD.BATDOC_ID
     , SSAL.SCALE_EVENT_TYPE_CODE
     , SSAL.SCL_RTN_VERSION_STATE_CODE
     , SSAL.SCALE_DATE
     , SSAL.SCALE_SITE_ID_NMBR
     , SSAL.CUT_BLOCK_ID
     , SSAL.ARRIVAL_DATE
     , SSAL.LICENSE_NUMBER
     , SSAL.QUANT_LIC_TYPE_CD
     , SSAL.TIMBER_MARK
     , SSAL.TIMBER_BRAND
     , SSAL.ARRIVAL_LEDGER_WEIGH_SLIP
     , SSAL.RETURN_NUMBER
     , SSAL.PARCEL_COUNT
     , SSAL.PARCEL_IDENTIFIER
     , SSAL.VALID_SIGNATURE_IND
     , SSAL.ORIGINAL_VERSION_IND
     , SSAL.ACTIVE_VERSION_IND
     , SSAL.FIELD_SCALE_IND
     , SSAL.FIELD_SCALE_DECK_ID
     , SSAL.ORIG_SCALE_SITE
     , SSAL.TRANSPORT_IDENTIFIER
     , SSAL.INCOMING_LDS_NUMBER
     , SSAL.LOAD_ARRIVAL_NUMBER
     , SSAL.ARRIVAL_LEDGER_COMMENT
     , SSAL.DTL_DOC_SEQ
     , SSAL.INPUT_PRIMARY_SCALER_LIC
     , SSAL.INPUT_SCALE_SITE
     , SSAL.INPUT_SOURCE
     , SSAL.INPUT_CUTBLOCK_ID
     , SSAL.ENTRY_USERID
     , SSAL.ENTRY_TIMESTAMP
     , SSAL.UPDATE_USERID
     , SSAL.UPDATE_TIMESTAMP
     , SSALE.ERROR_ID
     , SSALE.HBS_EDIT_ERR_MESSAGE_CODE
     , SSALE.HBS_EDIT_ERR_CATEGORY_CODE
     , SSALE.ERROR_TIMESTAMP
     , DDBD.BATCH_ID
     , DDBD.ACCEPTED_IND
     , DDBD.SOFTWARE_PRODUCT
     , DDBD.SOFTWARE_VERSION
     , DDBD.SOFTWARE_REVISION
     , DDBD.INPUT_DDN
     , DDBD.INPUT_DV
     , EEMC.DESCRIPTION
     , EEMC.EFFECTIVE_DATE
     , EEMC.EXPIRY_DATE
FROM      DTL_DOC_BATCH_DOCUMENT     DDBD
LEFT JOIN SCL_SITE_ARRIVAL_LEDGER    SSAL  ON  SSAL.BATDOC_ID                  = DDBD.BATDOC_ID
LEFT JOIN SCALE_SITE_ARVL_LDGR_ERROR SSALE ON  SSALE.DETAIL_DOCUMENT_NUMBER    = SSAL.DETAIL_DOCUMENT_NUMBER
                                           AND SSALE.VERSION                   = SSAL.VERSION
LEFT JOIN HBS_EDIT_ERR_MESSAGE_CODE  EEMC  ON  EEMC.HBS_EDIT_ERR_MESSAGE_CODE  = SSALE.HBS_EDIT_ERR_MESSAGE_CODE
                                           AND EEMC.HBS_EDIT_ERR_CATEGORY_CODE = SSALE.HBS_EDIT_ERR_CATEGORY_CODE
WHERE  DDBD.DETAIL_DOCUMENT_NUMBER IS NOT NULL
AND    DDBD.BATCH_ID = $P{Pm-HBS2R033.BATCH_ID}
ORDER BY
       SSAL.LOAD_ARRIVAL_NUMBER
     , SSAL.VERSION
     , SSAL.DETAIL_DOCUMENT_NUMBER]]>
	</queryString>
