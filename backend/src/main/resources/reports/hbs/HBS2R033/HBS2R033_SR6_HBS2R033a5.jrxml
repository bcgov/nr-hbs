	<field name="DETAIL_DOCUMENT_NUMBER" class="java.lang.String"/>
	<field name="INPUT_DDN" class="java.lang.String"/>
	<field name="INPUT_DV" class="java.lang.String"/>
	<field name="ENTRY_USERID" class="java.lang.String"/>
	<field name="ENTRY_TIMESTAMP" class="java.sql.Timestamp"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="EFFECTIVE_DATE" class="java.sql.Timestamp"/>
	<field name="EXPIRY_DATE" class="java.sql.Timestamp"/>
	<field name="UPDATE_TIMESTAMP" class="java.sql.Timestamp"/>
	<variable name="CCF0_Show_DDN" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{DETAIL_DOCUMENT_NUMBER} == null || $F{DETAIL_DOCUMENT_NUMBER}.isEmpty()
? $F{INPUT_DDN}
: $F{DETAIL_DOCUMENT_NUMBER}
]]></variableExpression>
	</variable>
