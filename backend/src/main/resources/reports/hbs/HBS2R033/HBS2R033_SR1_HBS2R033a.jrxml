		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       DDBD.BATDOC_ID
     , DDBD.BATCH_ID
     , DDBD.ACCEPTED_IND
     , DDBD.SOFTWARE_PRODUCT
     , DDBD.SOFTWARE_VERSION
     , DDBD.SOFTWARE_REVISION
     , DDBD.DETAIL_DOCUMENT_NUMBER
     , DDBD.INPUT_DDN
     , DDBD.INPUT_DV
     , DDBD.ENTRY_USERID
     , DDBD.ENTRY_TIMESTAMP
     , DBFE.ERROR_ID
     , DBFE.HBS_EDIT_ERR_CATEGORY_CODE
     , DBFE.HBS_EDIT_ERR_MESSAGE_CODE
     , DBFE.ERROR_TIMESTAMP
     , DBFE.INPUT_SCALE_SITE
     , DBFE.INPUT_DATE
     , DBFE.INPUT_PRIMARY_SCALER_LIC
     , DBFE.INPUT_WEIGH_SLIP_NUMBER
     , DBFE.INPUT_SOURCE
     , DBFE.INPUT_SCALE_EVENT_TYPE
     , DBFE.INPUT_RETURN_NUMBER
     , EEMC.DESCRIPTION
     , EEMC.EFFECTIVE_DATE
     , EEMC.EXPIRY_DATE
     , EEMC.UPDATE_TIMESTAMP
FROM      DTL_DOC_BATCH_DOCUMENT    DDBD
LEFT JOIN DTL_BAT_DOC_FORMAT_ERROR  DBFE ON  DBFE.BATDOC_ID = DDBD.BATDOC_ID
LEFT JOIN HBS_EDIT_ERR_MESSAGE_CODE EEMC ON  EEMC.HBS_EDIT_ERR_CATEGORY_CODE = DBFE.HBS_EDIT_ERR_CATEGORY_CODE
                                         AND EEMC.HBS_EDIT_ERR_MESSAGE_CODE  = DBFE.HBS_EDIT_ERR_MESSAGE_CODE
WHERE  DDBD.DETAIL_DOCUMENT_NUMBER IS NULL
AND    DDBD.BATCH_ID               =  $P{Pm-HBS2R032.BATCH_ID}]]>
	</queryString>
