	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       SSDLE.ERROR_ID
     , SSDLE.HBS_EDIT_ERR_MESSAGE_CODE
     , SSDLE.HBS_EDIT_ERR_CATEGORY_CODE
     , DDBD.DETAIL_DOCUMENT_NUMBER
     , SSDL.VERSION
     , SSDLE.ERROR_TIMESTAMP
     , DDBD.BATDOC_ID
     , SSDL.SCALE_EVENT_TYPE_CODE
     , SSDL.SCL_RTN_VERSION_STATE_CODE
     , SSDL.SCALE_SITE_ID_NMBR
     , SSDL.DEPARTURE_DATE
     , SSDL.TIMBER_MARK
     , SSDL.TIMBER_BRAND
     , SSDL.OUTGOING_TRANSPORT_ID
     , SSDL.ACTIVE_VERSION_IND
     , SSDL.ORIGINAL_VERSION_IND
     , SSDL.VALID_SIGNATURE_IND
     , SSDL.OUTGOING_LDS_NUMBER
     , SSDL.LOAD_DEPARTURE_NUMBER
     , SSDL.DESTINATION
     , SSDL.DTL_DOC_SEQ
     , SSDL.INPUT_SCALE_SITE
     , SSDL.ENTRY_USERID
     , SSDL.ENTRY_TIMESTAMP
     , SSDL.UPDATE_USERID
     , SSDL.UPDATE_TIMESTAMP
     , DDBD.BATCH_ID
     , DDBD.ACCEPTED_IND
     , DDBD.SOFTWARE_PRODUCT
     , DDBD.SOFTWARE_VERSION
     , DDBD.SOFTWARE_REVISION
     , DDBD.INPUT_DDN
     , DDBD.INPUT_DV
     , EEMC.DESCRIPTION
     , EEMC.EFFECTIVE_DATE
     , EEMC.EXPIRY_DATE
FROM      DTL_DOC_BATCH_DOCUMENT    DDBD
LEFT JOIN SCL_SITE_DEPARTURE_LEDGER SSDL  ON  SSDL.BATDOC_ID                  = DDBD.BATDOC_ID
LEFT JOIN SCALE_SITE_DEP_LDGR_ERROR SSDLE ON  SSDLE.DETAIL_DOCUMENT_NUMBER    = SSDL.DETAIL_DOCUMENT_NUMBER
                                          AND SSDLE.VERSION                   = SSDL.VERSION
LEFT JOIN HBS_EDIT_ERR_MESSAGE_CODE EEMC  ON  EEMC.HBS_EDIT_ERR_MESSAGE_CODE  = SSDLE.HBS_EDIT_ERR_MESSAGE_CODE
                                          AND EEMC.HBS_EDIT_ERR_CATEGORY_CODE = SSDLE.HBS_EDIT_ERR_CATEGORY_CODE
WHERE  SSDL.DETAIL_DOCUMENT_NUMBER IS NOT NULL
AND    DDBD.BATCH_ID = $P{Pm-HBS2R033.BATCH_ID}
 ORDER BY
       SSDL.LOAD_DEPARTURE_NUMBER
     , SSDL.VERSION
     , SSDL.DETAIL_DOCUMENT_NUMBER]]>
	</queryString>
