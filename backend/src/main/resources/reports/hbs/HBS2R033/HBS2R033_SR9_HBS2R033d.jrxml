	<variable name="CCF0_Show_PrimaryScaler" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $F{PRIMARY_LICENSE_NUMBER} == null || $F{PRIMARY_LICENSE_NUMBER}.isEmpty()
  ? ( $F{INPUT_PRIMARY_SCALER_LIC} == null || $F{INPUT_PRIMARY_SCALER_LIC}.isEmpty() ? "" : "* " + $F{INPUT_PRIMARY_SCALER_LIC} )
  : $F{PRIMARY_LICENSE_NUMBER}
)]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_TM" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $F{TIMBER_MARK} == null || $F{TIMBER_MARK}.isEmpty()
  ? ( $F{INPUT_SOURCE} == null || $F{INPUT_SOURCE}.isEmpty() ? "" : "* " + $F{INPUT_SOURCE} )
  : $F{TIMBER_MARK}
)]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_PSY" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[(
  $F{POPULATION_NUMBER} == null || $F{POPULATION_NUMBER}.isEmpty() ||
  $F{STRATUM_NUMBER}    == null || $F{STRATUM_NUMBER}.isEmpty()    ||
  $F{SAMPLING_YEAR}     == null
  ? ( $F{INPUT_PSY} == null || $F{INPUT_PSY}.isEmpty() ? "" : "* " + $F{INPUT_PSY} )
  : $F{POPULATION_NUMBER} + " " + $F{STRATUM_NUMBER} + " " + new DecimalFormat("###0").format( $F{SAMPLING_YEAR} )
)]]></variableExpression>
	</variable>
