	<variable name="CCF1_@show_species" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if IsNull ({HBS3R221.SPECIES_DESCR}) then
//'All'
//else if ({HBS3R221.SPECIES_DESCR} = ' ' )then
// 'Error'
//else {HBS3R221.SPECIES_DESCR}

$F{SPECIES_DESCR} == null || $F{SPECIES_DESCR}.isEmpty()? "All":
($F{SPECIES_DESCR}.equalsIgnoreCase( " " )? "Error" :  $F{SPECIES_DESCR})]]></variableExpression>
	</variable>
	<variable name="CCF2_show_grade" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if IsNull ({HBS3R221.SCALE_GRADE_CODE}) then
// 'All'
//else if ({HBS3R221.SCALE_GRADE_CODE} = ' ') then
// 'Ungraded'
//else {HBS3R221.SCALE_GRADE_CODE}

$F{SCALE_GRADE_CODE} == null || $F{SCALE_GRADE_CODE}.isEmpty()? "All":
($F{SCALE_GRADE_CODE}.equalsIgnoreCase( " " )? "Ungraded": $F{SCALE_GRADE_CODE})]]></variableExpression>
	</variable>
	<variable name="CCF3_show_active" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({HBS3R221.ACTIVE_IND} = 'Y') then
// 'Yes'
//else if ({HBS3R221.ACTIVE_IND} = 'N') then
// 'No'
//else {HBS3R221.ACTIVE_IND}

$F{ACTIVE_IND} != null && !$F{ACTIVE_IND}.isEmpty()? ($F{ACTIVE_IND}.equalsIgnoreCase( "Y")? "Yes": ($F{ACTIVE_IND}.equalsIgnoreCase( "N")? "No" : $F{ACTIVE_IND} )):$F{ACTIVE_IND}]]></variableExpression>
	</variable>
