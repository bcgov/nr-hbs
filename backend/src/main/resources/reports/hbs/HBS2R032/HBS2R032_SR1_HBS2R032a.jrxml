	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       DDBD.ACCEPTED_IND,
       DDBD.DETAIL_DOCUMENT_NUMBER,
       DDBD.INPUT_DDN,
       DDBD.INPUT_DV,
       DBDFE.HBS_EDIT_ERR_MESSAGE_CODE,
       HEEMC.DESCRIPTION,
       DBDFE.INPUT_DATE,
       DBDFE.INPUT_PRIMARY_SCALER_LIC,
       DBDFE.INPUT_RETURN_NUMBER,
       DBDFE.INPUT_SOURCE,
       DBDFE.INPUT_SCALE_SITE,
       DBDFE.INPUT_SCALE_EVENT_TYPE
FROM      DTL_DOC_BATCH_DOCUMENT    DDBD
LEFT JOIN DTL_BAT_DOC_FORMAT_ERROR  DBDFE ON  DBDFE.BATDOC_ID = DDBD.BATDOC_ID
LEFT JOIN HBS_EDIT_ERR_MESSAGE_CODE HEEMC ON  HEEMC.HBS_EDIT_ERR_MESSAGE_CODE  = DBDFE.HBS_EDIT_ERR_MESSAGE_CODE
                                          AND HEEMC.HBS_EDIT_ERR_CATEGORY_CODE = DBDFE.HBS_EDIT_ERR_CATEGORY_CODE
WHERE DDBD.ACCEPTED_IND = 'N'
AND   DDBD.BATCH_ID = $P{Pm-HBS2R032.BATCH_ID}]]>
	</queryString>
	<field name="ACCEPTED_IND" class="java.lang.String"/>
	<field name="DETAIL_DOCUMENT_NUMBER" class="java.lang.String"/>
	<field name="INPUT_DDN" class="java.lang.String"/>
	<field name="INPUT_DV" class="java.lang.String"/>
	<field name="HBS_EDIT_ERR_MESSAGE_CODE" class="java.lang.String"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="INPUT_DATE" class="java.lang.String"/>
	<field name="INPUT_PRIMARY_SCALER_LIC" class="java.lang.String"/>
	<field name="INPUT_RETURN_NUMBER" class="java.lang.String"/>
	<field name="INPUT_SOURCE" class="java.lang.String"/>
	<field name="INPUT_SCALE_SITE" class="java.lang.String"/>
	<field name="INPUT_SCALE_EVENT_TYPE" class="java.lang.String"/>
	<sortField name="CCF0_Show_DDN" type="Variable"/>
	<sortField name="INPUT_DV"/>
	<variable name="CCF0_Show_DDN" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL({DTL_DOC_BATCH_DOCUMENT.DETAIL_DOCUMENT_NUMBER}) then
//  {DTL_DOC_BATCH_DOCUMENT.INPUT_DDN}
//ELSE
//  {DTL_DOC_BATCH_DOCUMENT.DETAIL_DOCUMENT_NUMBER}

$F{DETAIL_DOCUMENT_NUMBER} == null || $F{DETAIL_DOCUMENT_NUMBER}.isEmpty()
? $F{INPUT_DDN}
: $F{DETAIL_DOCUMENT_NUMBER}]]></variableExpression>
	</variable>
	<variable name="DistinctCount (@Show_DDN)" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[$V{CCF0_Show_DDN}]]></variableExpression>
	</variable>
