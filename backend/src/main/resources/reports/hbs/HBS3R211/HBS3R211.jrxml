	<variable name="CCF0_Show_AppMethod" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If (uppercase({?PDDR_METHOD}) = 'I' ) then
// 'Interior'
//else if (uppercase({?PDDR_METHOD}) = 'C' ) then
// 'Coastal'
//else
// 'Both'


$P{PDDR_METHOD} == null || $P{PDDR_METHOD}.isEmpty()
? "Both"
  :
  ( $P{PDDR_METHOD}.equalsIgnoreCase( "I" ) ? "Interior"     :
  ( $P{PDDR_METHOD}.equalsIgnoreCase( "C" ) ? "Coastal"    :
                                                          "Both"
  ))]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_Species" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF (isnull({HBS3R211.SPECIES_DESCR}) ) THEN
// 'All'
//ELSE IF (({HBS3R211.SPECIES_DESCR}) = ' ') THEN
// 'Error'
//ELSE
// {HBS3R211.SPECIES_DESCR}


$F{SPECIES_DESCR} == null || $F{SPECIES_DESCR}.isEmpty()
? "All"
  :
  ( $F{SPECIES_DESCR}.equalsIgnoreCase( " " ) ? "Error": $F{SPECIES_DESCR}

  )]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Grade" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If (isnull({HBS3R211.SCALE_GRADE_CODE})) then
// 'All'
//ELSE IF (({HBS3R211.SCALE_GRADE_CODE}) = ' ') THEN
// 'Ungraded'
//else
// {HBS3R211.GRADE_DESCR};


$F{SCALE_GRADE_CODE} == null || $F{SCALE_GRADE_CODE}.isEmpty()
? "All"
  :
  ( $F{SCALE_GRADE_CODE}.equalsIgnoreCase( " " ) ? "Ungraded": $F{GRADE_DESCR}

  )]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_Effective_From_Date" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//DateValue ({?PDDR_START_DATE})


$P{PDDR_START_DATE} == null || $P{PDDR_START_DATE}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{PDDR_START_DATE})]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_Effective_To_Date" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//DateValue ({?PDDR_END_DATE})

$P{PDDR_END_DATE} == null || $P{PDDR_END_DATE}.isEmpty()
? null
: new SimpleDateFormat("yyyy-MM-dd").parse($P{PDDR_END_DATE})]]></variableExpression>
	</variable>
