	<variable name="CCF0_Show_TimberMark" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
//TATA DEVELOPER START OF CHANGE FOR BT1993
//IF ISNULL({HBS2R051.TIMBER_MARK}) THEN
// '* ' + {HBS2R051.INPUT_TIMBER_MARK}
//ELSE
 //{HBS2R051.TIMBER_MARK}

//IF{?PSR_SEARCHBYMARKS}='allmarks' THEN
//'All Marks'
//ELSE IF {?PSR_SEARCHBYMARKS}='singlemark' then
//{?PSR_TIMBERMARK}
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinaregionordistrict' and {?PSR_DISTRICTHARVESTED}="" then
//'In All'
//ELSE IF {?PSR_SEARCHBYMARKS}='marksinassociateddistricts' then
//'Associated Marks'

( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "allmarks"                   )                                        ? "All Marks" :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "singlemark"                 )                                        ? $P{PSR_TIMBERMARK} :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinaregionordistrict"   ) && $P{PSR_DISTRICTHARVESTED}.isEmpty() ? "In All" :
( $P{PSR_SEARCHBYMARKS}.equalsIgnoreCase( "marksinassociateddistricts" )                                        ? "Associated Marks" : "" ))))]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_LicenseNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field
( $F{LICENSE_NUMBER} == null || $F{LICENSE_NUMBER}.isEmpty()
? ( $F{INPUT_SCALER_LICENSE_NUM} == null || $F{INPUT_SCALER_LICENSE_NUM}.isEmpty() ? "" : "* " + $F{INPUT_SCALER_LICENSE_NUM} )
: $F{LICENSE_NUMBER}
)]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_SortBy" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{PSR_ORDERBY}.equalsIgnoreCase( "0" )  ? "Summary Document Number" :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "1" )  ? "Version Status"          :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "3" )  ? "Scale Date"              :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "4" )  ? "Timber Mark"             :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "5" )  ? "Scale Site"              :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "10" ) ? "Scaler Licence"          :
( $P{PSR_ORDERBY}.equalsIgnoreCase( "13" ) ? "Sorted By: Version"      : "Sorted By: Summary Document Number" )))))))]]></variableExpression>
	</variable>
	<variable name="CCF3_show_scalesites" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase ( "allsites" )                   ? "All Sites"        :
( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase ( "singlesite" )                 ? $P{PSR_SCALESITE}  :
( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase ( "sitesinassociateddistricts" ) ? "Associated Sites" :
(($P{PSR_SEARCHBYSITES}.equalsIgnoreCase ( "sitesinaregionordistrict" ) && $P{PSR_DISTRICTSCALED}.isEmpty()) ? "In All" :
( $P{PSR_SEARCHBYSITES}.equalsIgnoreCase ( "associatedsites" )            ? "Associated Sites" : "" )))))]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_FSDeckId" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{PSR_FIELDSCALEDECKID} == null || $P{PSR_FIELDSCALEDECKID}.isEmpty() || $P{PSR_FIELDSCALEDECKID}.equalsIgnoreCase( "99999" )
? ""
: $P{PSR_FIELDSCALEDECKID}]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_Version_Title" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$P{PSR_ACTIVEVERSIONFLAG}.equalsIgnoreCase( "Y" )
? "List of Piece Scale Summary Returns - Current Versions"
: "List of Piece Scale Summary Returns - All Versions"]]></variableExpression>
	</variable>
	<variable name="CCF6_recordCount" class="java.lang.Integer" calculation="Count">
