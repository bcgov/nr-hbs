//  IF {HBS3R461.CATEGORY} = 'A' THEN
//        IF(CStr({#TotalSentToStatements},0)='1')THEN
//            'Sent to ' + {HBS3R461.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToStatements},0)+' Statement'
//        ELSE
//            'Sent to ' + {HBS3R461.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToStatements},0)+' Statements'
//  ELSE
//         IF(CStr({#TotalSentToStatements},0)='1')THEN
//            '            ' + 'Sent to ' + {HBS3R461.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToStatements},0)+' Statement'
//         ELSE
//            '            ' + 'Sent to ' + {HBS3R461.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToStatements},0)+' Statements'


($F{CATEGORY}!=null && $F{CATEGORY}.equalsIgnoreCase( "A" ) ? "Sent to " : "           Sent to " ) +
( $F{CLIENT_NUMBER_PAID_BY} == null || $F{CLIENT_NUMBER_PAID_BY}.isEmpty() ? "" : $F{CLIENT_NUMBER_PAID_BY} ) + " " +
( $F{CLIENT_LOCN_CODE_PAID_BY} == null || $F{CLIENT_LOCN_CODE_PAID_BY}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_PAID_BY} ) +
" Total: " + " "+ ( $V{TotalSentToStatements} == null ? "" : new DecimalFormat("#,##0").format( $V{TotalSentToStatements} ) ) +
($P{RB_TYPE}!=null && $P{RB_TYPE}.equalsIgnoreCase( "WSI" ) ? " Invoice" : " Statement" ) +
($V{TotalSentToStatements} != null && $V{TotalSentToStatements} == 1 ? "" : "s" )]]></variableExpression>
	</variable>
	<variable name="CCF14_Show_CopyToFooter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?RB_TYPE} = 'WSI') THEN
//  IF(Cstr({#TotalCopiedToInvoices},0)='1')THEN
//       'Copied to ' + {HBS3R461.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: ' +'  '+ Cstr({#TotalCopiedToInvoices},0) +' Invoice'
//    ELSE
//        'Copied to ' + {HBS3R461.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: ' +'  '+ Cstr({#TotalCopiedToInvoices},0) +' Invoices'
//ELSE
//    IF(Cstr({#TotalCopiedToInvoices},0)='1')THEN
//        'Copied to ' + {HBS3R461.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: ' +'  '+ Cstr({#TotalCopiedToInvoices},0) +' Statement'
//    ELSE
//        'Copied to ' + {HBS3R461.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R461.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: ' +'  '+ Cstr({#TotalCopiedToInvoices},0) +' Statements'


$P{RB_TYPE}!=null && $P{RB_TYPE}.equalsIgnoreCase( "WSI" )
?
    $V{TotalCopiedToInvoices} != null && $V{TotalCopiedToInvoices} == 1
    ?
        "Copied to " + ( $F{CLIENT_NUMBER_COPIED_TO} == null || $F{CLIENT_NUMBER_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_COPIED_TO} ) +
        " " + ( $F{CLIENT_LOCN_CODE_COPIED_TO} == null || $F{CLIENT_LOCN_CODE_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_COPIED_TO} ) +
        " Total: " + "  " + ( $V{TotalCopiedToInvoices} == null ? "" : new DecimalFormat("#,##0").format( $V{TotalCopiedToInvoices} ) )  + " Invoice"
    :
        "Copied to " + ( $F{CLIENT_NUMBER_COPIED_TO} == null || $F{CLIENT_NUMBER_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_COPIED_TO} ) +
        " " + ( $F{CLIENT_LOCN_CODE_COPIED_TO} == null || $F{CLIENT_LOCN_CODE_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_COPIED_TO} ) +
        " Total: " + "  " + ( $V{TotalCopiedToInvoices} == null ? "" : new DecimalFormat("#,##0").format( $V{TotalCopiedToInvoices} ) )  + " Invoices"
:
    $V{TotalCopiedToInvoices} != null && $V{TotalCopiedToInvoices} == 1
    ?
        "Copied to " + ( $F{CLIENT_NUMBER_COPIED_TO} == null || $F{CLIENT_NUMBER_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_COPIED_TO} ) +
        " " + ( $F{CLIENT_LOCN_CODE_COPIED_TO} == null || $F{CLIENT_LOCN_CODE_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_COPIED_TO} ) +
        " Total: " + "  " + ( $V{TotalCopiedToInvoices} == null ? "" : new DecimalFormat("#,##0").format( $V{TotalCopiedToInvoices} ) )  + " Statement"
    :
        "Copied to " + ( $F{CLIENT_NUMBER_COPIED_TO} == null || $F{CLIENT_NUMBER_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_COPIED_TO} ) +
        " " + ( $F{CLIENT_LOCN_CODE_COPIED_TO} == null || $F{CLIENT_LOCN_CODE_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_COPIED_TO} ) +
        " Total: " + "  " + ( $V{TotalCopiedToInvoices} == null ? "" : new DecimalFormat("#,##0").format( $V{TotalCopiedToInvoices} ) )  + " Statements"]]></variableExpression>
	</variable>
