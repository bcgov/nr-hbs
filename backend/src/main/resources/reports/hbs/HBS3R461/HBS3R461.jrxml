		<variableExpression><![CDATA[//{HBS3R461.POPULATION_NUMBER} + "/" + {HBS3R461.STRATUM_NUMBER} + "/" + ToText ({HBS3R461.SAMPLING_YEAR},0, "")

($F{POPULATION_NUMBER}!=null ? $F{POPULATION_NUMBER} : "")
+ "/" +
($F{STRATUM_NUMBER}!=null ? $F{STRATUM_NUMBER} : "")
+ "/" +
( $F{SAMPLING_YEAR} == null ? "" : new DecimalFormat("###0").format( $F{SAMPLING_YEAR} ) )]]></variableExpression>
