	<variable name="CCF5_PieceNumber" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//select UpperCase ({HBS3R755.HBS_SFP_SCALE_TYPE_CODE})
//   case 'K' : "Stack Number"
//   case 'C' : "Bundle Number"
//   case 'P' : "Bundle Number"
//   case 'L' : "Log No."
//   default: "";

( $F{HBS_SFP_SCALE_TYPE_CODE}.equalsIgnoreCase( "K" ) ? "Stack Number"  :
( $F{HBS_SFP_SCALE_TYPE_CODE}.equalsIgnoreCase( "C" ) ? "Bundle Number" :
( $F{HBS_SFP_SCALE_TYPE_CODE}.equalsIgnoreCase( "P" ) ? "Bundle Number" :
( $F{HBS_SFP_SCALE_TYPE_CODE}.equalsIgnoreCase( "L" ) ? "Log No."       : "" ))))]]></variableExpression>
	</variable>
	<variable name="CCF6_Species_Descr" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If the column is null then it was entered in error so show the unvalidated original entry field

//IF ISNULL({HBS3R755.SCALE_SPECIES_CODE}) THEN
// '* ' + {HBS3R755.INPUT_SPECIES}
//ELSE
// {HBS3R755.SPECIES_DESCRIPTION}

( $F{SCALE_SPECIES_CODE} == null || $F{SCALE_SPECIES_CODE}.isEmpty()
? ( $F{INPUT_SPECIES}       == null || $F{INPUT_SPECIES}.isEmpty()       ? "" : "* " + $F{INPUT_SPECIES} )
: ( $F{SPECIES_DESCRIPTION} == null || $F{SPECIES_DESCRIPTION}.isEmpty() ? "" : $F{SPECIES_DESCRIPTION}  )
)]]></variableExpression>
	</variable>
