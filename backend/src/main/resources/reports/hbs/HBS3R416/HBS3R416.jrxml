	<variable name="CCF1_CpyTo_CityLine" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// This formula has been modified to display the address when Province and Postal Code
//// are null values in BT 13270, 01-Aug-2007
//Local stringVar CpyCityline := '';
//CpyCityline := Trim ({HBS00002.CT_CITY});
//if not isnull({HBS00002.CT_PROVINCE}) AND Trim ({HBS00002.CT_PROVINCE}) <> '' then
//        CpyCityline := CpyCityline + ',  ' + Trim ({HBS00002.CT_PROVINCE})
//else if not isnull({HBS00002.CT_POSTAL_CODE}) AND Trim({HBS00002.CT_POSTAL_CODE}) <> '' then
//        CpyCityline := CpyCityline + ', ';
//IF {HBS00002.CT_COUNTRY} = 'CANADA' THEN
//  (
//    if not isnull({HBS00002.CT_POSTAL_CODE}) AND Trim({HBS00002.CT_POSTAL_CODE}) <> '' then
//       CpyCityline := CpyCityline + ' ' + MID ({HBS00002.CT_POSTAL_CODE},1,3) + ' ' + MID ({HBS00002.CT_POSTAL_CODE},4,3);
//    //Trim ({HBS00002.PB_CITY}) + ',  ' + Trim ({HBS00002.PB_PROVINCE}) + ' ' + MID ({HBS00002.PB_POSTAL_CODE},1,3) + ' ' + MID ({HBS00002.PB_POSTAL_CODE},4,3)
//   )
//ELSE
//  (
//   if not isnull({HBS00002.CT_POSTAL_CODE}) AND Trim ({HBS00002.CT_POSTAL_CODE}) <> '' then
//        CpyCityline := CpyCityline + ' ' + Trim({HBS00002.CT_POSTAL_CODE});
//
//    CpyCityline := CpyCityline + chr(13) + {HBS00002.CT_COUNTRY};
//    //Trim ({HBS00002.PB_CITY}) + ',  ' + Trim ({HBS00002.PB_PROVINCE}) + ' ' + Trim({HBS00002.PB_POSTAL_CODE}) + chr(13) + {HBS00002.PB_COUNTRY};
//   );
//CpyCityline := CpyCityline ;

( $F{CT_CITY} == null || ($F{CT_CITY}.trim()).isEmpty() ? "" : $F{CT_CITY} ) +
( $F{CT_PROVINCE} == null || ($F{CT_PROVINCE}.trim()).isEmpty() ? "" : ", " + $F{CT_PROVINCE} ) +
( $F{CT_POSTAL_CODE} == null || ($F{CT_POSTAL_CODE}.trim()).isEmpty() ? "" : ", " ) +
( $F{CT_COUNTRY}.equalsIgnoreCase( "CANADA" )
? ( $F{CT_POSTAL_CODE} != null && !($F{CT_POSTAL_CODE}.isEmpty()) && $F{CT_POSTAL_CODE}.length() >= 6 ? $F{CT_POSTAL_CODE}.substring( 0, 3 ) + " " + $F{CT_POSTAL_CODE}.substring( 3, 6 ) : "" )
: ( $F{CT_POSTAL_CODE} == null || ($F{CT_POSTAL_CODE}.trim()).isEmpty() ? "" : $F{CT_POSTAL_CODE} ) +
  ( $F{CT_COUNTRY} == null || ($F{CT_COUNTRY}.trim()).isEmpty() ? "" : System.getProperty("line.separator") + $F{CT_COUNTRY} )
)]]></variableExpression>
	</variable>
