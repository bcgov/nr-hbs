	<variable name="CCF5_Hdr_KindofScl" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Invoice Indentification - kind of scale field
( $F{REVENUE_CLASSN_CD}.equalsIgnoreCase( "STP" ) ? "STUMPAGE"      :
( $F{REVENUE_CLASSN_CD}.equalsIgnoreCase( "ROY" ) ? "ROYALTY"       :
( $F{REVENUE_CLASSN_CD}.equalsIgnoreCase( "SRR" ) ? "SBFEP RSRV RT" :
( $F{REVENUE_CLASSN_CD}.equalsIgnoreCase( "NIL" ) ? "NO CHARGE"     : "OTHER"))))]]></variableExpression>
	</variable>
