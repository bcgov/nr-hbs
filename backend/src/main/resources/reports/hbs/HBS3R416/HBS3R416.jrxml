	<variable name="CCF12_PayBy_FormatAddress" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// This formula has been modified to display the address when First name, Middle Name, Location name,
//// Address2 and Address3 are null values in BT 13270, 01-Aug-2007
//
//Local stringVar PayBy := '';
//
////build payable by client address block
//PayBy := {HBS00002.PB_CLIENT_NAME};
//
////nvitshas: fix for issue 261
//
//If {HBS00002.PB_CLIENT_TYPE_CODE} = 'I' Then
//(
//    If not isNull({HBS00002.PB_LEGAL_FIRST_NAME}) AND Trim ({HBS00002.PB_LEGAL_FIRST_NAME}) <> '' Then
//     (
//        PayBy := PayBy + ', ';
//        PayBy := PayBy + Trim ({HBS00002.PB_LEGAL_FIRST_NAME});
//      )
//    else If not isnull({HBS00002.PB_LEGAL_MIDDLE_NAME}) AND Trim ({HBS00002.PB_LEGAL_MIDDLE_NAME}) <> '' then
//        PayBy := PayBy + ', ' ;
//
//    If not isnull({HBS00002.PB_LEGAL_MIDDLE_NAME}) AND Trim ({HBS00002.PB_LEGAL_MIDDLE_NAME}) <> '' Then
//     (
//        PayBy := PayBy + ' ' ;
//        PayBy := PayBy + Trim ({HBS00002.PB_LEGAL_MIDDLE_NAME}) + chr(13);
//      )
//    else
//        PayBy := PayBy + chr(13) ;
//)
//Else
//(
//    If not isnull({HBS00002.PB_CLIENT_LOCN_NAME}) AND Trim ({HBS00002.PB_CLIENT_LOCN_NAME}) <> '' Then
//     (
//        PayBy := PayBy + chr(13);
//        PayBy := PayBy + Trim ({HBS00002.PB_CLIENT_LOCN_NAME}) + chr(13);
//      )
//    else
//        PayBy := PayBy + chr(13);
//);
//
////nvitshas: end fix for issue 261
//
//
////suppress address line 1 if same as location name
//if isNull({HBS00002.PB_CLIENT_LOCN_NAME}) or  (Trim ({HBS00002.PB_ADDRESS_1}) <> Trim ({HBS00002.PB_CLIENT_LOCN_NAME})) then
//    PayBy := PayBy + Trim ({HBS00002.PB_ADDRESS_1}) + chr(13);
//
//If not isnull({HBS00002.PB_ADDRESS_2}) AND Trim ({HBS00002.PB_ADDRESS_2}) <> '' Then
//    PayBy := PayBy + Trim ({HBS00002.PB_ADDRESS_2}) + chr(13);
//
//If not isnull({HBS00002.PB_ADDRESS_3}) AND Trim ({HBS00002.PB_ADDRESS_3}) <> '' Then
//    PayBy := PayBy + Trim ({HBS00002.PB_ADDRESS_3}) + chr(13);
//
//PayBy := PayBy + {@PayBy_CityLine};
//
////first pass removes blank lines
//PayBy := Replace (PayBy,chr(13) + chr(13) ,chr(13));
////second pass removes remaining blank line where first pass reduced 2 blank lines to 1 blank line
//PayBy := Replace (PayBy,chr(13) + chr(13) ,chr(13));
//

( $F{PB_CLIENT_NAME} == null || ($F{PB_CLIENT_NAME}.trim()).isEmpty() ? "" : $F{PB_CLIENT_NAME} ) +
( $F{PB_CLIENT_TYPE_CODE}.equalsIgnoreCase( "I" )
?
  ( ($F{PB_LEGAL_FIRST_NAME}  != null && !(($F{PB_LEGAL_FIRST_NAME}.trim()).isEmpty())) ||
    ($F{PB_LEGAL_MIDDLE_NAME} != null && !(($F{PB_LEGAL_MIDDLE_NAME}.trim()).isEmpty())) ? "," : "" ) +
  (  $F{PB_LEGAL_FIRST_NAME}  != null && !(($F{PB_LEGAL_FIRST_NAME}.trim()).isEmpty())  ? " " + $F{PB_LEGAL_FIRST_NAME}  : "" ) +
  (  $F{PB_LEGAL_MIDDLE_NAME} != null && !(($F{PB_LEGAL_MIDDLE_NAME}.trim()).isEmpty()) ? " " + $F{PB_LEGAL_MIDDLE_NAME} : "" ) +
  ( ($F{PB_LEGAL_FIRST_NAME}  != null && !(($F{PB_LEGAL_FIRST_NAME}.trim()).isEmpty())) ||
    ($F{PB_LEGAL_MIDDLE_NAME} != null && !(($F{PB_LEGAL_MIDDLE_NAME}.trim()).isEmpty())) ? System.getProperty("line.separator") : "" )
:
  ( $F{PB_CLIENT_LOCN_NAME} != null && !(($F{PB_CLIENT_LOCN_NAME}.trim()).isEmpty()) ? System.getProperty("line.separator") + $F{PB_CLIENT_LOCN_NAME}  : "" ) +
  System.getProperty("line.separator")
) +
( ($F{PB_ADDRESS_1} != null && !(($F{PB_ADDRESS_1}.trim()).isEmpty())) &&
  ( $F{PB_CLIENT_LOCN_NAME} == null || $F{PB_ADDRESS_1}.equalsIgnoreCase( $F{PB_CLIENT_LOCN_NAME} ) )
? $F{PB_ADDRESS_1} + System.getProperty("line.separator")
: ""
) +
( ($F{PB_ADDRESS_2} != null && !(($F{PB_ADDRESS_2}.trim()).isEmpty()))
? $F{PB_ADDRESS_2} + System.getProperty("line.separator")
: ""
) +
( ($F{PB_ADDRESS_3} != null && !(($F{PB_ADDRESS_3}.trim()).isEmpty()))
? $F{PB_ADDRESS_3} + System.getProperty("line.separator")
: ""
) +
( $V{CCF8_PayBy_CityLine} == null || $V{CCF8_PayBy_CityLine}.isEmpty() ? "" : $V{CCF8_PayBy_CityLine} )]]></variableExpression>
	</variable>
	<variable name="CCF13_CpyTo_FormatAddress" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// This formula has been modified to display the address when First name, Middle Name, Location name,
