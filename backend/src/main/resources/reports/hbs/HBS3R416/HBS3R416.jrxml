	<pageFooter>
		<band height="85" splitType="Prevent">
			<rectangle radius="6">
				<reportElement uuid="c0c65be5-b29a-4200-ba09-f47f072a3b45" x="414" y="4" width="126" height="22"/>
				<graphicElement>
					<pen lineWidth="1.0" lineStyle="Solid"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement uuid="a6a55fa9-1664-4c93-b236-239b9d3b11fd" x="18" y="48" width="521" height="27" forecolor="#000000"/>
				<textElement textAlignment="Left">
					<font fontName="Arial" size="6" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[NOTICE:	This invoice or a copy of this invoice is being sent to you to notify you that if this invoice is not paid by the licensee (or a party on behalf of the licensee),
				then the Ministry may seek payment from you pursuant to Sections 130 and 131 of the Forest Act.	   Provincial GST registration number: R107864738]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="a250a993-a131-4402-b5be-a00726aec530" x="2" y="4" width="404" height="36" forecolor="#000000"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="6" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[Payable on receipt. This amount will appear on your next Statement of Account. If you do not pay your account in full, then interest will be charged at a prescribed rate on the unpaid Statement balance as at the due date specified on the Statement of Account. Please quote customer account and invoice number with your payment. Please make cheque payable to the Minister of Finance, and make payment to any Ministry of Provincial Revenue office listed on your Forest Statement of Account. All charges on this  invoice are GST exempt unless otherwise indicated.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" pattern="" isBlankWhenNull="true">
				<reportElement uuid="efe3fb96-e1c2-4886-bb83-313014c3f13d" x="458" y="9" width="74" height="12" forecolor="#000000">
					<printWhenExpression><![CDATA[//@NOT [PageNumber <> TotalPageCount]@
true]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="8" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
