( $F{SCND_PER_END_DATE} != null && $F{SCND_PER_END_DATE}.compareTo( (new SimpleDateFormat( "yyyy-MM-dd" )).parse( "9999-12-31" ) ) != 0 &&
  $F{REL_SCND_PER_WGT}  != null && $F{REL_SCND_PER_WGT}.intValue() != 0
? (new SimpleDateFormat("yyyy-MM-dd")).parse( new SimpleDateFormat("yyyy-MM-dd").format( $F{SCND_PER_END_DATE} ) )
: (new SimpleDateFormat("yyyy-MM-dd")).parse( "9999-12-31" )
)]]></variableExpression>
	</variable>
	<variable name="CCF29_Hdr_P4_EndDt" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//if {HBS00002.SCND_PER_END_DATE} <> Date(9999,12,31) and {HBS00002.REL_SCND_PER_WGT} <> 0
//then
//    {HBS00002.SCND_PER_END_DATE}
//else
