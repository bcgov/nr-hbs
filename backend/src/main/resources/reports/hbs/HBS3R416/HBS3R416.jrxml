					<font fontName="Arial" size="6" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[NOTICE:	This invoice or a copy of this invoice is being sent to you to notify you that if this invoice is not paid by the licensee (or a party on behalf of the licensee),
				then the Ministry may seek payment from you pursuant to Sections 130 and 131 of the Forest Act.	   Provincial GST registration number: R107864738]]></text>
