( $F{CT_CLIENT_NAME} == null || ($F{CT_CLIENT_NAME}.trim()).isEmpty() ? "" : $F{CT_CLIENT_NAME} ) +
( $F{CT_CLIENT_TYPE_CODE}.equalsIgnoreCase( "I" )
?
  ( ($F{CT_LEGAL_FIRST_NAME}  != null && !(($F{CT_LEGAL_FIRST_NAME}.trim()).isEmpty())) ||
    ($F{CT_LEGAL_MIDDLE_NAME} != null && !(($F{CT_LEGAL_MIDDLE_NAME}.trim()).isEmpty())) ? "," : "" ) +
  (  $F{CT_LEGAL_FIRST_NAME}  != null && !(($F{CT_LEGAL_FIRST_NAME}.trim()).isEmpty())  ? " " + $F{CT_LEGAL_FIRST_NAME}  : "" ) +
  (  $F{CT_LEGAL_MIDDLE_NAME} != null && !(($F{CT_LEGAL_MIDDLE_NAME}.trim()).isEmpty()) ? " " + $F{CT_LEGAL_MIDDLE_NAME} : "" ) +
  ( ($F{CT_LEGAL_FIRST_NAME}  != null && !(($F{CT_LEGAL_FIRST_NAME}.trim()).isEmpty())) ||
    ($F{CT_LEGAL_MIDDLE_NAME} != null && !(($F{CT_LEGAL_MIDDLE_NAME}.trim()).isEmpty())) ? System.getProperty("line.separator") : "" )
:
  ( $F{CT_CLIENT_LOCN_NAME} != null && !(($F{CT_CLIENT_LOCN_NAME}.trim()).isEmpty()) ? System.getProperty("line.separator") + $F{CT_CLIENT_LOCN_NAME}  : "" ) +
  System.getProperty("line.separator")
) +
( ($F{CT_ADDRESS_1} != null && !(($F{CT_ADDRESS_1}.trim()).isEmpty())) &&
  ( $F{CT_CLIENT_LOCN_NAME} == null || $F{CT_ADDRESS_1}.equalsIgnoreCase( $F{CT_CLIENT_LOCN_NAME} ) )
? $F{CT_ADDRESS_1} + System.getProperty("line.separator")
: ""
) +
( ($F{CT_ADDRESS_2} != null && !(($F{CT_ADDRESS_2}.trim()).isEmpty()))
? $F{CT_ADDRESS_2} + System.getProperty("line.separator")
: ""
) +
( ($F{CT_ADDRESS_3} != null && !(($F{CT_ADDRESS_3}.trim()).isEmpty()))
? $F{CT_ADDRESS_3} + System.getProperty("line.separator")
: ""
) +
( $V{CCF1_CpyTo_CityLine} == null || $V{CCF1_CpyTo_CityLine}.isEmpty() ? "" : $V{CCF1_CpyTo_CityLine} )]]></variableExpression>
	</variable>
	<variable name="CCF7_PayBy_Address" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// All users can see client info if client is a corporation
//// Jan 8th, 2001 Ian Kinnon: There are more types of client than I and C therefore the rule
////                           was changed to allow client info to be seen as long as not an Individual
//IF {HBS00002.PB_CLIENT_TYPE_CODE} <> 'I'
//THEN
//    {@PayBy_FormatAddress}
//ELSE
//    select {HBS00002.USER_USERTYPE}
//// Ministry users can see all client info
//      case  'MOF' : {@PayBy_FormatAddress}
//      case  'CLI' : (
//// Client users can see all of their own invoice info
//                     IF {HBS00002.USER_CLIENTNO} = {HBS00002.PAYABLE_BY_CLIENT}
//                     OR {HBS00002.USER_CLIENTNO} = {HBS00002.COPY_TO_CLIENT}
//                     THEN
//                         {@PayBy_FormatAddress}
//                     ELSE
//                         'NOT RELEASABLE'
//                    )
//    default     :'NOT RELEASABLE';

( !($F{PB_CLIENT_TYPE_CODE}.equalsIgnoreCase( "I" ))
? ( $V{CCF12_PayBy_FormatAddress} == null || $V{CCF12_PayBy_FormatAddress}.isEmpty() ? "" : $V{CCF12_PayBy_FormatAddress} )
: ( $F{USER_USERTYPE}.equalsIgnoreCase( "MOF" )
  ? ( $V{CCF12_PayBy_FormatAddress} == null || $V{CCF12_PayBy_FormatAddress}.isEmpty() ? "" : $V{CCF12_PayBy_FormatAddress} )
  : ( $F{USER_USERTYPE}.equalsIgnoreCase( "CLI" )
    ? ( $F{USER_CLIENTNO}.equalsIgnoreCase( $F{PAYABLE_BY_CLIENT} ) || $F{USER_CLIENTNO}.equalsIgnoreCase( $F{COPY_TO_CLIENT} )
      ? ( $V{CCF12_PayBy_FormatAddress} == null || $V{CCF12_PayBy_FormatAddress}.isEmpty() ? "" : $V{CCF12_PayBy_FormatAddress} )
      : "NOT RELEASABLE"
      )
    : "NOT RELEASABLE"
    )
  )
)]]></variableExpression>
	</variable>
	<variable name="CCF0_CpyTo_Address" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// All users can see client info if client is a corporation
//// Jan 8th, 2001 Ian Kinnon: There are more types of client than I and C therefore the rule
////                           was changed to allow client info to be seen as long as not an Individual
//IF {HBS00002.CT_CLIENT_TYPE_CODE} <> 'I'
//THEN
//    {@CpyTo_FormatAddress}
//ELSE
//    select {HBS00002.USER_USERTYPE}
//// Ministry users can see all client info
//      case  'MOF' : {@CpyTo_FormatAddress}
//      case  'CLI' : (
//// Client users can see all of their own invoice info
//                     IF {HBS00002.USER_CLIENTNO} = {HBS00002.PAYABLE_BY_CLIENT}
//                     OR {HBS00002.USER_CLIENTNO} = {HBS00002.COPY_TO_CLIENT}
//                     THEN
//                         {@CpyTo_FormatAddress}
//                     ELSE
//                         'NOT RELEASABLE'
//                    )
//    default     :'NOT RELEASABLE';

( !($F{CT_CLIENT_TYPE_CODE}.equalsIgnoreCase( "I" ))
? ( $V{CCF13_CpyTo_FormatAddress} == null || $V{CCF13_CpyTo_FormatAddress}.isEmpty() ? "" : $V{CCF13_CpyTo_FormatAddress} )
: ( $F{USER_USERTYPE}.equalsIgnoreCase( "MOF" )
  ? ( $V{CCF13_CpyTo_FormatAddress} == null || $V{CCF13_CpyTo_FormatAddress}.isEmpty() ? "" : $V{CCF13_CpyTo_FormatAddress} )
  : ( $F{USER_USERTYPE}.equalsIgnoreCase( "CLI" )
    ? ( $F{USER_CLIENTNO}.equalsIgnoreCase( $F{PAYABLE_BY_CLIENT} ) || $F{USER_CLIENTNO}.equalsIgnoreCase( $F{COPY_TO_CLIENT} )
      ? ( $V{CCF13_CpyTo_FormatAddress} == null || $V{CCF13_CpyTo_FormatAddress}.isEmpty() ? "" : $V{CCF13_CpyTo_FormatAddress} )
      : "NOT RELEASABLE"
      )
    : "NOT RELEASABLE"
    )
  )
)]]></variableExpression>
	</variable>
	<variable name="CCF14_Hdr_ScaleSite" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA["STATION:  " +
( $F{SCALE_SITE_ID_NMBR} == null || $F{SCALE_SITE_ID_NMBR}.isEmpty() ? "" : $F{SCALE_SITE_ID_NMBR} )
 + " - " +
( $F{SITE_NAME} == null || $F{SITE_NAME}.isEmpty() ? "" : $F{SITE_NAME} )]]></variableExpression>
	</variable>
	<variable name="CCF20_Hdr_P1_Wt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[//if {HBS00002.REL_FST_PER_WGT} = 0
//then
//    {HBS00002.FIRST_PER_TTL_WGT}
//else
//    {HBS00002.REL_FST_PER_WGT}

( $F{REL_FST_PER_WGT} != null && $F{REL_FST_PER_WGT}.intValue() == 0
? ( $F{FIRST_PER_TTL_WGT} != null ? $F{FIRST_PER_TTL_WGT}.intValue() : 0 )
: $F{REL_FST_PER_WGT}.intValue()
)]]></variableExpression>
	</variable>
	<variable name="CCF21_Hdr_P2_EndDt" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[//if {HBS00002.SCND_PER_END_DATE} = Date(9999,12,31)
//then
//    (
//        if {HBS00002.REL_FST_PER_WGT} = 0
//        then
//            {HBS00002.SCND_PER_END_DATE}
//        else
//            {HBS00002.FIRST_PER_END_DATE}
//    )
//else
//    (
//        if {HBS00002.REL_SCND_PER_WGT} = 0
//        then
//            {HBS00002.SCND_PER_END_DATE}
//        else
//            {HBS00002.FIRST_PER_END_DATE}
//    )

( $F{SCND_PER_END_DATE} != null && $F{SCND_PER_END_DATE}.compareTo( (new SimpleDateFormat( "yyyy-MM-dd" )).parse( "9999-12-31" ) ) != 0 &&
  $F{FIRST_PER_END_DATE} != null
? ( $F{REL_SCND_PER_WGT}  != null && $F{REL_SCND_PER_WGT}.intValue() != 0
  ? (new SimpleDateFormat("yyyy-MM-dd")).parse( new SimpleDateFormat("yyyy-MM-dd").format( $F{SCND_PER_END_DATE}  ) )
  : (new SimpleDateFormat("yyyy-MM-dd")).parse( new SimpleDateFormat("yyyy-MM-dd").format( $F{FIRST_PER_END_DATE} ) )
  )
: ( $F{REL_FST_PER_WGT}  != null && $F{REL_FST_PER_WGT}.intValue() != 0
  ? (new SimpleDateFormat("yyyy-MM-dd")).parse( new SimpleDateFormat("yyyy-MM-dd").format( $F{SCND_PER_END_DATE}  ) )
  : (new SimpleDateFormat("yyyy-MM-dd")).parse( new SimpleDateFormat("yyyy-MM-dd").format( $F{FIRST_PER_END_DATE} ) )
  )
)]]></variableExpression>
	</variable>
	<variable name="CCF22_Hdr_P2_Wt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[//if {HBS00002.SCND_PER_END_DATE} = Date(9999,12,31)
//then
//    (
//        if {HBS00002.REL_FST_PER_WGT} <> 0
//        then
//            {HBS00002.FIRST_PER_TTL_WGT}
//        else
//            0
//    )
//else
//    (
//        if {HBS00002.REL_FST_PER_WGT} = 0
//        then
//            {HBS00002.SCND_PER_TTL_WGT}
//        else
//            {HBS00002.FIRST_PER_TTL_WGT}
//    )

( $F{SCND_PER_END_DATE} != null && $F{SCND_PER_END_DATE}.compareTo( (new SimpleDateFormat( "yyyy-MM-dd" )).parse( "9999-12-31" ) ) != 0
? ( $F{REL_FST_PER_WGT} != null && $F{REL_FST_PER_WGT}.intValue() != 0
  ? ( $F{FIRST_PER_TTL_WGT} == null ? 0 : $F{FIRST_PER_TTL_WGT}.intValue() )
  : 0
  )
: ( $F{REL_FST_PER_WGT} != null && $F{REL_FST_PER_WGT}.intValue() != 0
  ? ( $F{SCND_PER_TTL_WGT} == null ? 0 : $F{SCND_PER_TTL_WGT}.intValue() )
  : ( $F{FIRST_PER_TTL_WGT} == null ? 0 : $F{FIRST_PER_TTL_WGT}.intValue() )
  )
)]]></variableExpression>
	</variable>
	<variable name="CCF23_Hdr_P3_Wt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[//if {HBS00002.SCND_PER_END_DATE} <> Date(9999,12,31) and {HBS00002.REL_SCND_PER_WGT} <> 0
//then
//    {HBS00002.REL_SCND_PER_WGT}
//else
//    0

( $F{SCND_PER_END_DATE} != null && $F{SCND_PER_END_DATE}.compareTo( (new SimpleDateFormat( "yyyy-MM-dd" )).parse( "9999-12-31" ) ) != 0 &&
  $F{REL_SCND_PER_WGT}   != null && $F{REL_SCND_PER_WGT}.intValue() != 0
? $F{REL_SCND_PER_WGT}.intValue()
: 0
)]]></variableExpression>
	</variable>
	<variable name="CCF24_Hdr_P4_Wt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[( $F{SCND_PER_END_DATE} != null && $F{SCND_PER_END_DATE}.compareTo( (new SimpleDateFormat( "yyyy-MM-dd" )).parse( "9999-12-31" ) ) != 0 &&
  $F{REL_SCND_PER_WGT}  != null && $F{REL_SCND_PER_WGT}.intValue() != 0
? ( $F{SCND_PER_TTL_WGT} == null ? 0 : $F{SCND_PER_TTL_WGT}.intValue() )
: 0
)]]></variableExpression>
