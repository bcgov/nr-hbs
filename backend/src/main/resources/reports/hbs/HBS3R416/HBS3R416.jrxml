		<variableExpression><![CDATA[( $F{PREVIOUS_INVOICE} == null || $F{PREVIOUS_INVOICE}.isEmpty() || $F{PREVIOUS_INVOICE}.equalsIgnoreCase( " " )
? 0
: ( $F{PREV_YTD_TOTAL_WEIGHT} == null ? 0 : $F{PREV_YTD_TOTAL_WEIGHT}.intValue() )
)]]></variableExpression>
	</variable>
	<variable name="CCF19_Hdr_P1_YTDWt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[( $V{CCF25_Hdr_PrevYTDWt} != null ? $V{CCF25_Hdr_PrevYTDWt} : 0 ) +
( $V{CCF20_Hdr_P1_Wt}     != null ? $V{CCF20_Hdr_P1_Wt}     : 0 )]]></variableExpression>
	</variable>
	<variable name="CCF18_Hdr_P2_YTDWt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[//if {@Hdr_P2_EndDt} <> Date(9999,12,31)
//then
//    {@Hdr_P1_YTDWt} + {@Hdr_P2_Wt}
//else
//    0

$V{CCF21_Hdr_P2_EndDt}.compareTo( (new SimpleDateFormat("dd-MM-yyyy")).parse( "9999-12-31" ) ) != 0
?
    ( $V{CCF19_Hdr_P1_YTDWt} != null ? $V{CCF19_Hdr_P1_YTDWt} : 0 ) + ( $V{CCF22_Hdr_P2_Wt} != null ? $V{CCF22_Hdr_P2_Wt} : 0 )
:
    0]]></variableExpression>
	</variable>
	<variable name="CCF17_Hdr_P3_YTDWt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[( $V{CCF18_Hdr_P2_YTDWt} != null ? $V{CCF18_Hdr_P2_YTDWt} : 0)  +
( $V{CCF23_Hdr_P3_Wt}    != null ? $V{CCF23_Hdr_P3_Wt}    : 0 )]]></variableExpression>
	</variable>
	<variable name="CCF16_Hdr_P4_YTDWt" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[( $V{CCF17_Hdr_P3_YTDWt} != null ? $V{CCF17_Hdr_P3_YTDWt}.intValue() : 0 ) +
( $V{CCF24_Hdr_P4_Wt}    != null ? $V{CCF24_Hdr_P4_Wt}.intValue()    : 0 )]]></variableExpression>
	</variable>
	<variable name="CCF26_Hdr_PSYStratum" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//totext(tonumber({HBS00002.STRATUM}),'00')
$F{STRATUM} == null
? ""
: new DecimalFormat("###0").format( Integer.parseInt( $F{STRATUM} ) )]]></variableExpression>
	</variable>
	<variable name="CCF27_Ftr_MsgText" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF PageNumber = TotalPageCount
//THEN
//    'PAY THIS' + CHR(13) + 'AMOUNT'
//ELSE
