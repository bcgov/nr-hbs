		<defaultValueExpression><![CDATA["HBS00002d"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? "repo:" : "H:\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       WID.INVOICE_NUMBER
     , WID.CANCELLATION_IND
     , WID.HDBS_TREE_SPECIES
     , WID.LOG_GRADE
     , WID.WEIGHT_REF_NUMBER
     , WID.PERIOD_REF_NUMBER
     , WID.NEGATION_IND
     , WID.WEIGHT_X_RATE_YTD
     , WID.SEGREGATION_RATIO
     , WID.RATE_IN_DOLLARS
     , WID.YTD_VOLUME
     , WID.ADDITIONAL_VOLUME
     , WID.YTD_AMOUNT
     , WID.ADDITIONAL_AMOUNT
     , WID.BONUS_AMOUNT
     , WID.DEV_LEVY_AMOUNT
     , WID.SILV_LEVY_AMOUNT
     , WID.ENTRY_TIMESTAMP
     , WID.ENTRY_USERID
     , WID.UPDATE_TIMESTAMP
     , WID.UPDATE_USERID
     , SSC.SCALE_SPECIES_CODE
     , SSC.DESCRIPTION
     , SSC.EFFECTIVE_DATE
     , SSC.EXPIRY_DATE
FROM   WS_INVOICE_DTL WID
JOIN   SCALE_SPECIES_CODE SSC ON SSC.SCALE_SPECIES_CODE = WID.HDBS_TREE_SPECIES
WHERE  WID.INVOICE_NUMBER = $P{Pm-HBS00002.INVOICE_NUMBER}
AND    WID.CANCELLATION_IND = $P{Pm-HBS00002.CANCELLATION_IND}
ORDER BY WID.INVOICE_NUMBER]]>
	</queryString>
