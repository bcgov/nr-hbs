	<variable name="CCF0_dtl_Scale_Species_Desc" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[($F{DESCRIPTION}.toUpperCase()).trim()]]></variableExpression>
	</variable>
	<variable name="CCF1_dtl_sort_order" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[//select {WS_INVOICE_DTL.HDBS_TREE_SPECIES}
//case    'OT': 3
//case    'ZZ': 2
//case    'R' : 2
//default:      1

( $F{HDBS_TREE_SPECIES}.equalsIgnoreCase( "OT" ) ? 3 :
( $F{HDBS_TREE_SPECIES}.equalsIgnoreCase( "ZZ" ) ? 2 :
( $F{HDBS_TREE_SPECIES}.equalsIgnoreCase( "R"  ) ? 2 : 1 )))]]></variableExpression>
	</variable>
	<variable name="v_highest_group0_WEIGHT_REF_NUMBER" class="java.lang.Integer" resetType="Group" resetGroup="Group 0" calculation="Highest">
		<variableExpression><![CDATA[$F{WEIGHT_REF_NUMBER} == null ? 0 : $F{WEIGHT_REF_NUMBER}.intValue()]]></variableExpression>
	</variable>
	<variable name="CCF2_RTCondition1" class="java.lang.Boolean" resetType="None">
		<variableExpression><![CDATA[$F{WEIGHT_REF_NUMBER} != null && $F{WEIGHT_REF_NUMBER}.intValue() == 1]]></variableExpression>
	</variable>
	<variable name="CCF3_RTCondition2" class="java.lang.Boolean" resetType="None">
		<variableExpression><![CDATA[//{WS_INVOICE_DTL.WEIGHT_REF_NUMBER}  = Maximum ({WS_INVOICE_DTL.WEIGHT_REF_NUMBER},{WS_INVOICE_DTL.INVOICE_NUMBER} )

$F{WEIGHT_REF_NUMBER} != null && $V{v_highest_group0_WEIGHT_REF_NUMBER} != null &&
$F{WEIGHT_REF_NUMBER}.intValue() >= $V{v_highest_group0_WEIGHT_REF_NUMBER}]]></variableExpression>
	</variable>
	<variable name="Sum (WS_INVOICE_DTL.ADDITIONAL_VOLUME, WS_INVOICE_DTL.INVOICE_NUMBER)" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Sum">
		<variableExpression><![CDATA[$F{ADDITIONAL_VOLUME}]]></variableExpression>
	</variable>
	<variable name="Sum (WS_INVOICE_DTL.ADDITIONAL_AMOUNT, WS_INVOICE_DTL.INVOICE_NUMBER)" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Sum">
		<variableExpression><![CDATA[$F{ADDITIONAL_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="Maximum (WS_INVOICE_DTL.WEIGHT_REF_NUMBER, WS_INVOICE_DTL.INVOICE_NUMBER)" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Highest">
		<variableExpression><![CDATA[$F{WEIGHT_REF_NUMBER}]]></variableExpression>
	</variable>
	<variable name="RTotal_Ratio" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Sum">
		<variableExpression><![CDATA[$V{CCF2_RTCondition1} ? $F{SEGREGATION_RATIO} : null]]></variableExpression>
	</variable>
	<variable name="RTotal_YTD_Volume" class="java.math.BigDecimal" resetType="Group" resetGroup="Group 0" calculation="Sum">
		<variableExpression><![CDATA[$V{CCF3_RTCondition2} ? $F{YTD_VOLUME} : null]]></variableExpression>
	</variable>
