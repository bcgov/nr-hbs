	<field name="SMP_TARGET_PRECISION_CALC" class="java.math.BigDecimal"/>
	<variable name="Sum (HBS3R888.OPTIMUM_SAMPLE_CALC)" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{OPTIMUM_SAMPLE_CALC}]]></variableExpression>
	</variable>
	<variable name="Sum (HBS3R888.TARGET_SAMPLE_CALC)" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TARGET_SAMPLE_CALC}]]></variableExpression>
	</variable>
	<variable name="CCF0_Tot_Opt_Freq" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R888.OPTIMUM_SAMPLE_CALC} = 0 then 0
//else TRUNCATE({HBS3R888.ESTIMATED_TOTAL_LOADS} / Sum ({HBS3R888.OPTIMUM_SAMPLE_CALC}));

$F{OPTIMUM_SAMPLE_CALC}==null || $F{OPTIMUM_SAMPLE_CALC}.intValue() == 0
? 0
: $F{ESTIMATED_TOTAL_LOADS}.doubleValue() / $V{Sum (HBS3R888.OPTIMUM_SAMPLE_CALC)}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="CCF1_Tot_Target_Freq" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R888.TARGET_SAMPLE_CALC} = 0 then 0
//else TRUNCATE({HBS3R888.ESTIMATED_TOTAL_LOADS} / Sum ({HBS3R888.TARGET_SAMPLE_CALC}));

$F{TARGET_SAMPLE_CALC} == null || $F{TARGET_SAMPLE_CALC}.intValue() == 0
? 0
: $F{ESTIMATED_TOTAL_LOADS}.doubleValue() / $V{Sum (HBS3R888.TARGET_SAMPLE_CALC)}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="CCF2_Constraint_Mode" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R888.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'D' THEN
//    'N/A'
//ELSE
//    if {HBS3R888.CURRENT_CONSTRAINT_TYPE} = 'P' then
//        'Constrain Precision'
//    else if {HBS3R888.CURRENT_CONSTRAINT_TYPE} = 'S' then
//        'Constrain Samples';


$F{SAMPLING_PLAN_RATIO_TYPE_CODE}!=null && $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "D" )
?  "N/A"
:  $F{CURRENT_CONSTRAINT_TYPE}!=null
   ?
        ($F{CURRENT_CONSTRAINT_TYPE}.equalsIgnoreCase( "P" ) ? "Constrain Precision" :
        ($F{CURRENT_CONSTRAINT_TYPE}.equalsIgnoreCase( "S" ) ? "Constrain Samples" : " "
                ))
   : " "]]></variableExpression>
	</variable>
	<variable name="CCF3_Estimate_Mode" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R888.CURRENT_ESTIMATE_TYPE} = 'LS' then
//    'Loads and Size'
//else if {HBS3R888.CURRENT_ESTIMATE_TYPE} = 'VL' then
//    'Volume and Loads'
//else if {HBS3R888.CURRENT_ESTIMATE_TYPE} = 'VS' then
//    'Volume and Size';

$F{CURRENT_ESTIMATE_TYPE}!=null
?
    ($F{CURRENT_ESTIMATE_TYPE}.equalsIgnoreCase( "LS" ) ? "Loads and Size" :
    ($F{CURRENT_ESTIMATE_TYPE}.equalsIgnoreCase( "VL" ) ? "Volume and Loads" :
    ($F{CURRENT_ESTIMATE_TYPE}.equalsIgnoreCase( "VS" ) ? "Volume and Size" : " "
     )))
: " "]]></variableExpression>
	</variable>
	<variable name="CCF4_Precision" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R888.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'S' THEN
//    CStr ({HBS3R888.PRECISION_LIMIT})+ '%'
//ELSE
//    'N/A';

$F{SAMPLING_PLAN_RATIO_TYPE_CODE}!=null && $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "S" )
? String.format("%.2f", $F{PRECISION_LIMIT}) + "%"
: "N/A"]]></variableExpression>
	</variable>
	<variable name="CCF5_Sample_floor" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R888.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'S' THEN
//    CStr ({HBS3R888.SAMPLE_FLOOR},"#")
//ELSE
//    'N/A';


$F{SAMPLING_PLAN_RATIO_TYPE_CODE}!=null && $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "S" )
? $F{SAMPLE_FLOOR}.toString()
: "N/A"]]></variableExpression>
	</variable>
	<variable name="CCF6_Sampling_year" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//cStr({HBS3R888.SAMPLING_YEAR},"#")

$F{SAMPLING_YEAR}.toString()]]></variableExpression>
	</variable>
	<variable name="CCF7_Ratio_Type_code" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R888.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'S' then
//    'Sample-based'
//else if {HBS3R888.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'D' then
//    'Default'


$F{SAMPLING_PLAN_RATIO_TYPE_CODE}!=null
?
    ($F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "S" ) ? "Sample-based"  :
    ($F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "D" ) ? "Default"  : " "
     ))
: " "]]></variableExpression>
	</variable>
	<variable name="CCF8_Client_No_Loc" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R888.STRATUM_PLAN_CLIENT_NO}+"-"+{HBS3R888.STRATUM_PLAN_CLIENT_LOCN_CODE}

$F{STRATUM_PLAN_CLIENT_NO}!=null        ? $F{STRATUM_PLAN_CLIENT_NO}.toString()    +
($F{STRATUM_PLAN_CLIENT_LOCN_CODE}!=null ? "-" + $F{STRATUM_PLAN_CLIENT_LOCN_CODE}.toString()     : "")
 : ""]]></variableExpression>
	</variable>
