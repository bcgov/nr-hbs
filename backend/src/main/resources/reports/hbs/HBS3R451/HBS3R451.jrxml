	</variable>
	<variable name="CCF3_Show_BilledToFooter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?RB_TYPE} = 'PSI') THEN
//
//  IF {HBS3R451.CATEGORY} = 'A' THEN
//        IF(CStr({#TotalSentToInvoices},0)='1')THEN
//             'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Invoice'
//        ELSE
//             'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Invoices'
//  ELSE
//        IF(CStr({#TotalSentToInvoices},0)='1')THEN
//            '           ' + 'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Invoice'
//        ELSE
//            '           ' + 'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Invoices'
//
//ELSE
//
//  IF {HBS3R451.CATEGORY} = 'A' THEN
//      IF(CStr({#TotalSentToInvoices},0)='1')THEN
//           'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Statement'
//      ELSE
//           'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Statements'
//  ELSE
//     IF(CStr({#TotalSentToInvoices},0)='1')THEN
//         '            ' + 'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Statement'
//     ELSE
//     '            ' + 'Sent to ' + {HBS3R451.CLIENT_NUMBER_PAID_BY} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_PAID_BY} + ' Total: '+'  '+ CStr({#TotalSentToInvoices},0) +' Statements'
//

( $F{CATEGORY} != null && $F{CATEGORY}.equalsIgnoreCase( "A" ) ? "" : "            " ) +
"Sent to " +
( $F{CLIENT_NUMBER_PAID_BY} == null || $F{CLIENT_NUMBER_PAID_BY}.isEmpty() ? "" : $F{CLIENT_NUMBER_PAID_BY} ) +
" " +
( $F{CLIENT_LOCN_CODE_PAID_BY} == null || $F{CLIENT_LOCN_CODE_PAID_BY}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_PAID_BY} ) +
" Total: " +
( $V{TotalSentToInvoices} == null ? "" : new DecimalFormat("###0").format( $V{TotalSentToInvoices} ) ) +
( $P{RB_TYPE}.equalsIgnoreCase( "PSI" ) ? " Invoice" : " Statement" ) +
( $V{TotalSentToInvoices} == null || $V{TotalSentToInvoices} == 1 ? "" : "s" )]]></variableExpression>
	</variable>
	<variable name="CCF13_Show_CopyToFooter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?RB_TYPE} = 'PSI') THEN
//    IF(CStr({#TotalCopiedToInvoices},0)='1')THEN
//        'Copied to ' + {HBS3R451.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: '+'  '+ CStr({#TotalCopiedToInvoices},0)+ ' Invoice'
//        ELSE
//        'Copied to ' + {HBS3R451.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: '+'  '+ CStr({#TotalCopiedToInvoices},0)+ ' Invoices'
//ELSE
//    IF(CStr({#TotalCopiedToInvoices},0)='1')THEN
//        'Copied to ' + {HBS3R451.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: '+'  '+ CStr({#TotalCopiedToInvoices},0)+ ' Statement'
//    ELSE
//        'Copied to ' + {HBS3R451.CLIENT_NUMBER_COPIED_TO} + ' ' + {HBS3R451.CLIENT_LOCN_CODE_COPIED_TO} + ' Total: '+'  '+ CStr({#TotalCopiedToInvoices},0)+ ' Statements'

"Copied to " +
( $F{CLIENT_NUMBER_COPIED_TO} == null || $F{CLIENT_NUMBER_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_NUMBER_COPIED_TO} ) +
" " +
( $F{CLIENT_LOCN_CODE_COPIED_TO} == null || $F{CLIENT_LOCN_CODE_COPIED_TO}.isEmpty() ? "" : $F{CLIENT_LOCN_CODE_COPIED_TO} ) +
" Total: " +
( $V{TotalCopiedToInvoices} == null ? "" : new DecimalFormat("###0").format( $V{TotalCopiedToInvoices} ) ) +
( $P{RB_TYPE} != null && $P{RB_TYPE}.equalsIgnoreCase( "PSI" ) ? " Invoice" : " Statement" ) +
( $V{TotalCopiedToInvoices} == null || $V{TotalCopiedToInvoices} == 1 ? "" : "s" )]]></variableExpression>
	</variable>
