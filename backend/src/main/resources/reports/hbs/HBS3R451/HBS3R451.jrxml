( $F{CATEGORY} == null || $F{CATEGORY}.isEmpty() ? "" : $F{CATEGORY} )]]></variableExpression>
	</variable>
	<variable name="v_previous_CATEGORY" class="java.lang.String">
		<variableExpression><![CDATA[( $V{v_current_CATEGORY} == null || $V{v_current_CATEGORY}.isEmpty() ? "" : $V{v_current_CATEGORY} )]]></variableExpression>
	</variable>
	<variable name="v_current_CATEGORY" class="java.lang.String">
		<variableExpression><![CDATA[( $F{CATEGORY} == null || $F{CATEGORY}.isEmpty() ? "" : $F{CATEGORY} )]]></variableExpression>
	</variable>
	<variable name="v_previous_CLIENTPC" class="java.lang.String">
		<variableExpression><![CDATA[( $V{v_current_CLIENTPC} == null || $V{v_current_CLIENTPC}.isEmpty() ? "" : $V{v_current_CLIENTPC} )]]></variableExpression>
	</variable>
	<variable name="v_current_CLIENTPC" class="java.lang.String">
		<variableExpression><![CDATA[( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty() ? "" : $F{CLIENTPC} )]]></variableExpression>
	</variable>
	<variable name="CCF0_Show_CopyToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// determine whether to show the 'invoice copied to' or 'vol stmnt copied to' message then
//// determine whether this is a correct group header situation to show the copied to message
//stringVar copytoMsg := '';
//
//IF ({?RB_TYPE} = "PSI") THEN
//(
//  copytoMsg := "Invoices Copied to: " + left({HBS3R451.CLIENTPC}, 8) + " " + right({HBS3R451.CLIENTPC}, 2) + "   " + {HBS3R451.CLIENT_NAME}
//)
//ELSE
//(
//  copytoMsg := "Volume Statements Copied to: " + left({HBS3R451.CLIENTPC}, 8) + " " + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//);
//
//IF (OnFirstRecord and {HBS3R451.CATEGORY} = "B") THEN
//   copytoMsg
//ELSE IF ({HBS3R451.CATEGORY} = "B" AND Previous({HBS3R451.CATEGORY}) = "A") THEN
//   copytoMsg
//ELSE IF (({HBS3R451.CATEGORY} = "B") AND ({HBS3R451.CLIENTPC} <> Previous({HBS3R451.CLIENTPC}))) THEN
//   copytoMsg
//
//ELSE
// ""


( ($V{REPORT_COUNT} == 0 && $F{CATEGORY} != null && !($F{CATEGORY}.isEmpty()) && $F{CATEGORY}.equalsIgnoreCase( "B" )) ||
  ( $F{CATEGORY}  != null && !($F{CATEGORY}.isEmpty())  &&  $F{CATEGORY}.equalsIgnoreCase( "B" ) &&
    $V{v_previous_CATEGORY} != null && !($V{v_previous_CATEGORY}.isEmpty()) &&  $V{v_previous_CATEGORY}.equalsIgnoreCase( "A" )) ||
  ( $F{CATEGORY}  != null && !($F{CATEGORY}.isEmpty())  && $F{CATEGORY}.equalsIgnoreCase( "B" ) &&
      (( $F{CLIENTPC} == null && $V{v_previous_CLIENTPC} != null ) ||
       ( $F{CLIENTPC} != null && $V{v_previous_CLIENTPC} == null ) ||
       ( $F{CLIENTPC} != null && !($F{CLIENTPC}.isEmpty()) && !($F{CLIENTPC}.equalsIgnoreCase( $V{v_previous_CLIENTPC} )) )
      )
  )
?
  ( $P{RB_TYPE} != null && !($P{RB_TYPE}.isEmpty()) && $P{RB_TYPE}.equalsIgnoreCase( "PSI" ) ? "Invoices Copied to: " : "Volume Statements Copied to: " ) +
  ( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty()
     ? ""
     : ( $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : $F{CLIENTPC} )
  ) +
  " " +
  ( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty()
     ? ""
     : ( $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : $F{CLIENTPC} )
  ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )
: ""
)]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_BilledToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R451.CATEGORY} = 'A' then
//  IF {?RB_TYPE} = 'PSI' THEN
//    'Invoices Sent to: ' + left({HBS3R451.CLIENTPC}, 8) + ' ' + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//  ELSE
//    'Volume Statements Sent to: ' + left({HBS3R451.CLIENTPC}, 8) + ' ' + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//ELSE
// ''

(  $F{CATEGORY} != null &&  !($F{CATEGORY}.isEmpty()) && $F{CATEGORY}.equalsIgnoreCase( "A" )
? ( $P{RB_TYPE} != null && !($P{RB_TYPE}.isEmpty()) && $P{RB_TYPE}.equalsIgnoreCase( "PSI" )
  ? "Invoices Sent to: "
  : "Volume Statements Sent to: "
  ) +
  ( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty()
     ? ""
     : ( $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : $F{CLIENTPC} )
  ) +
  " " +
  ( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty()
     ? ""
     : ( $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : $F{CLIENTPC} )
  ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )
: ""
)]]></variableExpression>
	</variable>
	<variable name="CCF2_Show_Heading" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[( $P{RB_TYPE} != null && $P{RB_TYPE}.equalsIgnoreCase( "PSI" )
? "Piece Scale Invoice Register"
: "Piece Scale Volume Statement Register"
)]]></variableExpression>
	</variable>
	<variable name="CCF4_Show_ScaleDateFrom" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//LEFT({?RB_SCALE_DATE_FROM}, 10)

( $P{RB_SCALE_DATE_FROM} != null && !($P{RB_SCALE_DATE_FROM}.isEmpty())
   ?( $P{RB_SCALE_DATE_FROM}.length()>= 10
         ?$P{RB_SCALE_DATE_FROM}.substring( 0, 10 ): $P{RB_SCALE_DATE_FROM}
    )
   : ""
)]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_ScaleDateTo" class="java.lang.String" resetType="None">
