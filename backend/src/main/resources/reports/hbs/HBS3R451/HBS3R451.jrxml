					<reportElement uuid="061731f3-05be-482a-9430-e0b9376e8d48" x="1" y="1" width="710" height="13" isRemoveLineWhenBlank="true" forecolor="#000000">
						<printWhenExpression><![CDATA[$F{CATEGORY} != null &&  !($F{CATEGORY}.isEmpty()) && $F{CATEGORY}.equalsIgnoreCase( "A" )]]></printWhenExpression>
					</reportElement>
					<textElement>
						<font fontName="Arial" size="10" isBold="true" isItalic="false" isUnderline="true" isStrikeThrough="false"/>
					</textElement>
					<textFieldExpression><![CDATA[//$V{CCF1_Show_BilledToHeader}
//IF {HBS3R451.CATEGORY} = 'A' then
//  IF {?RB_TYPE} = 'PSI' THEN
//    'Invoices Sent to: ' + left({HBS3R451.CLIENTPC}, 8) + ' ' + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//  ELSE
//    'Volume Statements Sent to: ' + left({HBS3R451.CLIENTPC}, 8) + ' ' + right({HBS3R451.CLIENTPC}, 2) + '   ' + {HBS3R451.CLIENT_NAME}
//ELSE
// ''

  ( $P{RB_TYPE} != null && !($P{RB_TYPE}.isEmpty()) && $P{RB_TYPE}.equalsIgnoreCase( "PSI" )
  ? "Invoices Sent to: "
  : "Volume Statements Sent to: "
  ) +
  ( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty()
     ? ""
     : ( $F{CLIENTPC}.length() >= 8 ? $F{CLIENTPC}.substring( 0 , 8 ) : $F{CLIENTPC} )
  ) +
  " " +
  ( $F{CLIENTPC} == null || $F{CLIENTPC}.isEmpty()
     ? ""
     : ( $F{CLIENTPC}.length() >= 10 ? $F{CLIENTPC}.substring( 8 ) : $F{CLIENTPC} )
  ) +
  "   " +
  ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )]]></textFieldExpression>
