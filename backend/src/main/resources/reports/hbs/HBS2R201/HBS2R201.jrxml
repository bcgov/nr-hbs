	<variable name="CCF0_Show_Ovr_Rate_Date" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL({HBS2R201.OVERRIDE_RATE_DATE}) THEN
//  'None'
//ELSE
//  ToText({HBS2R201.OVERRIDE_RATE_DATE}, 'yyyy-MMM-dd')



$F{OVERRIDE_RATE_DATE} != null
?  new SimpleDateFormat("yyyy-MMM-dd").format($F{OVERRIDE_RATE_DATE})
: "None"]]></variableExpression>
	</variable>
	<variable name="CCF1_Show_Species" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF isnull({HBS2R201.SPECIES_DESC}) and (not isnull({HBS2R201.PRODUCT_DESC})) then
// "All"
//else
// {HBS2R201.SPECIES_DESC}


($F{SPECIES_DESC} == null || $F{SPECIES_DESC}.isEmpty()) && $F{PRODUCT_DESC} != null && !($F{PRODUCT_DESC}.isEmpty())
? "All"
: $F{SPECIES_DESC}]]></variableExpression>
	</variable>
