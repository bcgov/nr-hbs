	<variable name="Unused_CCF0_Show_CopyToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[// If this is the first copied to section for the client (i.e. we have jsut finished printing his billed to section)
// of this is a completely new client then print the copied heading again
//if pagenumber = 1 AND {HBS3R476.CATEGORY} <> 'A' then
//  'Statements Copied to: ' + left({HBS3R476.CLIENTPC}, 8) + ' ' + right({HBS3R476.CLIENTPC}, 2) + '   ' + {HBS3R476.CLIENT_NAME}
//ELSE IF (({HBS3R476.CATEGORY} = "B") AND (Previous ({HBS3R476.CATEGORY}) = "A"))
//          OR ({HBS3R476.CLIENTPC} <> Previous({HBS3R476.CLIENTPC}) and ({HBS3R476.CATEGORY} = "B")) THEN
//       'Statements Copied to: ' + left({HBS3R476.CLIENTPC}, 8) + ' ' + right({HBS3R476.CLIENTPC}, 2) + '   ' + {HBS3R476.CLIENT_NAME}
//ELSE
// '';




        " "]]></variableExpression>
	</variable>
	<variable name="Unused_CCF1_Show_BilledToHeader" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If {HBS3R476.CATEGORY} = 'A' THEN
//     'Statements Sent to: ' + left({HBS3R476.CLIENTPC}, 8) + ' ' + right({HBS3R476.CLIENTPC}, 2) + '   ' + {HBS3R476.CLIENT_NAME}
//ELSE
// ''

" "]]></variableExpression>
	</variable>
	<variable name="Unused_CCF2_Show_Heading" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ({?RB_TYPE} = 'PSI') THEN
// 'Weight Scale Invoice Register'
//ELSE
// 'Weight Scale Volume Statement Register'
" "]]></variableExpression>
	</variable>
	<variable name="CCF3_Show_PopStratYr" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R476.POPULATION_NUMBER} + "/" + {HBS3R476.STRATUM_NUMBER} + "/" + totext({HBS3R476.SAMPLING_YEAR},0,'')

($F{POPULATION_NUMBER} !=null ? $F{POPULATION_NUMBER} : "" )
+ "/" +
($F{STRATUM_NUMBER} !=null ? $F{STRATUM_NUMBER} : "" )
+ "/" +
($F{SAMPLING_YEAR} !=null ? $F{SAMPLING_YEAR} : "" )]]></variableExpression>
	</variable>
	<variable name="CCF4_PayByClientNumLoc" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R476.CLIENT_NUMBER_SEND_TO} + {HBS3R476.CLIENT_LOCN_CODE_SEND_TO}

($F{CLIENT_NUMBER_SEND_TO}!=null ? $F{CLIENT_NUMBER_SEND_TO} : "")
+
($F{CLIENT_LOCN_CODE_SEND_TO}!=null ? $F{CLIENT_LOCN_CODE_SEND_TO} : "")]]></variableExpression>
	</variable>
	<variable name="CCF5_Show_Sentto_detail" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{HBS3R476.CLIENT_NUMBER_SEND_TO} + " " + {HBS3R476.CLIENT_LOCN_CODE_SEND_TO}

($F{CLIENT_NUMBER_SEND_TO} !=null ? $F{CLIENT_NUMBER_SEND_TO} : "")
+ " " +
($F{CLIENT_LOCN_CODE_SEND_TO} !=null ? $F{CLIENT_LOCN_CODE_SEND_TO} : "")]]></variableExpression>
	</variable>
