	<queryString>
		<![CDATA[SELECT
       WSST.TRX_ID
     , WSST.INVOICE_NUMBER
     , WSST.CANCELLATION_IND
     , WSST.BATCH_ID
     , WSST.HBS_TXN_STATUS_CODE
     , WSST.TALLY_SKEY
     , WSST.OVERRIDE_RATING_RULE_ID
     , WSST.HBS_TXN_TYPE_CODE
     , WSST.VERSION
     , WSST.DOCUMENT_CONTROL_NUMBER
     , WSST.SMRYRETTXN_COMMENT
     , WSST.EVENT_SEQUENCE
     , WSST.DEBIT_CREDIT_TYPE
     , WSST.INTEREST_REVERSAL_IND
     , WSST.CLIENT_NUMBER_PAID_BY
     , WSST.CLIENT_LOCN_CODE_PAID_BY
     , WSST.CLIENT_NUMBER_COPIED_TO
     , WSST.CLIENT_LOCN_CODE_COPIED_TO
     , WSST.RATIO_STATEMENT_NUMBER
     , WSST.ENTRY_USERID
     , WSST.ENTRY_TIMESTAMP
     , WSST.UPDATE_USERID
     , WSST.UPDATE_TIMESTAMP
     , WSTS.TXN_SEG_ID
     , WSTS.SCALE_SPECIES_CODE
     , WSTS.SCALE_PRODUCT_CODE
     , WSTS.SCALE_GRADE_CODE
     , WSTS.VOLUME
     , WSTS.VALUE
     , WSTS.RATE
     , WSTS.RATIO
     , WSTS.WEIGHT_X_RATE
     , WSTS.OVERRIDE_RATE_ID
     , WSTS.RATE_SOURCE
     , WSTS.RESERVE_STMPG_RATE_COMPONENT
     , WSTS.BONUS_BID_RATE_COMPONENT
     , WSTS.DEV_LEVY_RATE_COMPONENT
     , WSTS.SILV_LEVY_RATE_COMPONENT
     , WSTS.RESERVE_STMPG_AMOUNT_COMPONENT
     , WSTS.BONUS_BID_AMOUNT_COMPONENT
     , WSTS.DEV_LEVY_AMOUNT_COMPONENT
     , WSTS.SILV_LEVY_AMOUNT_COMPONENT
     , ORRR.OVRRDRTRL_TYPE
     , ORRR.TIMBER_MARK
     , ORRR.FIELD_SCALE_DECK_ID
     , ORRR.OVERRIDE_RULE_CATEGORY_CODE
     , ORRR.OVERRIDE_RULE_STATUS_CODE
     , ORRR.OVRRDRTRL_COMMENT
     , ORRR.PROCESSING_EFFECTIVE_DATE
     , ORRR.PROCESSING_EXPIRY_DATE
     , ORRR.SCALE_EFFECTIVE_DATE
     , ORRR.SCALE_EXPIRY_DATE
     , ORRR.OVERRIDE_RATE_DATE
     , FINV.PAYABLE_BY_CLIENT
     , FINV.PAYABLE_BY_CLI_LOC
     , FINV.INVOICE_AMOUNT
     , FINV.INVOICE_CLASS_CODE
     , FINV.INVOICE_DATE
     , FINV.INVOICE_TYPE_CODE
     , FINV.INVC_SUB_TYPE_CODE
     , FINV.CANCELLED_BY_INVC
     , FINV.ORG_UNIT_NO
     , FINV.RELATED_INVOICE
     , FINV.INVOICE_RLN_TYP_CD
     , FINV.REL_INVOICE_STS_ST
     , FINV.REPLACED_BY_INVC
     , FINV.SCALE_RETURN_DATE
     , FINV.SCALE_SITE_ID_NMBR
     , FINV.SCALER_LICENCE_NUM
     , FINV.VOLUME_ONLY_IND
     , FINV.COPY_TO_CLIENT
     , FINV.COPY_TO_CLI_LOC
     , FINV.POSTED_DATE
     , FINV.POSTED_SEQUENCE_NO
     , FINV.SCALED_AT
     , HTTC.DESCRIPTION
     , HTTC.EFFECTIVE_DATE
     , HTTC.EXPIRY_DATE
     , HOBT.HBS_RETURN_TYPE_CODE
     , HOBT.TRANSMISSION_ID
     , HOBT.OUTPUT_BATCH_STATUS_CODE
     , HOBT.RETURN_COUNT
     , HOBT.SENT_DATE_TIME
     , HOBT.RECORD_COUNT
     , HOBT.SENT_IND
     , HOBT.RECONCILED_TXN_COUNT
FROM      WEIGHT_SCL_SMRY_TXN        WSST
LEFT JOIN WEIGHT_SCL_TXN_SEGREGATION WSTS ON  WSTS.TRX_ID                  = WSST.TRX_ID
                                          AND WSTS.DOCUMENT_CONTROL_NUMBER = WSST.DOCUMENT_CONTROL_NUMBER
                                          AND WSTS.VERSION                 = WSST.VERSION
LEFT JOIN OVERRIDE_RATING_RULE       ORRR ON  ORRR.OVERRIDE_RATING_RULE_ID = WSST.OVERRIDE_RATING_RULE_ID
LEFT JOIN FOREST_INVOICE             FINV ON  FINV.INVOICE_NUMBER          = WSST.INVOICE_NUMBER
                                          AND FINV.CANCELLATION_IND        = WSST.CANCELLATION_IND
LEFT JOIN HBS_TXN_TYPE_CODE          HTTC ON  HTTC.HBS_TXN_TYPE_CODE       = WSST.HBS_TXN_TYPE_CODE
LEFT JOIN HBS_OUTPUT_BATCH           HOBT ON  HOBT.BATCH_ID                = WSST.BATCH_ID
WHERE  WSST.DOCUMENT_CONTROL_NUMBER = $P{Pm-HBS2R102.DOCUMENT_CONTROL_NUMBER}
ORDER BY WSST.EVENT_SEQUENCE]]>
	</queryString>
