RB_ASSESSED_TO => $P{RB_ASSESSED_TO},
RB_SEARCH_BY => $P{RB_SEARCH_BY},
RB_PRIMARY_LICENSE => $P{RB_PRIMARY_LICENSE},
RB_USER_ID => $P{RB_USER_ID},
RB_SCALE_SITE => $P{RB_SCALE_SITE},
