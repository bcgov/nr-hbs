	<variable name="CCF6_MissingReturn" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//displayMissingRange({HBS2R912.RETURN_NUMBER},{HBS2R912.GAPCOUNT})

//Function (numbervar returnNumber,numbervar gapCount )
    //numberVar firstMissingReturn := returnNumber - gapCount ;   //first missing return
    //numberVar lastMissingReturn  := returnNumber - 1 ;      //last  missing return

    //stringVar strFirstMissing := TOTEXT(firstMissingReturn,"#######");
    //stringVar strLastMissing  := TOTEXT(lastMissingReturn ,"#######");
//IF      gapcount>1 THEN
//       TRIM(strFirstMissing) + " - " + TRIM(strLastMissing)
//ELSE
//        strLastMissing


$F{GAPCOUNT} !=null && ($F{GAPCOUNT}).intValue() >1
?
    String.valueOf($F{RETURN_NUMBER}.intValue() - $F{GAPCOUNT}.intValue()) + " - " + String.valueOf($F{RETURN_NUMBER}.intValue() - 1 )
:
    String.valueOf( $F{RETURN_NUMBER}.intValue() - 1)]]></variableExpression>
	</variable>
	<variable name="CCF7_show_anomalystatus" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?RB_ANOMALY_STATUS}='' THEN
