	</parameter>
	<queryString>
		<![CDATA[SELECT ORG_UNIT_NAME
FROM ORG_UNIT

WHERE ORG_UNIT_NO =  $P{ORG_NO}]]>
	</queryString>
	<field name="ORG_UNIT_NAME" class="java.lang.String"/>
	<variable name="CCF0_show_orgunit_name" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//'In ' + {Command.ORG_UNIT_NAME}

$F{ORG_UNIT_NAME}!=null
?   "In " + $F{ORG_UNIT_NAME}
:   "In "]]></variableExpression>
	</variable>
