	<variable name="CCF0_Grade_Schedule" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R889.GRADE_SCHEDULE_CODE} = "I" then
//    'Interior'
//else
//    'Coastal';


$F{GRADE_SCHEDULE_CODE} != null && !($F{GRADE_SCHEDULE_CODE}.isEmpty())
?
    ($F{GRADE_SCHEDULE_CODE}.equalsIgnoreCase( "I" ) ? "Interior" :"Coastal")
: "Coastal"]]></variableExpression>
	</variable>
	<variable name="CCF1_Report_Scope" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {?SP_STRATUMNO} <> '' then
//    'Stratum - '+ {?SP_STRATUMNO}
//else
//    'All Strata';



$P{SP_STRATUMNO} != null && !($P{SP_STRATUMNO}.isEmpty())
? "stratum - "  +  $P{SP_STRATUMNO}
: "All Strata"]]></variableExpression>
	</variable>
	<variable name="CCF2_Constraint_Mode" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R889.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'D' THEN
//    'N/A'
//ELSE
//    if {HBS3R889.CURRENT_CONSTRAINT_TYPE} = 'P' then
//        'Constrain Precision'
//    else if {HBS3R889.CURRENT_CONSTRAINT_TYPE} = 'S' then
//        'Constrain Samples';



($F{SAMPLING_PLAN_RATIO_TYPE_CODE} != null
    && !($F{SAMPLING_PLAN_RATIO_TYPE_CODE}.isEmpty())
    && $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase("D" )
)
|| $F{CURRENT_CONSTRAINT_TYPE}== null
|| $F{CURRENT_CONSTRAINT_TYPE}.isEmpty()

? "N/A"
:
      ($F{CURRENT_CONSTRAINT_TYPE}.equalsIgnoreCase("P" ) ?  "Constrain Precision"  :
      ($F{CURRENT_CONSTRAINT_TYPE}.equalsIgnoreCase("S" ) ?  "Constrain Samples"    : "N/A"
      ))]]></variableExpression>
	</variable>
	<variable name="CCF3_Estimate_Mode" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R889.CURRENT_ESTIMATE_TYPE} = 'LS' then
//    'Loads and Size'
//else if {HBS3R889.CURRENT_ESTIMATE_TYPE} = 'VL' then
//    'Volume and Loads'
//else if {HBS3R889.CURRENT_ESTIMATE_TYPE} = 'VS' then
//    'Volume and Size';



$F{CURRENT_ESTIMATE_TYPE} != null && !($F{CURRENT_ESTIMATE_TYPE}.isEmpty())
?
    ($F{CURRENT_ESTIMATE_TYPE}.equalsIgnoreCase("LS" ) ?  "Loads and Size"  :
        ($F{CURRENT_ESTIMATE_TYPE}.equalsIgnoreCase("VL" ) ?  "Volume and Loads"  :
            ($F{CURRENT_ESTIMATE_TYPE}.equalsIgnoreCase("VS" ) ?  "Volume and Size"  : ""
            )
        )
    )
:""]]></variableExpression>
	</variable>
	<variable name="CCF4_Sampling_year" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//cStr({HBS3R889.SAMPLING_YEAR},"#")

$F{SAMPLING_YEAR} != null
? $F{SAMPLING_YEAR}.toString()
: ""]]></variableExpression>
	</variable>
	<variable name="CCF5_Sample_floor" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R889.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'S' THEN
//    cStr({HBS3R889.SAMPLE_FLOOR},"#")
//ELSE
//    'N/A';


$F{SAMPLING_PLAN_RATIO_TYPE_CODE} !=null
&& !($F{SAMPLING_PLAN_RATIO_TYPE_CODE}.isEmpty())
&& $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "S" )
&& $F{SAMPLE_FLOOR} != null

? $F{SAMPLE_FLOOR}.toString()
: "N/A"]]></variableExpression>
	</variable>
	<variable name="CCF6_Precision" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {HBS3R889.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'S' THEN
//
//   cStr({HBS3R889.PRECISION_LIMIT}) + '%'
//ELSE
//    'N/A';

$F{SAMPLING_PLAN_RATIO_TYPE_CODE} !=null
&& !($F{SAMPLING_PLAN_RATIO_TYPE_CODE}.isEmpty())
&& $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "S" )
&& $F{PRECISION_LIMIT} != null

?
(new DecimalFormat("#0.00").format($F{PRECISION_LIMIT})).toString() + "%"


: "N/A"]]></variableExpression>
	</variable>
	<variable name="CCF7_Ratio_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if {HBS3R889.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'S' then
//     'Sample-based'
//else if {HBS3R889.SAMPLING_PLAN_RATIO_TYPE_CODE} = 'D' then
//        'Default'
//;


$F{SAMPLING_PLAN_RATIO_TYPE_CODE} !=null && !($F{SAMPLING_PLAN_RATIO_TYPE_CODE}.isEmpty())
?
    $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "S" ) ? "Sample-based" :
    $F{SAMPLING_PLAN_RATIO_TYPE_CODE}.equalsIgnoreCase( "D" ) ? "Default"  :  ""
: ""]]></variableExpression>
	</variable>
