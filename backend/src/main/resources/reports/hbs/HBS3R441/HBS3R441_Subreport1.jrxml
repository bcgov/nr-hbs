<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HBS3R441_sub_a" pageWidth="768" pageHeight="588" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="768" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="81bf6040-8d6c-4be0-a424-ec0f41900268">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.jasperserver.reportUnit" value="/JCRS/HBS/Reports/HBS/HBS3R441.rpt"/>
	<property name="ireport.jasperserver.url" value="http://localhost:8080/jasperserver/services/repository"/>
	<parameter name="Pm-HBS3R441.USER_TYPE" class="java.lang.String"/>
	<parameter name="Pm-HBS3R441.USER_CLILOC" class="java.lang.String"/>
	<parameter name="GRPHEAD_GRPTYPE" class="java.lang.String"/>
	<parameter name="GRPHEAD_GRPLEVEL" class="java.lang.String"/>
	<parameter name="GRPHEAD_LOOKUPVAL" class="java.lang.String"/>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet" isForPrompting="false"/>
	<parameter name="LoggedInUser" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="p_report_id" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["HBS3R441_sub_a"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? "repo:" : "H:\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_EXT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{REPORT_CONTEXT} != null) ? ".jrxml" : ".jasper"]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[{call HBS00001_SUB_A(
GRPHEAD_CURSOR => $P{ORACLE_REF_CURSOR},
GRPHEAD_GRPTYPE => $P{GRPHEAD_GRPTYPE},
GRPHEAD_GRPLEVEL => $P{GRPHEAD_GRPLEVEL},
GRPHEAD_LOOKUPVAL => $P{GRPHEAD_LOOKUPVAL}
)}]]>
	</queryString>
	<field name="LOOKUPVAL" class="java.lang.String"/>
	<field name="RESULTSTR" class="java.lang.String"/>
	<variable name="v_strNotSevered" class="java.lang.String">
		<variableExpression><![CDATA[$F{RESULTSTR} == null || $F{RESULTSTR}.isEmpty() ? "" : $F{RESULTSTR}]]></variableExpression>
	</variable>
	<variable name="v_strNotReleasable" class="java.lang.String">
		<variableExpression><![CDATA[( $F{RESULTSTR} == null || $F{RESULTSTR}.isEmpty() ? "" :
( $F{RESULTSTR}.length() >= 11 ? $F{RESULTSTR}.substring( 0, 11 ) + "  CLIENT NAME NOT RELEASABLE" :
$F{RESULTSTR} + "  CLIENT NAME NOT RELEASABLE" ) )]]></variableExpression>
	</variable>
	<variable name="v_strCliLoc" class="java.lang.String">
		<variableExpression><![CDATA[( $P{GRPHEAD_LOOKUPVAL} == null || $P{GRPHEAD_LOOKUPVAL}.isEmpty() ? "" :
( $P{GRPHEAD_LOOKUPVAL}.length() >= 11 ? $P{GRPHEAD_LOOKUPVAL}.substring( 0, 8 ) + $P{GRPHEAD_LOOKUPVAL}.substring( 9, 11 ) :
$P{GRPHEAD_LOOKUPVAL} ) )]]></variableExpression>
	</variable>
	<variable name="CCF0_strClientLoc" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local stringVar strCliLoc := Left ({?GRPHEAD_LOOKUPVAL}, 8) + Mid ({?GRPHEAD_LOOKUPVAL}, 10,2);
//Local stringVar strNotSevered := {HBS00001_SUB_A.RESULTSTR};
//Local stringVar strNotReleasable := Left ({HBS00001_SUB_A.RESULTSTR}, 11) + '  CLIENT NAME NOT RELEASABLE';
//
//
//// All users can see client info if client is a corporation
//// Jan 8th, 2001 Ian Kinnon: There are more types of client than I and C therefore the rule
////                           was changed to allow client info to be seen as long as not an Individual
// IF right(cstr({HBS00001_SUB_A.LOOKUPVAL}),1) <> 'I'
// THEN
//     strNotSevered
// ELSE
//  (
//   	select {?Pm-HBS3R441.USER_TYPE}
//   // Ministry users can see all client info
//   // Client users can see all of their own invoice info
//   	  case  'MOF' : strNotSevered
//   // Client users can see all of their own invoice info
//      case  'CLI' : (
//                    IF ISNULL ({?Pm-HBS3R441.USER_CLILOC}) THEN
//                	    strNotReleasable
//                    ELSE IF {?Pm-HBS3R441.USER_CLILOC} = strCliLoc THEN
//                        strNotSevered
//                    ELSE
//                	    strNotReleasable
//                  )
//
//      default     : strNotReleasable ;
//  )

( $F{LOOKUPVAL} != null && !($F{LOOKUPVAL}.isEmpty()) &&
  !(($F{LOOKUPVAL}.substring( $F{LOOKUPVAL}.length() - 1 )).equalsIgnoreCase( "I" ))
? $V{v_strNotSevered}
:
  ( $P{Pm-HBS3R441.USER_TYPE} == null || $P{Pm-HBS3R441.USER_TYPE}.isEmpty() ? $V{v_strNotReleasable} :
    ( $P{Pm-HBS3R441.USER_TYPE}.equalsIgnoreCase( "MOF" ) ? $V{v_strNotSevered} :
      ( $P{Pm-HBS3R441.USER_TYPE}.equalsIgnoreCase( "CLI" )
        ?
          ( $P{Pm-HBS3R441.USER_CLILOC} == null || $P{Pm-HBS3R441.USER_CLILOC}.isEmpty()
          ? $V{v_strNotReleasable}
          : ( $P{Pm-HBS3R441.USER_CLILOC}.equalsIgnoreCase( $V{v_strCliLoc} )
            ? $V{v_strNotSevered}
            : $V{v_strNotReleasable}
            )
          )
        : $V{v_strNotReleasable}
      )
    )
  )
)]]></variableExpression>
	</variable>
	<variable name="CCF1_strGrpDisplay" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?GRPHEAD_GRPTYPE} = '4' and {?GRPHEAD_GRPLEVEL} = '1' THEN
//  {@strClientLoc}
//else
// {HBS00001_SUB_A.RESULTSTR}

$P{GRPHEAD_GRPTYPE}  != null && !($P{GRPHEAD_GRPTYPE}.isEmpty())  && $P{GRPHEAD_GRPTYPE}.equalsIgnoreCase( "4" )   &&
$P{GRPHEAD_GRPLEVEL} != null && !($P{GRPHEAD_GRPLEVEL}.isEmpty()) && $P{GRPHEAD_GRPLEVEL}.equalsIgnoreCase( "1" )
?
$V{CCF0_strClientLoc}
:
( $F{RESULTSTR} == null || $F{RESULTSTR}.isEmpty() ? "" : $F{RESULTSTR} )]]></variableExpression>
	</variable>
	<detail>
		<band height="14" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="e1916278-ae9e-4e01-8915-310e662565fe" x="3" y="0" width="648" height="13" forecolor="#000000"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{CCF1_strGrpDisplay}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
