//    default : 'Error reporting group total'

( $P{INVSMRY_GRPTYPE} == null || $P{INVSMRY_GRPTYPE}.isEmpty() ? "Error reporting group total" :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "1" ) ? "REGION TOTAL"         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "2" ) ? "DISTRICT TOTAL"       :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "3" ) ? "LICENCE TOTAL"        :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "4" ) ? "CLIENT TOTAL"         :
