//If strSPGGr = '' then strSPGGr := 'ALL';
//
//strSPGSp + ' / ' + strSPGPr + ' / ' + strSPGGr ;

( $P{INVSMRY_SPECIES} == null || $P{INVSMRY_SPECIES}.isEmpty() ? "ALL" : $P{INVSMRY_SPECIES} )
+ "/" +
( $P{INVSMRY_PRODUCT} == null || $P{INVSMRY_PRODUCT}.isEmpty() ? "ALL" : $P{INVSMRY_PRODUCT} )
+ "/" +
( $P{INVSMRY_GRADE}   == null || $P{INVSMRY_GRADE}.isEmpty()   ? "ALL" : $P{INVSMRY_GRADE} )]]></variableExpression>
