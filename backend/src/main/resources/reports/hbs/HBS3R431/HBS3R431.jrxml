	</variable>
	<variable name="CCF56_Ttl_VOL" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//{HBS00001R.M01VOL} + {HBS00001R.M02VOL} + {HBS00001R.M03VOL} + {HBS00001R.M04VOL} + {HBS00001R.M05VOL} + {HBS00001R.M06VOL} +
//{HBS00001R.M07VOL} + {HBS00001R.M08VOL} + {HBS00001R.M09VOL} + {HBS00001R.M10VOL} + {HBS00001R.M11VOL} + {HBS00001R.M12VOL}

( $F{M01VOL} == null ? 0.0 : $F{M01VOL}.doubleValue() ) +
( $F{M02VOL} == null ? 0.0 : $F{M02VOL}.doubleValue() ) +
( $F{M03VOL} == null ? 0.0 : $F{M03VOL}.doubleValue() ) +
( $F{M04VOL} == null ? 0.0 : $F{M04VOL}.doubleValue() ) +
( $F{M05VOL} == null ? 0.0 : $F{M05VOL}.doubleValue() ) +
( $F{M06VOL} == null ? 0.0 : $F{M06VOL}.doubleValue() ) +
( $F{M07VOL} == null ? 0.0 : $F{M07VOL}.doubleValue() ) +
( $F{M08VOL} == null ? 0.0 : $F{M08VOL}.doubleValue() ) +
( $F{M09VOL} == null ? 0.0 : $F{M09VOL}.doubleValue() ) +
( $F{M10VOL} == null ? 0.0 : $F{M10VOL}.doubleValue() ) +
( $F{M11VOL} == null ? 0.0 : $F{M11VOL}.doubleValue() ) +
( $F{M12VOL} == null ? 0.0 : $F{M12VOL}.doubleValue() )]]></variableExpression>
	</variable>
	<variable name="CCF57_Ttl_VAL" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//{HBS00001R.M01VAL} + {HBS00001R.M02VAL} + {HBS00001R.M03VAL} + {HBS00001R.M04VAL} + {HBS00001R.M05VAL} + {HBS00001R.M06VAL} +
//{HBS00001R.M07VAL} + {HBS00001R.M08VAL} + {HBS00001R.M09VAL} + {HBS00001R.M10VAL} + {HBS00001R.M11VAL} + {HBS00001R.M12VAL}

( $F{M01VAL} == null ? 0.0 : $F{M01VAL}.doubleValue() ) +
( $F{M02VAL} == null ? 0.0 : $F{M02VAL}.doubleValue() ) +
( $F{M03VAL} == null ? 0.0 : $F{M03VAL}.doubleValue() ) +
( $F{M04VAL} == null ? 0.0 : $F{M04VAL}.doubleValue() ) +
( $F{M05VAL} == null ? 0.0 : $F{M05VAL}.doubleValue() ) +
( $F{M06VAL} == null ? 0.0 : $F{M06VAL}.doubleValue() ) +
( $F{M07VAL} == null ? 0.0 : $F{M07VAL}.doubleValue() ) +
( $F{M08VAL} == null ? 0.0 : $F{M08VAL}.doubleValue() ) +
( $F{M09VAL} == null ? 0.0 : $F{M09VAL}.doubleValue() ) +
( $F{M10VAL} == null ? 0.0 : $F{M10VAL}.doubleValue() ) +
( $F{M11VAL} == null ? 0.0 : $F{M11VAL}.doubleValue() ) +
( $F{M12VAL} == null ? 0.0 : $F{M12VAL}.doubleValue() )]]></variableExpression>
	</variable>
	<variable name="CCF58_Ttl_AvgRt" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//If {@Ttl_VOL}= 0
//then
//    0
//else
//   {@Ttl_VAL} / {@Ttl_VOL} ;

$V{CCF56_Ttl_VOL} == null || $V{CCF56_Ttl_VOL} == 0.0 || $V{CCF57_Ttl_VAL} == null || $V{CCF57_Ttl_VAL} == 0.0
? 0.0
: $V{CCF57_Ttl_VAL} / $V{CCF56_Ttl_VOL}]]></variableExpression>
	</variable>
