	<variable name="CCF45_ftr_SPG_SP" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If {?INVSMRY_SPECIES} = '' then 'All'
//else
//    select ({?INVSMRY_SPECIES})
//    case  'CNFRS'   :  'Coniferous'
//    case  'DCDS'    :  'Deciduous'
//    default: {?INVSMRY_SPECIES};

( $P{INVSMRY_SPECIES} == null || $P{INVSMRY_SPECIES}.isEmpty() ? "All" :
( $P{INVSMRY_SPECIES}.equalsIgnoreCase( "CNFRS" ) ? "Coniferous"       :
( $P{INVSMRY_SPECIES}.equalsIgnoreCase( "DCDS"  ) ? "Deciduous"        :
  $P{INVSMRY_SPECIES}
)))]]></variableExpression>
	</variable>
	<variable name="CCF46_ftr_SPG_PR" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If Length ({?INVSMRY_PRODUCT}) = 0 then
//    'All'
//Else
//    select ({?INVSMRY_PRODUCT})
//    case  ' '       :  'Log'
//    case  'ALL'     :  'All'
//    case  'NOT_LOG' :  'SFP'
//    case  'NOT_XM'  :  'SFP - XM'
//    default: {?INVSMRY_PRODUCT};

( $P{INVSMRY_PRODUCT} == null || $P{INVSMRY_PRODUCT}.isEmpty()  || $P{INVSMRY_PRODUCT}.length() == 0 ? "All" :
( $P{INVSMRY_PRODUCT}.equalsIgnoreCase( " "       ) ? "Log"      :
( $P{INVSMRY_PRODUCT}.equalsIgnoreCase( "ALL"     ) ? "All"      :
( $P{INVSMRY_PRODUCT}.equalsIgnoreCase( "NOT_LOG" ) ? "SFP"      :
( $P{INVSMRY_PRODUCT}.equalsIgnoreCase( "NOT_XM"  ) ? "SFP - XM" : $P{INVSMRY_PRODUCT} )))))]]></variableExpression>
	</variable>
	<variable name="CCF47_ftr_SPG_GR" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//If {?INVSMRY_GRADE} = '' then 'All'
//else
//    select ({?INVSMRY_GRADE})
//    case  'LUM_REJ' :  'Lumber Rejects'
//    case  'UTL_BTR' :  'Utility and Better'
//    case  'FIRMWOOD_REJ' : 'All Except Firmwood Rejects'
//    default: {?INVSMRY_GRADE};

( $P{INVSMRY_GRADE} == null || $P{INVSMRY_GRADE}.isEmpty() ? "All" :
( $P{INVSMRY_GRADE}.equalsIgnoreCase( "LUM_REJ"      ) ? "Lumber Rejects"              :
( $P{INVSMRY_GRADE}.equalsIgnoreCase( "UTL_BTR"      ) ? "Utility and Better"          :
( $P{INVSMRY_GRADE}.equalsIgnoreCase( "FIRMWOOD_REJ" ) ? "All Except Firmwood Rejects" : $P{INVSMRY_GRADE} ))))]]></variableExpression>
	</variable>
