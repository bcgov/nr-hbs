	<variable name="CCF36_grp1_hdrtext" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// Ian Kinnon Apr 5, 2002  Removed the printing of the field HBS00001.grp1 as this is now
////                         handled by 2 new sub reports
//// Ian Kinnon June 13th, 2002 added another grouping of File type
//select {?INVSMRY_GRPTYPE}
//    case '1': 'REGION: '
//    case '2': 'DISTRICT: '
//    case '3': 'LICENCE: '
//    case '4': 'CLIENT: '
//    case '5': 'FILE TYPE: '
//    case '7': 'REGION: '
//    case '8': 'MGMT UNIT TYPE: '
//    default : 'Error reporting group name';

( $P{INVSMRY_GRPTYPE} == null || $P{INVSMRY_GRPTYPE}.isEmpty() ? "Error reporting group name" :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "1" ) ? "REGION: "         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "2" ) ? "DISTRICT: "       :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "3" ) ? "LICENCE: "        :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "4" ) ? "CLIENT: "         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "5" ) ? "FILE TYPE: "      :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "6" ) ? "DISTRICT: "       :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "7" ) ? "REGION: "         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "8" ) ? "MGMT UNIT TYPE: " : "Error reporting group name" )))))))))]]></variableExpression>
	</variable>
	<variable name="CCF37_grp2_hdrtext" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//// Ian Kinnon Apr 5, 2002  Removed the printing of the field HBS00001.grp1 as this is now
////                         handled by new sub reports
//// Ian Kinnon June 13, 2002 Added a file type grouping but if filetype is selected the
////                          report only has one level of gouping (ie grp1)
//select {?INVSMRY_GRPTYPE}
//    case '1':  'DISTRICT: '
//    case '2':  'MARK: '
//    case '3':  'MARK: '
//    case '4':  'LICENCE: '
//    case '5':  ' '
//    case '7':  ' '
//    case '8':  'MGMT UNIT ID: '
//    default : 'Error reporting group name'

( $P{INVSMRY_GRPTYPE} == null || $P{INVSMRY_GRPTYPE}.isEmpty() ? "Error reporting group name" :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "1" ) ? "DISTRICT: "     :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "2" ) ? "MARK: "         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "3" ) ? "MARK: "         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "4" ) ? "LICENCE: "      :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "5" ) ? " "              :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "7" ) ? " "              :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "8" ) ? "MGMT UNIT ID: " : "Error reporting group name" ))))))))]]></variableExpression>
	</variable>
	<variable name="CCF38_grp2_ftrtext" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//select {?INVSMRY_GRPTYPE}
//    case '1':  'DISTRICT TOTAL'
//    case '2':  'MARK TOTAL'
//    case '3':  'MARK TOTAL'
//    case '4':  'LICENCE TOTAL'
//    case '5':  'FILE TYPE TOTAL'
//    case '7':  'REGION TOTAL'
//    case '8':  'MGMT UNIT ID TOTAL'
//    default : 'Error reporting group total'

( $P{INVSMRY_GRPTYPE} == null || $P{INVSMRY_GRPTYPE}.isEmpty() ? "Error reporting group total" :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "1" ) ? "DISTRICT TOTAL"     :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "2" ) ? "MARK TOTAL"         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "3" ) ? "MARK TOTAL"         :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "4" ) ? "LICENCE TOTAL"      :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "5" ) ? "FILE TYPE TOTAL"    :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "7" ) ? "REGION TOTAL"       :
( $P{INVSMRY_GRPTYPE}.equalsIgnoreCase( "8" ) ? "MGMT UNIT ID TOTAL" : "Error reporting group total" ))))))))]]></variableExpression>
	</variable>
	<variable name="CCF39_grp1_ftrtext" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//select {?INVSMRY_GRPTYPE}
//    case '1':  'REGION TOTAL'
//    case '2':  'DISTRICT TOTAL'
//    case '3':  'LICENCE TOTAL'
