	<variable name="CCF13_ftr_TenureDtls" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local StringVar array strArray := [ {?INVSMRY_LICMARK01},{?INVSMRY_LICMARK02},{?INVSMRY_LICMARK03},{?INVSMRY_LICMARK04},
//                                    {?INVSMRY_LICMARK05},{?INVSMRY_LICMARK06},{?INVSMRY_LICMARK07},{?INVSMRY_LICMARK08},
//                                    {?INVSMRY_LICMARK09},{?INVSMRY_LICMARK10},''] ;
//Local StringVar strList;
//Local NumberVar i;
//
//For i := 1 To 10 Do
//(
//   if strArray[i] <> '' then strList := strList + strArray[i] + ',';
//);
//
//if strList <> '' then strList := Left (strList, Length (strList)-1 );
//select {?INVSMRY_LICMARKTYPE}
//   case  '1':  'Licence (' + strList + ' )'
//   case  '2':  'Marks ( ' + strList + ' )'
//   case  '4':  ' '
//   default  :  if {?INVSMRY_FILETYPE1} = '' then  'File Type: All Land ' else 'File Type: ' + {?INVSMRY_FILETYPE1} ;

( $P{INVSMRY_LICMARKTYPE} == null || $P{INVSMRY_LICMARKTYPE}.isEmpty()
  ?
    ( $P{INVSMRY_FILETYPE1} == null || $P{INVSMRY_FILETYPE1}.isEmpty() ? "File Type: All Land " : "File Type: " + $P{INVSMRY_FILETYPE1} )
  :
    ( $P{INVSMRY_LICMARKTYPE}.equalsIgnoreCase( "1" ) ? "Licence ( " + ( $V{v_CCF13_ftr_TenureDtls_b} == null || $V{v_CCF13_ftr_TenureDtls_b}.isEmpty() ? "" : $V{v_CCF13_ftr_TenureDtls_b} ) + " )" :
    ( $P{INVSMRY_LICMARKTYPE}.equalsIgnoreCase( "2" ) ? "Marks ( "   + ( $V{v_CCF13_ftr_TenureDtls_b} == null || $V{v_CCF13_ftr_TenureDtls_b}.isEmpty() ? "" : $V{v_CCF13_ftr_TenureDtls_b} ) + " )" :
    ( $P{INVSMRY_LICMARKTYPE}.equalsIgnoreCase( "4" ) ? " "                                                                                                                                     :
    ( $P{INVSMRY_FILETYPE1} == null || $P{INVSMRY_FILETYPE1}.isEmpty() ? "File Type: All Land " : "File Type: " + $P{INVSMRY_FILETYPE1}
    ))))
)]]></variableExpression>
	</variable>
	<variable name="CCF14_ftr_SPG" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//Local stringVar strSPGSp := {?INVSMRY_SPECIES};
//Local stringVar strSPGPr := {?INVSMRY_PRODUCT};
//Local stringVar strSPGGr := {?INVSMRY_GRADE};
//
//If strSPGSp = '' then strSPGSp := 'ALL';
