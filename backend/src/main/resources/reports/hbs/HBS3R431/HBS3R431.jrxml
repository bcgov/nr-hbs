	<variable name="CCF100_Ttl_VolFraction" class="java.lang.Double" resetType="None">
		<variableExpression><![CDATA[//{HBS00001R.M01FRA} + {HBS00001R.M02FRA} + {HBS00001R.M03FRA} + {HBS00001R.M04FRA} + {HBS00001R.M05FRA} + {HBS00001R.M06FRA} +
//{HBS00001R.M07FRA} + {HBS00001R.M08FRA} + {HBS00001R.M09FRA} + {HBS00001R.M10FRA} + {HBS00001R.M11FRA} + {HBS00001R.M12FRA}

$F{M01FRA}.doubleValue() + $F{M02FRA}.doubleValue() +
$F{M03FRA}.doubleValue() + $F{M04FRA}.doubleValue() +
$F{M05FRA}.doubleValue() + $F{M06FRA}.doubleValue() +
$F{M07FRA}.doubleValue() + $F{M08FRA}.doubleValue() +
$F{M09FRA}.doubleValue() + $F{M10FRA}.doubleValue() +
$F{M11FRA}.doubleValue() + $F{M12FRA}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="CCF101_ftr_DispFraction" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if  Mid ({?INVSMRY_DISPDTLS}, 4, 1) = 'T' then 'Yes' else 'No';


$P{INVSMRY_DISPDTLS} != null && $P{INVSMRY_DISPDTLS}.length()>= 4
?   ($P{INVSMRY_DISPDTLS}.substring(3,4)).equalsIgnoreCase("T") ? "Yes" : "No"
:   "No"]]></variableExpression>
	</variable>
	<variable name="CCF102_Show_Mgmt_Unit_Type" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF {?INVSMRY_MGMTUNITTYPECODE} = 'F' THEN
//     'Woodlot'
//ELSE IF {?INVSMRY_MGMTUNITTYPECODE} = 'T' THEN
//     'Tree Farm Licence'
//ELSE IF {?INVSMRY_MGMTUNITTYPECODE} = 'U' THEN
//     'Timber Supply Area'
//ELSE IF {?INVSMRY_MGMTUNITTYPECODE} = 'V' THEN
//     'Timber Supply Block'
//ELSE IF {?INVSMRY_MGMTUNITTYPECODE} = 'U,V' THEN
//     'Timber Supply Area or Block'
//ELSE IF {?INVSMRY_MGMTUNITTYPECODE} = 'F,T,U,V' THEN
//     'Other';

( $P{INVSMRY_MGMTUNITTYPECODE} == null || $P{INVSMRY_MGMTUNITTYPECODE}.isEmpty()
? ""
:
    ( $P{INVSMRY_MGMTUNITTYPECODE}.equalsIgnoreCase( "F" )   ? "Woodlot"                     :
    ( $P{INVSMRY_MGMTUNITTYPECODE}.equalsIgnoreCase( "T" )   ? "Tree Farm Licence"           :
    ( $P{INVSMRY_MGMTUNITTYPECODE}.equalsIgnoreCase( "U" )   ? "Timber Supply Area"          :
    ( $P{INVSMRY_MGMTUNITTYPECODE}.equalsIgnoreCase( "V" )   ? "Timber Supply Block"         :
    ( $P{INVSMRY_MGMTUNITTYPECODE}.equalsIgnoreCase( "U,V" ) ? "Timber Supply Area or Block" : "Other" )))))
)]]></variableExpression>
	</variable>
