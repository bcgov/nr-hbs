PSR_EXCLUDEERROR => $P{PSR_EXCLUDEERROR},
PSR_BATCHID => $P{PSR_BATCHID},
PSR_INPUTBATCHDATEFROM => $P{PSR_INPUTBATCHDATEFROM},
PSR_INPUTBATCHDATETO => $P{PSR_INPUTBATCHDATETO},
PSR_WEIGHSLIP => $P{PSR_WEIGHSLIP},
PSR_DOCUMENTCONTROLNUMBER => $P{PSR_DOCUMENTCONTROLNUMBER},
PSR_SUMMARYDOCUMENTNUMBER => $P{PSR_SUMMARYDOCUMENTNUMBER},
PSR_ACTIVEVERSIONINDICATOR => $P{PSR_ACTIVEVERSIONINDICATOR},
PSR_SEARCHBYSITES => $P{PSR_SEARCHBYSITES},
PSR_SEARCHBYMARKS => $P{PSR_SEARCHBYMARKS},
PSR_USERID => $P{PSR_USERID},
